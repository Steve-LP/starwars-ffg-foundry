{"_id":"g1UjkcC1vxztERZx","name":"Shriek","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A minion group of four or more blismal can set up a shrieking racket as an action. All targets within Close range must make a :hard: Resilience check. Failure causes a target to suffer 4 Strain and become disoriented until the noise stops. Characters in sealed armour or who are wearing ear protection are not affected."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"g1ZDgYGKJbG5mVjz","name":"Get Down Your Majesty!","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When Queen Breha is in Engaged range of at least one Alderaan Consular Guard, all ranged attacks targeting the Queen hit the guard instead, unless the attacker is striking from a hidden position (as determined by the GM)."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
