{"_id":"ojt0Ke4VbBUvrbGe","name":"Bothan Spy","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"To most Bothans, information is king. Equally willing to sell to either side in the conflict, they remain officially neutral and the Empire has left them largely unmolested. There is, however, a growing unofficial faction that sees support of the Rebellion as the way forward. Given their natural affinity for backroom politics, the Bothans have taken very easily to the practice of espionage, and have secretly caused a great deal of difficulty for the Empire. It is a Bothan spy network that ultimately secures the plans for the second Death Star, giving the Alliance the opportunity to strike a devastating blow to the Empire."}},"items":[{"_id":"R3rY5C0d7ouLjJGR","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
