{"_id":"m4zHIVhnwN4mIpct","name":"Ewok Hunter","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"rFtRv9LXNxcCfhWN","name":"Bow","type":"weapon","system":{"damage":6,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Pierce 1, Prepare 1"}},{"_id":"b32VmRlOuBu6YNTq","name":"Spear","type":"weapon","system":{"damage":4,"critical":4,"range":"Engaged","skill":"Melee","qualities":"Pierce 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"m6bBTFXu28OIsRjt","name":"Cyborg Administrator","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The largest space stations and orbital facilities are incredibly complex installations requiring the use of vast, extensive computer networks. These networks likewise require incredible amounts of supervision to oversee. Although uncommon, it is not unheard of for independent facilities with such networks to utilize individuals with cybernetic enhancements. These enhancements permit such administrators to interface directly with computer systems in order to create a more efficient and immediate means of supervising the system in question. Cyborg administrators often seem less human, distracted as they are by a constant stream of information from outside. As a result, they are not typically well-liked by most despite their enhanced abilities. Due to the discriminatory tendencies of Imperial officials, cyborg administrators tend to be slightly more inclined toward favoring the Alliance than the Empire."}},"items":[{"_id":"V9KQdX4B9vz0SLSf","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"m82ZiUqqwm83A9ft","name":"Deadly Accuracy (Ranged: Heavy)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Add {Ranged: Heavy} to all damage from attacks using Ranged: Heavy."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"mB08fSBFIxGg1snh","name":"TJ-11, Saboteur Tactical Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A T-series tactical droid restored by Imperial Intelligence, TJ-l I was programmed to lead the mission to ship jack the *Shadow Raptor* and discover the location of the Rebel Fleet. TJ-11 is cold and pragmatic to a fault, working its way down a series of preprogrammed objectives and assessing its next move by calculating odds of success."}},"items":[{"_id":"fnAr7m478hdMZHRr","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"jkbe2NhCize9MtVD","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"7oveUJAD8HrngOyy","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Re6s4YgK7EG02JT0","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
