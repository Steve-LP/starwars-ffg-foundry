{"_id":"mMjXWqRhSWYrEw2P","name":"Cleaning Droid","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Walisi purchased a series of these droids some time ago. He has since upgraded them regularly to ensure they properly maintain his establishment without damaging and of his items through overzealous dusting or improperly applied cleaning liquids."}},"items":[{"_id":"vNvrsYK0TWyBleXk","name":"Two built-in scrubber tentacles","type":"weapon","system":{"damage":2,"critical":5,"range":"Engaged","skill":"Melee","qualities":"Ensnare 1"}},{"_id":"jKuXhhTsIJV2nGMd","name":"Built-in cleaning spray hose","type":"weapon","system":{"damage":0,"critical":0,"range":"Short","skill":"Ranged: Light","qualities":"Disorient 1, Knockdown"}}],"effects":[],"flags":{},"ownership":{"default":0}}
