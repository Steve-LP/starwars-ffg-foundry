{"_id":"0ei2dSNOq9HqvwDV","name":"Undermining Dissent","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session, Rash may choose an organisation and make a :hard: Deception check. On success, organisation members have their Strain Thresholds reduced by 1, plus 1 per :success::success: until the end of the session."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"0gkg7sarNq7Ga8Jo","name":"Probe Killer Swarm","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"hE8CiyKfNlAFxPFF","name":"Tiny razor-sharp legs","type":"weapon","system":{"damage":3,"critical":2,"range":"Engaged","skill":"Brawl","qualities":"Disorient 2, Ensnare 2, Knockdown, Pierce 2"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"0hmWjwOIvH3gMTIv","name":"Mynock","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Mynocks are disgusting, silicon-based space parasites that survive by latching onto the hulls of star ships and feeding off power cables and other vital systems. About a meter long with wings that could be used in atmosphere. they have spread through out the galaxy by hitching rides on passing starships. They absorb matter and energy from their hosts. which can eventually cause system failure. Mynocks can be found on the surface of several different worlds, although their allergy to helium limits the number of habitats which they can survive."}},"items":[{"_id":"N0B6Raw1fCY3pWSQ","name":"Sucker-mouths and claws","type":"weapon","system":{"damage":4,"critical":5,"range":"Engaged","skill":"Brawl","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"0iHNTZHPeAJYSAmi","name":"Skilled Cheater","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session when gambling, Watto may cancel a :despair: he rolls on a skill check, or add a :despair: to another character’s check."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"0jCJJyQlTzKsQU9W","name":"Knowledge Specialization: Lore","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When making skill checks with Knowledge: Lore, may spend :triumph: result to gain {ranks|success}."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"0jS1tqNYvOmlykry","name":"Duchess Salandra Faust","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The scion of a long line of exiled Tetan aristocrats and Krath acolytes, Salandra is an extraordinarily attractive woman of noble bearing. She dresses in the finest attire and is a notorious fashion setter among the Galactic elite. Her foppish appearance, however, is little more than a mask– She trained from the time she could walk with Mecrosa assassins and her family’s Krath adepts. Her facility for swordplay and the Force are matched only by her political acumen; she is a master manipulator and is as likely to orchestrate an enemy’s demise with words as with her blade."}},"items":[{"_id":"ztTh1vrjPr5mhO9B","name":"Superior Vibrorapier","type":"weapon","system":{"damage":5,"critical":2,"range":"Engaged","skill":"Melee","qualities":"Defensive 1, Serrated Edge, Pierce 5, Superior, Vicious 2"}},{"_id":"U1CuQmrI7vLMgrkg","name":"Molecular stiletto","type":"weapon","system":{"damage":2,"critical":1,"range":"Engaged","skill":"Melee","qualities":"Mono-Molecular Edge, Pierce 7, Vicious 1"}},{"_id":"uYRxtPKjrEJDq9U1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"OgGFQJx8pdL5sH4g","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"veKbb73gkM2looHX","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"nCnnaOQmYSCmqeY2","name":"Overbalance","type":"talent","system":{"description":"when a combat check made by an engaged foe generates :despair:  or :threat::threat::threat: Salandra may stagger attacker until the end of their next turn.","activation":"Passive","tier":1,"ranked":false}},{"_id":"LL8NGErZJ3Aq4B4G","name":"Tetan Duelist","type":"talent","system":{"description":"May use Presence instead of Brawn when using the Melee skill.","activation":"Passive","tier":1,"ranked":false}},{"_id":"wnuBarGD4Vnc4lFw","name":"Neurotoxin Doses","type":"talent","system":{"description":"Doses of neurotoxin can be introduced into food or drink as a maneuver or applied to a Melee weapon as a maneuver. If applied to a weapon, it lasts for the remainder of the encounter. If a target ingests poisoned food or drink, or suffers wounds from a poisoned Melee weapon, the target must make an :average: Resilience check, the target suffers 5 wounds if he fails, plus 1 strain per :threat:. :despair: means the target must test against the poison again at the start of his next turn.","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
