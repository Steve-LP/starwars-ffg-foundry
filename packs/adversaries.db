{"_id":"klpPQrCDwoY9RB11","name":"Ranat Scout","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Ranat scouts are small of frame and wiry. They are able to easily squeeze into spaces too small for other creatures, and they use this to their advantage as they sneak about the freighter. Though they aren’t large by any stretch of the imagination, they are just as dangerous when cornered as are their larger kin."}},"items":[{"_id":"n1iA76hJKSo75stp","name":"Bite","type":"weapon","system":{"damage":0,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Pierce 1"}},{"_id":"Ri8m6foBckJpmUM6","name":"Makeshift knife","type":"weapon","system":{"damage":0,"critical":4,"range":"Engaged","skill":"Melee","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"kmACpSPIvc3cjuJH","name":"Don’t Do That Again","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When a check Jar Jar makes or assists with generates :despair:, roll :force:. If the roll generates :lightside: then Jar Jar converts the result to :triumph:. If the roll generates :darkside: then Jar Jar increases the result to :despair::despair:. This roll is made for each initial :despair: generated."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
