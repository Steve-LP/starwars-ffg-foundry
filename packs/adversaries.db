{"_id":"CLHZuu7GrKgnpB61","name":"Boba Fett","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"s0K8PTlJyw63B43N","name":"Modified Blaster Carbine","type":"weapon","system":{"damage":10,"critical":2,"range":"Medium","skill":"Ranged: Heavy","qualities":"Accurate 2, Auto-Fire, Stun Setting"}},{"_id":"c28IY7D7hgJkbYBN","name":"Flamethrower","type":"weapon","system":{"damage":5,"critical":2,"range":"Short","skill":"Ranged: Light","qualities":"Blast 2, Burn 2, Pierce 2, Vicious 3"}},{"_id":"07QSkYjy1OrFvcws","name":"Jetpack missile tube","type":"weapon","system":{"damage":20,"critical":2,"range":"Extreme","skill":"Gunnery","qualities":"Blast 10, Breach 1, Cumbersome 3, Guided 3, Limited Ammo 1, Prepare 1"}},{"_id":"qs1gyiyym54s1Zfz","name":"Whipcord","type":"weapon","system":{"damage":1,"critical":0,"range":"Short","skill":"Ranged: Light","qualities":"Ensnare 3, Limited Ammo 1"}},{"_id":"2ucfYLN4OrzoOaEa","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"JGOpzGIEatEGyhH1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"8NEGA07PtwWhR2dF","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"CQ6IAkMfPpOKQ2S9","name":"C-8 Saboteur Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"One of the more advanced models of battle droid in use by the CIS, C-8 saboteur droids operate in small, independent squads apart from the primary droid divisions. Designed with integrated and advanced sensor-masking plates and strike-and-fade combat protocols, these droids engage without warning, cause as much damage as possible, and then disappear amid the chaos of their unexpected attack. When facing a fortified or stationary target, the droids are sometimes equipped with demolition charges to deploy during their infiltration. C-8 saboteur droids are compact units, standing only 1.7 metres tall. Nevertheless, their matte-black plating and featureless face plates are intimidating to those who spot them; they resemble nothing so much as a void in humanoid form. When they are not in combat their armaments are stored in internal compartments, so as to benefit from the sensor-defeating properties of their armour plating."}},"items":[{"_id":"IObxkXwlDcCpXGAe","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"6ji948qYs6yBCIoM","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
