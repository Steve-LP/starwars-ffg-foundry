{"_id":"gZ4ILu4hCQPojWFT","name":"Mamien","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"An oversized simian of the Yavin 4 jungles, the average mamien stands upright and measures almost three meters tall. Mamiens appear as woolly, potbellied humanoids with spindly arms and legs, stubby noses, and heavy brows. Mamien are unafraid of most species and possess a curious and casual demeanour. However, they are highly protective of their young: entire troupes may turn violent in a heartbeat if an infant is threatened."}},"items":[{"_id":"BCNVMBdBIIKsZlCQ","name":"Pummeling fists","type":"weapon","system":{"damage":6,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Knockdown, Vicious 2"}}],"effects":[],"flags":{},"ownership":{"default":0}}
