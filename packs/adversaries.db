{"_id":"GQaceGBMMrWJf5vt","name":"Zardra","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Human female. A relative newcomer to the hunt, but one with considerable promise. Zardra has quickly gained a reputation as a huntress who takes every bounty very personally. She is selective about the targets she chooses, preferring to hunt those who will offer her the best personal challenge. Though capable of clever planning and great cunning, Zardra’s recklessness and pride may someday be her downfall."}},"items":[{"_id":"KLJJCjX6hM0qIkGZ","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"ReuV7vls6c09p2WI","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"k1RZvsateuf3Nnu5","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"kOxxTeCUjeg4yPXs","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"qlAxe19y7dI9BkP4","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"GSjUeVACyAfUxBTr","name":"Selonian Thug","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Selonians of Den Kimotte act as the enforcers of Baron Kaldo’s criminal empire. They are trained to be silent and without mercy in the execution of their tasks. Kaldo’s killers always travel in groups of three."}},"items":[{"_id":"dbzBNkBhiopcUjyl","name":"Selonian glaive","type":"weapon","system":{"damage":6,"critical":3,"range":"Engaged","skill":"Melee","qualities":"Cumbersome 2, Pierce 2, Sunder"}},{"_id":"FgymoqDtmuCpYbmm","name":"Tail","type":"weapon","system":{"damage":0,"critical":5,"range":"Engaged","skill":"Brawl","qualities":"Disorient 2, Knockdown"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"GSyLB161VQ3QZglD","name":"Stormtrooper Sergeant","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Stormtroopers who survive engagements with high marks are promoted to the position of sergeant. Typically this involves command of a single squadron, but stormtroopers who excel at leadership are promoted to higher ranks. Such positions can include supervision of entire companies of stormtroopers. Rank within the stormtrooper legions is difficult for outsiders to fully understand, as they refer to virtually any officer from their ranks as commander. The uniformity of their armour and this tendency for vague references helps to enforce the image of stormtroopers as an absolutely faceless, monolithic military entity, which only serves to enhance their fearsome reputation."}},"items":[{"_id":"WopaD5DnZlvE6Rz6","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"nPiuqVNR727ZrTnn","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"XtBtb1twdi3oTmiH","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"22eBgUNMIkmMagt5","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"GUgCuVIm4moyhazl","name":"Keen Eyed","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Remove {ranks|setback} from Perception and Vigilance checks; checks made to search a specific time take 50% less time than usual."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"GVj6ZUiiO7jweIw3","name":"Spukami","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Spukami are domesticated felines native to Corellia, sometimes referred to as “house cats.” Large and seemingly intelligent, spukami have long, silky, blue-black fur with white or yellow highlights, piercing gold eyes, and long retractable claws on their front paws. The size of an average human toddler, these cats are widely popular as pets on Corellia. However, thanks to their haughty nature, stubbornness, short attention spans, destructive tendencies, and general lack of affection, they make indifferent pets. Many spukami owners jokingly state that they themselves are the pets, good only to serve the needs of their magisterial and mercurial cats. Spukami are also incredibly territorial, and savagely attack any other members of their species that enter into their territory. Even during their mating season, they can barely tolerate one another, leading Corellians to wonder how the spukami species manages to survive at all."}},"items":[{"_id":"lDPnY21HNgSd5MfA","name":"Teeth and claws","type":"weapon","system":{"damage":1,"critical":6,"range":"Engaged","skill":"Brawl","qualities":""}},{"_id":"azRDASJHncTbJxOU","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
