{"_id":"rtdMmnKqehPbkP96","name":"Chairman Papanoida","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"rGsZIJcnkwD1YapW","name":"Dual modified blaster pistols","type":"weapon","system":{"damage":"6","critical":"3","range":"Medium","skill":"Ranged: Light","qualities":"Accurate 1, Stun Setting"}},{"_id":"F6SxoFtGHLHQSMjo","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"bBPiAmqt2G4Jjhn9","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"gwI5aPLp03JaXxAZ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Scmq3MGrsehqjKyK","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"rwU20ZRHCjZzpGZg","name":"Lieutenant Montra Varn","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Lieutenant Montra Varn, ISB, was there the day the last Imperial shut tle fled Coral City, carrying the remaining members of the Imperial Intelligence mission to the safety of the orbiting Star Destroyer and her evacuating squadron. She watched as the savage Mon Calamari and Quarren rabble cut down her friends and colleagues, screeching like brute beasts as they hacked her Imperial brethren apart with re-purposed industrial tools and stolen Imperial weapons. She saw the fires, the looting, the desecration of Imperial icons, and the mindless brutality with which prisoners were treated by the natives. She had never liked her posting to Mon Cala, or her necessary dealings with the “subcreatures” who called it home, but on that day, as she watched the shuttle’s boarding ramp close on an approaching mob, she swore that one day she would return. For nearly a standard year now, Special Agent Varn has been undercover on Mon Cala, posing as a technical contractor and using her skills as an intelligence operative to exact her revenge on the peoples of Mon Cala.\n\nHer mission is to sow discord and discontent, and to cause a conflict between the Mon Calamari and the Quarren severe enough to keep them fighting themselves and out of Alliance influence. To this end, she spreads rumors and plants false evidence of treachery and betrayal implicating high-ranking members of both species in one or another conspiracy to subjugate their counterparts and take complete control of post occupation Mon Cala. So far, her efforts have been wildly successful. The current talks being mediated by Alliance operatives are the last chance for peace."}},"items":[{"_id":"752mGa9gMFZYmmVK","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"CVQjadn4nf7wmdHG","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"9DFoBWSkgI3FOl1c","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"LGKYpSNCmCeffuFo","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"v6ejxHGsBo8QVVgA","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"rwwjXL4eWekfTaQx","name":"Imperial Royal Guard","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Numbering among the deadliets of the Emperor’s servants, his elite, crimson-garbed Imperial Royal Guards enjoy a reputation for preternatural combat skills and absolute unwavering loyalty to their master. Only the most skilled and dependable fighters are chosen from the many branches of Imperial service to undergo Royal Guard training, and only a few survive this training to be unducted into the ranks of these elite warriors."}},"items":[{"_id":"VsdoG301ZRcCOZxv","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"X8A6asNQchj1cqTe","name":"Cortosis-plated force pike","type":"weapon","system":{"damage":0,"critical":2,"range":"Engaged","skill":"Melee","qualities":"Cortosis, Pierce 2, Stun Setting"}},{"_id":"ya09qUifesNpiF66","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"LfrrzlubdXIbJVTs","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"jhWzYlBtxMqofRQa","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
