{"_id":"1NvC0qVfogCB3kZB","name":"Jerserra (Early)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"It’s been many years since she left Dathomir, but Jerserra never forgot the legends of the Nardithi. Through her recent Force visions from the shard she possesses, she feels sure that finally she has found a link that will reveal the resting place of the lost cluster."}},"items":[{"_id":"mnYVyuursu7zO3hL","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"tv6NogYrm5rRAgIP","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"p3CW8cHtTvr0f8bR","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"Cl25LEhszV8Qrqn6","name":"Unleash","type":"weapon","system":{"damage":3,"critical":4,"range":"Short","skill":"Discipline","qualities":""}},{"_id":"79c35RDRN4xmHxC2","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"UfcEvUy4KvahJzku","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ZFpl3Uoer91F9n7B","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"9VwB9BoqPPb948hy","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
