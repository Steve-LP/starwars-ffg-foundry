{"_id":"lY9ICcMlIVMhylKZ","name":"Rhetoric Mimic","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"May make Charm, Deception, and Negotiation checks using the characteristics of its master; such checks suffer :setback::setback: due to the imperfect mimicry, and the droid does not benefit from any relevant talents its master possesses."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
