{"_id":"fJUQ9sfkB8Ifza0E","name":"Shield Projector","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Maneuver to activate or deactivate; while active, gains Defence 2 and upgrades the difficulty of all combat attacks targeting the droideka once, but droideka cannot use the move maneuver."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"fKcR9Qrj9xEtvTF1","name":"King Katuunko","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"ozsKGO7Qnz8Po70L","name":"Ceremonial sword","type":"weapon","system":{"damage":"3","critical":"3","range":"Engaged","skill":"Melee","qualities":"Pierce 2"}},{"_id":"6yzL8KtO8Zg6l3xw","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"NDNNzVEbCbnxwSnn","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"aDNY339hgohkqEkD","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"fMx5X9KqZO2cPT7W","name":"Flying Leaf-Tail","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The flying leaf-tail is a winged rodent about thirty centimetres long, with an equally wide wingspan. It takes its name from a membrane on the end of its tail that looks like a gnarl-tree leaf: this natural camouflage helps the leaf-tail hide from larger predators. A Leaf-tail is omnivorous: it prefers berries, but can exist on insects and smaller rodents.\n\nIndividually, flying leaf-tails are not a threat. However, if someone inadvertently stumbles across a leaf-tail nest, the creatures attack in swarms of dozens. The smugglers who occasionally catch jubba birds on Dagobah have told stories of leaf-tails ripping out a ship’s wiring, causing near-catastrophic damage."}},"items":[{"_id":"V3McCuBMadnosFmf","name":"Rodent teeth","type":"weapon","system":{"damage":4,"critical":6,"range":"Engaged","skill":"Brawl","qualities":"Pierce 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"fOVWvDJQxmZSJdrC","name":"Athletics","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"fOi4aRh0TQlnIGaI","name":"Ganga Lor","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Ganga Lor is a Chevin petty crime lord who has been engaged in a rivalry with Switch for years. Ganga Lor came to the station around the same time as Switch, and the two have never gotten along.\n\nThis massive Chevin looks old, even for his species. His trunk hangs low and scars cross his face, giving him a weathered look that matches his leathery skin. His clothes are little more than rags, and a large blaster pistol pokes out from beneath his vest as though ready to be drawn on a moment’s notice."}},"items":[{"_id":"EhVOCwXU6X5inPHK","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
