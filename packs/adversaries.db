{"_id":"74dbvHk6L3c5BQba","name":"Guavian Death Gang Security Soldier","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Slavishly loyal and utterly ruthless, the security soldiers of the Guavian Death Gang have traded their humanity and morality for dangerous and illegal cybernetic enhancements."}},"items":[{"_id":"5asGaIdxLwnMoBlq","name":"Percussive cannon","type":"weapon","system":{"damage":9,"critical":3,"range":"Medium","skill":"Ranged: Heavy","qualities":"Knockdown"}},{"_id":"n9bggqrOyX0vGfSR","name":"Implanted vibroknife","type":"weapon","system":{"damage":4,"critical":2,"range":"Engaged","skill":"Melee","qualities":"Pierce 2"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"75babFRITR9nmIDx","name":"Shipjacker","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A terror that haunts the shadows of a major spaceport, a shipjacker is a thief who specializes in stealing and quickly reselling starships. An expert at circumventing electronic security of all forms, a successful shipjacker is also intimately familiar with the protocols and procedures of whatever spaceports he chooses to prey upon Likewise, most shipjack ers have close relationships with expert forgers to ensure that the documentation required to remove a vessel from the spaceport can be quickly and convincingly acquired. Most shipjackers have a network of contacts to ensure that a starship, once stolen, can be quickly sold and moved to a distant part of the galaxy or, failing that, dismantled for parts and sold in a dozen different locations in as many different systems."}},"items":[{"_id":"oIMUqJFWSIH4o0Bl","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"Rdp9nV9tOhXJxX5o","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"BgLV2WmUmMGILGGk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"761FcWke2F0YVfl6","name":"Olfactory Sensor Suite","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Reduces the difficulty of scent-based Perception checks by 1."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"76UY95BWFTgJmlIj","name":"Centre of Being","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per round, when wielding a lightsaber, may make a Centre of Being maneuver. Until the beginning of the character’s next turn, whenever an enemy makes a melee attack targeting the character, the critical rating of the enemy’s weapon counts as {ranks|words} higher."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"775Do1K2DYGEQ8rs","name":"Blast ’Em!","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per encounter, Commander Cody may spend a Destiny Point to double the damage resulting from a Gunnery check from a single Republic vehicle in the encounter and add +30 to any Critical Injury or Critical Hit results inflicted on the target from the attack."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"78B8NuE8lstt8jIE","name":"Lieutenant Hyzhan Troo","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Hyzhan Troo was set to take command of M226 following the promotion of the ship’s last commanding officer. Unfortunately, Noor was assigned to the ship before her promotion could take place. Troo is a competent-looking and authoritative human female in her late twenties."}},"items":[{"_id":"REiDeW7LMbUSa6Bp","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"79PM8o2RposhzG3R","name":"Twi’lek Black Marketeer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"There are few races as consistently sociable as the Twi’leks of Ryloth. Capable of significant manipulation and persuasion, some Twi’leks invariably find their talents suited to helping others find things that they need, matching buyers to sellers with flawless skill and a thousand-credit smile the entire while. Black marketeers are part salesman, part fence, and all business. Knowing a marketeer can ensure that an individual is able to move an incredibly rare and valuable item without difficulty, although it will be necessary to cut the marketeer in on the sale, which eats into profits a bit. Most consider the convenience a welcome trade-off for a percentage."}},"items":[{"_id":"Qz9v0C9tBozbpuR1","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"7CPJ4JKIzjXTFIFi","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"ltY9SeRu27mLUTTk","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"ZBIOxcLb7zEMfi1i","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ZLC2558Syr1TAenu","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"79mUsZIsYPvhGA50","name":"Eopie (Cameloid)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Eopies are ponderous but surprisingly strong and resilient animals used as both mounts and labour animals on their native Tatooine. Eopies are inelegant beasts with an awkward gait and strong natural odour. Despite their stubborn nature, eopies are excellent beasts of burden, capable of carrying far more than their lanky frame might suggest. They are well-adapted to desert conditions, capable of traveling for days without needing water."}},"items":[{"_id":"qgfhbK3nkC3stgZP","name":"Trampling hooves","type":"weapon","system":{"damage":5,"critical":6,"range":"Engaged","skill":"Brawl","qualities":"Knockdown"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"7ADROvsXJg2IXZ1L","name":"AC Law Enforcement Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Rim Securities AC Law Enforcement Droids are a relatively new entry to the field of police automata, envisioned as direct competitors to both Cybot Galactica’s HXZ-1 series and SoroSuub’s recently released 501-Z series LEO droid. Nearly two metres tall, these broad shouldered humanoid droids are of average intelligence and possessed of a stern, imposing disposition. Programmed for both standard policing as well as fast response riot control duties, AC series droids are covered in imposing plate armour. Their heads have a single horizontal red band for a photoreceptor and they have only the the merest hint of other facial features. Their personality matrix seems to have been programmed with the essence of every hard-nosed, uncompromising “strike first and ask questions later” law officer in history. They are loud, brash, and skilled at physical intimidation. Their grating manner and their tendency to use overwhelming force in inappropriate situations has led to numerous complaints against both the droids and Rim Securities. While civilians may despise the AC series droids, law enforcement agencies throughout the Outer Rim love them for their brutal efficiency, and they are slowly cornering the market for police droids at the edge of the galaxy."}},"items":[{"_id":"2PphaTPsC88eIUUK","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"H9OHVDHAHPvPSCFt","name":"Stun baton","type":"weapon","system":{"damage":0,"critical":6,"range":"Engaged","skill":"Melee","qualities":"Stun Damage, Disorient 2"}},{"_id":"KIQjsS8gdEsn4wgF","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"7AuiqgjzD1EZIupn","name":"Leader","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"All subordinates within Medium range add :boost: to all Discipline checks."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"7B238SmcFSEysAaz","name":"Reinforced Frame","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"7Bh5TNonObVNztMQ","name":"Siluuk Eel","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A valued source of food, these snakelike fish range from one to eight metres in length and have glowing rings running the length of their bodies. Farmers in Arnel grow and harvest them in huge numbers for local sale and shipment off-world. Tending is an athletic endeavour, as the eels fight the farmers each step of the process, often by leaping several metres out of the water to snap at one of the hovering Toydarians.\n\nSiluuk Eels can be found in a variety of sizes depending on their maturity, but all can be aggressive regardless of their size."}},"items":[{"_id":"shMfe3az7vt0Tg09","name":"Teeth","type":"weapon","system":{"damage":9,"critical":4,"range":"Engaged","skill":"Brawl","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"7DJS7m7Al8WZ0Umk","name":"M226 Bridge Crew","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The bridge crew of M226 are an experienced lot, and many of them have served aboard the heavy freighter since it was first commissioned. Though loyal to the Empire and willing to follow Noor’s orders, they are much more comfortable under the command of their executive officer, Lieutenant Troo."}},"items":[{"_id":"q41X2m6OkQQoly6L","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"7E0oGyNKDUB3hAYI","name":"Improvised Transport","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As a maneuver, Embo may convert his Kyuzo helmet into a Silhouette 1, Speed 2, Handling 0, System Strain Threshold 3 vehicle that can only operate on the ground and requires Piloting (Planetary) (:proficiency::proficiency::ability::ability:) to use. While using it in this way, Embo may not use the helmet’s weapon profiles and does not benefit from its Defensive or Deflection item qualities."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"7JLqsVwyIGk7O6X6","name":"Confidence","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Decrease difficulty of Discipline checks to avoid fear {ranks|times}."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
