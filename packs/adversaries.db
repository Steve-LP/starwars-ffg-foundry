{"_id":"wJqK36oPIb1faI77","name":"Jodo Kast","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Jodo Kast is a young and ambitious hunter who is determined to make a name for himself. As a member of the exiled Deathwatch affiliated Clan Kast, Jodo is cold, calculating, and extremely dangerous. His armor makes him a veritable walking arsenal but he favors his darts above all other weapons - each is coated with a different poison to stun, paralyze, or kill."}},"items":[{"_id":"I5dQ8gZG9nQ8OJ94","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"li3QLavVLX2zU9Cl","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"zfyrB1qlQ3ZA0TCy","name":"Blastech J3-E Heavy Blaster Pistol","type":"weapon","system":{"damage":8,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":""}},{"_id":"eRAvEv4hhuAO7X88","name":"Micro-Rocket Launcher","type":"weapon","system":{"damage":8,"critical":4,"range":"Medium","skill":"Ranged: Light","qualities":"Breach 1, Limited Ammo 1"}},{"_id":"nS7NM9uOfzth4ARe","name":"Vambrace Blaster","type":"weapon","system":{"damage":6,"critical":3,"range":"Short","skill":"Ranged: Light","qualities":""}},{"_id":"fzHvuJdMWtJQh69H","name":"Vambrace Flame Projector","type":"weapon","system":{"damage":5,"critical":2,"range":"Short","skill":"Ranged: Light","qualities":"Blast 2, Burn 2, Limited Ammo 3, Pierce 2, Vicious 3"}},{"_id":"Hk9yEd9VEgQFUqpl","name":"Vambrace Dart Launcher","type":"weapon","system":{"damage":1,"critical":0,"range":"Long","skill":"Ranged: Light","qualities":"Limited Ammo 5"}},{"_id":"IAfMmD2hYMRsKpdo","name":"Vambrace Grapnel Launcher","type":"weapon","system":{"damage":3,"critical":5,"range":"Medium","skill":"Ranged: Light","qualities":"Ensnare 3"}},{"_id":"c0jbD60YuSjt5YPD","name":"Vambrace Repulsor","type":"weapon","system":{"damage":8,"critical":4,"range":"Short","skill":"Ranged: Light","qualities":"Disorient 3, Knockdown, Stun Damage"}},{"_id":"TdV7BTe3Ttn86oPa","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"1AgEcyYG5Nd0OrGG","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"a4lSzNRPOJ2EDSfy","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Ev1SHXFgRF2mDUfo","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
