{"_id":"Lsi8l5V2G0EMMMsO","name":"Choku","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Choku are aggressive reptavian pack hunters that navigate the dense vines and tree limbs of Yavin 4 ’s jungles. Although the quadrupeds’ bright white and grey fur, punctuated with brown and tan stripes, should stand out against the verdant jungle, they are difficult to spot when on the hunt. Traveling in packs of three, choku outmaneuver their prey, killing with beaks filled with sawlike teeth."}},"items":[{"_id":"IKEjyJ6qrl4R2gZ5","name":"Serrated teeth","type":"weapon","system":{"damage":3,"critical":5,"range":"Engaged","skill":"Brawl","qualities":"Vicious 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Lunek141dUQjEkcb","name":"Ahsoka Tano (Fulcrum)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Ahsoka Tano is one of the rarest individuals in the galaxy: a nearly fully trained Jedi who escaped Order 66 and years of pursuit by Imperial Inquisitors and agents. The one-time Padawan of Anakin Skywalker left the Jedi Order when she lost faith in its actions after she was wrongfully suspected of a terrorist act. After Order 66, she tried to hide herself in the Outer Rim and no longer considered herself a Jedi. Her desire to help eventually re-emerged, drawing the attention of both the Empire and Bail Organa. Though she followed her own path, she also became Organa’s agent, codenamed Fulcrum. She was instrumental in growing the rebellion, until she discovered Darth Vader’s true identity. Their confrontation on Malachor, though, may have possibly been her final battle."}},"items":[{"_id":"6PtmtSpIrOsxzz5b","name":"Pair of lightsabers","type":"weapon","system":{"damage":6,"critical":2,"range":"Engaged","skill":"Lightsaber","qualities":"Breach 1, Sunder, Dual-Phase"}},{"_id":"ZmDRVUL6mNnvO52i","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"d3A3S7xaPIWg7EqT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Af0SyeWbIkUTAiVu","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"QJzTglQzN6eSxRi2","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"nk6qAATKJVNH81zc","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"nX8IS3MWHLpHHGvP","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Jz088R5bmRbQJyi9","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
