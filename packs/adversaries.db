{"_id":"3ug8VAVxaRziHQkR","name":"Hawk Bat Swoop","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"May perform a Light­saber (Agility) melee combat check against one target within Short range and add :force: no greater than Force Rating to the pool. The character may spend :forcepip: before resolving the success or failure of the check to engage the target immediately as an inci­dental, and may spend :forcepip: to add :advantage: to the check. If the character cannot move to engage the target, the attack automatically misses."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
