{"_id":"MJ1YUSzZmJfkFKmn","name":"Hard Headed","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"On any turn when Staggered or Disoriented, may perform the Hard Headed action to make a :daunting: Discipline skill check. If successful the character is no longer Staggered or Disoriented. The difficulty of this check decreases by one per rank, to a minimum of :easy:."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"MKuuvzlue1w1bj12","name":"Whaladon","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Whaladons are enormous, cetacean-based marine mammals that live within Mon Cala’s seas. These whalelike creatures, which can reach almost thirty meters in length, are one of the many sentient species of their world. Whaladons have coexisted with Quarren and Mon Calamari for millennia. They main tain an unofficial embassy around the domed city of Aquarius, communicating in songlike calls. Despite whaladons’ sentience, offworlders have been known to hunt them for sport and profit."}},"items":[{"_id":"3ajbYqTtWQpjPWWx","name":"Tail","type":"weapon","system":{"damage":15,"critical":5,"range":"Engaged","skill":"Brawl","qualities":"Concussive 1, Slow-Firing 1"}},{"_id":"PlzYcdbwIeJaO524","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
