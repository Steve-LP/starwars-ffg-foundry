{"_id":"MAYX1IdMBETqC44V","name":"Regent Credi Solfinn","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once an advisor to Queen Nehanna, Credi Solfinn has taken to the role of acting regent with a public reluctance and quiet calm that inspires the general populace to trust him. Pie frequently addresses the public with progress reports on the investigation into the queen’s disappearance."}},"items":[{"_id":"A1KWeZk3rHQzaCLp","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"uAnNlv30TJBTWUof","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
