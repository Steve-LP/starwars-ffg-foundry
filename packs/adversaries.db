{"_id":"Tv8aoEOD4IGgYecL","name":"Mon Cala Eel","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"An oddity of the coral depths, Mon Cala eels graze Mon Cala’s ocean floor, electrocuting those who threaten them. These elongated, four-eyed creatures range from one to three meters in length and have textured, phosphorescent skin. Quarren have been known to create makeshift prison cells out of lashed-together eels."}},"items":[{"_id":"ubHN3CxD7DAthzyp","name":"Electric skin","type":"weapon","system":{"damage":8,"critical":0,"range":"Engaged","skill":"Brawl","qualities":"Stun Damage"}}],"effects":[],"flags":{},"ownership":{"default":0}}
