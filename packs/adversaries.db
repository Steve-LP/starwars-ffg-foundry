{"_id":"INWzVIzTVuD3iYY3","name":"Jyn Erso","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"isWd39Cc3Stjt8NX","name":"Jyn’s blaster pistol","type":"weapon","system":{"damage":6,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":"Stun Setting, Disorient 1"}},{"_id":"pLsMKWDZV8c8HW5u","name":"Paired truncheons","type":"weapon","system":{"damage":6,"critical":5,"range":"Engaged","skill":"Melee","qualities":"Disorient 2, Knockdown, Linked 1"}},{"_id":"RUMnaFrXw0fkwdsB","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Ly75tn35kpxjjHzg","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"CChOqxNKuKTnahTh","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"INjSCVRrvzqleakW","name":"Jalla","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Presenting herself as a bubble-headed blonde human with far too much makeup and far too much interest in clothing and jewels, Jalla’s persona is a well-crafted act to hide a sharp and cunning mind. She and Cam are currently lovers, though she’d leave him if the right opportunity presented itself."}},"items":[{"_id":"4XXi5AxZjISuqizf","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"KjIoA4bd8trw4t9E","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
