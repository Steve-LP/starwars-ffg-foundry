{"_id":"2wwT9vSNLA2ERKdq","name":"Fifth Brother","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Fifth Brother is a male agent of the Inquisitorius with blocky features and grey skin. He confronts challenges directly and decisively rather than engaging in pursuit and reconnaissance. Fifth Brother prefers to physically overpower and eliminate his opponents, instead of capturing and questioning them. His fighting style is particularly savage, seeking to overcome and exhaust his opponents with potent strikes."}},"items":[{"_id":"50hc606Y9Wkey8EQ","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"jmxHPSMjndjaVkbv","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"Xw0N7v8rOz7vDWmg","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"PrI0NVnXLlWIx74K","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"B4ApREi2T5hbqqFv","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"GvHTmWXO9wy6DFQx","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"eFQfrTCySeYs2k7p","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"X00afG9R3jWOxRii","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
