{"_id":"ygpXRbKGqsGDFPXm","name":"Krash, Sorority Kill Team Leader","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Krash is a large and imposing Barabel shockboxer who washed out after a lost bout that nearly killed him. Disgraced, he turned to drink and spice until he met with a Sorority recuiter in the cantina. He has since recovered from his shame and addiction, and dedicates himself to the Sorority’s business on Saleucami."}},"items":[{"_id":"FNNTen4gkCuFRGAO","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"m14LxqcONe8E3Wmm","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
