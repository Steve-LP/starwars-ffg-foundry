{"_id":"x5LChMklJjL2CsBD","name":"Ornery","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Add :setback::setback: to all checks made to handle, domesticate, or otherwise work with a nerf."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"x7YGTPEPcQ3C7MeV","name":"Fecklen","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The dominant ranching animal on the planet, the squat, stumpy fecklen is ubiquitous across Chandrila, and known for its savory meat and pure milk. Fecklen wander the Chandrilan countryside, grazing on balmgrass and occasionally blocking traffic. The fecklen is a peaceful herd animal known for its booming call, evolved to echo across the hilly landscape to frighten predators and locate the herd."}},"items":[{"_id":"moR4DwALiMtEbpGv","name":"Horns","type":"weapon","system":{"damage":6,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Knockdown"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"x7iPrUEK4UZnB7dr","name":"Dorrian Vodani, Dressellian Pilot","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A middle-aged Dressellian with tan, wrinkled skin, Dorrian Vodani stands 2.2 metres tall. He often dresses in a simple orange flight suit, even when off-duty.\n\nThe Dressellian pilot is quiet and introspective. He spends a great deal of time reading old texts from his home-world: the writings of an ancient philosopher known as Corrimias. He has patterned his life on these philosophies and is a strict adherent to Corrimias’s teachings of freedom and equality."}},"items":[{"_id":"GOdtZ58nlrutC7EG","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"z2KGjz17Q1Fi1Z7u","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
