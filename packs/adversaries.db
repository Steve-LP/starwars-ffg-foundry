{"_id":"G4IXFryvPriTVRuX","name":"Zeke, Clone Trooper Platoon Leader","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Zeke was a junior sergeant at the end of the Clone Wars and became a valued part of the mercenary band of retired platoon comrades. In the years that followed, he found himself rising in rank as other members fell in action. Just prior to landing on Saleucami, he became leader of the group. Zeke is an excellent commander, but over the years he has grown distant and cold as more and more of his men have died. He was nearly killed by a pride of thaelos in Blackwind Crater, if not for Oake’s medical skills, Zekw would have lost a lot more than jusy his left arm. Despite this, he is still a capable and deadly trooper."}},"items":[{"_id":"OW0zyOmsEI9CqtEF","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"58ixgqBiooZTT3Kt","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"oH4Tzpc0Jy1xg5yG","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"89JyRw8c5Ar8MD5P","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"hlXUNpe7OFhb0nlw","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
