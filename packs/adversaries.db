{"_id":"f6ntVqrVR4R6AsxO","name":"Wookiee Rage","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Deal +1 damage with Brawl and Melee attacks when suffering any Wounds. When suffering a Critical Injury, deal +2 damage with Brawl and Melee attacks instead."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"f77pXFk1sL7eurWX","name":"Imperial Stormtrooper (DoD)","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"These stormtroopers are solely concerned with capturing Maya, the Alderaanian Security agent. They are trigger happy, though, and are more than willing to shoot anyone who stands in their way. When the encounter begins, they attempt to stun Maya but use lethal force against any other opponents."}},"items":[{"_id":"sGCmk8mR9Q5E3g5K","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"ipF5EDrQjuEZuUVI","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"DHUKaejRXrhwqCQK","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"ITo3aYNgmfw2fCjH","name":"Light repeating blaster","type":"weapon","system":{"damage":11,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Auto-Fire, Cumbersome 4, Pierce 1, Weapon Sling"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"fAd7TkcoADzgFVZ5","name":"Reckless Strike","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As an incidental, once per round, the GM may have the Kintan Strider reroll a Brawl or Melee check; if he does so, the Kintan Strider loses the benefits of the Adversary and Durable talents until the beginning of its next turn."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"fE0rflxS94RVUewN","name":"Lightsaber (Willpower)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"fEiokS5iFOU2CUsP","name":"Halari Takan","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A young firebrand, Halari Takan came of age during the Empire’s brutal subjugation of her homeworld. As a child, she watched helplessly as members of her family were dragged away in chains, one after another, by Imperial agents. This experience, combined with her strong will and natural fiery demeanor, drove her into the burgeoning resistance movement that was sweeping Mon Cala’s floating cities. Never much for military matters, Halari instead focused her efforts on organising protests, work stoppages, and general strikes. She did so with a combination of gravitas and rhetoric rarely found in one so young, and quickly gained a reputation as an inspiring and captivating speaker. And speak she did. Her fear of Imperial reprisals outweighed by her hatred of the interlopers and her rage at their treatment of her people, Halari spoke in the streets, in the council halls, and in the media, spreading a message of dissent and anger that immediately drew the ire of the Imperial authorities.\n\nAfter a failed kidnapping attempt and a successful campaign to discredit her and her allies, Halari went into hiding, constantly moving between safe houses and acting from the shadows rather than in Coral City’s parks and plazas. When the Empire was finally driven from Mon Cala, she came out of hiding and was immediately drafted to be one of the Quarren representatives to the Mon Calamari. Now, after only a few years in this position, she has made as many enemies as she has made allies. Her uncompromising attitude toward the Empire and toward the injustices suffered by the Quarren at the hands of the Mon Calamari, and her insistence in stating these attitudes loudly and repeatedly, makes her hard to negotiate with."}},"items":[{"_id":"ztmXV40mtqI8BqEU","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"clGHmqiFFF2QUJn1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"D354YwUYGaQLv0dw","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"GwpHolVqoWj05KfW","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"GT0CrRWZPdWrQ1Lm","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"fGxyYmfue05mkVkH","name":"Baron Dorn Sevelle","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A human trade baron from Raithal, Dorn Sevelle is a representative of the KSC, and he was until recently a close friend of Prince Molec. The two often sat together during slave gladiatorial matches, wagering on the outcomes. The latest such bet resulted in Sevelle’s walking away with the prince’s top prizefighter. Realising the warrior is more trouble than he is worth, Baron Sevelle sold the gladiator to the Thalassians. Now he awaits their arrival to pick up their prize."}},"items":[{"_id":"rUXr8z71gkDu36IC","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"mK7Zh5aNH12xUEtJ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
