{"_id":"dp1ALXc1U871QOIo","name":"Diplomatic Solution","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session, at the GM’s discretion, when a combat encounter against one or more sentient creatures is about to begin, Mina Bonteri may spend a Destiny Point and make a :daunting: Charm check to turn the encounter into a social encounter instead."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"dpL4UfuaIMuiNr7z","name":"Nexu","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Nexu possess a fearsome appearance, with a huge, toothy maw, four beady eyes, and massive, claw-tipped paws, all backed up by a pair of barbed tail spikes. What’s more, nexu are fully as lethal as their natural armament would suggest, and possess a temperament and instinctive cunning that make them even more greater threats. Although naturally stealthy and elusive, nexu do not lack for ferocity or mettle in a direct fight, and they rarely back down in the face of any threat they encounter. Even when faced with a more ferocious predator, nexu are more likely to attempt to melt away into the underbrush and attack again using stealth to gain an advantage than to simply flee their hunting grounds."}},"items":[{"_id":"tFzPA81j3XlH2rWO","name":"Claws","type":"weapon","system":{"damage":5,"critical":4,"range":"Engaged","skill":"Brawl","qualities":""}},{"_id":"BTeG76FJ3rpoNR4q","name":"Bite","type":"weapon","system":{"damage":7,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Ensnare 1, Pierce 1"}},{"_id":"LDEvajVPeLlXFGCc","name":"Tail whip","type":"weapon","system":{"damage":4,"critical":4,"range":"Engaged","skill":"Brawl","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"drtf5MOXXeQ0LgrR","name":"Pashna Genko","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A native of the Mon Cala capital of Coral City, Pashna is one of the few Mon Calamari women in the Alliance’s fighter corps. She is currently the leader of the 88th Attack Squadron, the Y-wing squadron recently assigned to Polis Massa. Her squadron has taken the brunt of the attacks, as the slower, heavier Y-wings make easy targets for the speedy phantoms. Only six Y-wings remain, including hers."}},"items":[{"_id":"zPR5ja17bC5ooKip","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"lnz34f4iscT8sWp3","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
