{"_id":"xK2795YBsrCuY48K","name":"Empty Soul","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"If carrying items that total 2 Encumbrance or less, may add :lightside::darkside: to any Force power check."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"xKt7p5rLPB93dPkM","name":"Stormtrooper: Swamptrooper","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"This specialised unit of the Stormtrooper Corps specialises in operating in swamps, bogs, and wetlands. Swamptroopers’ armour is watertight, has an internal one-hour oxygen supply, and includes camouflage. Swamptroopers patrol the area in teams of three."}},"items":[{"_id":"gsZF6hIN44vfEkz9","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"SId5K02O3Q6soDsL","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"xLFagjbQdVzUqoUS","name":"Trandoshan Guild Master","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"yMLAVogFAWWn5Jz1","name":"Modified net launcher","type":"weapon","system":{"damage":"3","critical":"-","range":"Medium","skill":"Ranged: Heavy","qualities":"Ensnare 5, Limited Ammo 1"}},{"_id":"IuHuqqxU0CuMkHz3","name":"Claws","type":"weapon","system":{"damage":"7","critical":"3","range":"Engaged","skill":"Brawl","qualities":""}},{"_id":"UQaeHCoCtBMyNkeI","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"glXhrmopCP2BX3uv","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"fEuhA7Ak0kn6KOrG","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"xN2agafIw3xzhM3M","name":"SDMN-Series Session Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The SDMN “Side Man” series entertainment droids were designed by Cybot Galactica to be the ultimate entertainer’s sidekick. Designed by focus group and committee, the Side Man droids are built to be as inoffensive and engaging as droid technology allows. They can be ordered from the factory with a number of add-ons and special programmes tailored to their owner’s particular needs, from an illusionist’s assistant to a wail band’s percussionist. A Side Man has an obsequious, eager to please personality that professional entertainers tend to find incredibly irritating. As such, most SDMN droids working throughout the galaxy, especially those owned by musicians, have been reprogrammed to be both more enjoyable to be around and better suited to operating in the often seedy, disreputable trenches of the galactic entertainment industry. Despite their built-in personality flaws, Side Men are quite competent and are in high demand by professional and aspiring entertainers."}},"items":[{"_id":"zfTJw1gRRFSLK9Td","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"orPzqo2yupJeA3oG","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"xPEhEAPBdQYB0og4","name":"Rasz Kal","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Rasz Kal is a small-time crook, smuggler, and thief who fancies himself a crime boss. Fairly short and small in stature, with a quick wit and quicker reflexes, Rasz is uncharacteristically brash and bellicose for a Duros. Easily angered and difficult to deal with, Rasz leads a motley gang of thugs, including a Barabel, an Aqualish, and a Rodian."}},"items":[{"_id":"xBHXuUwCBwiB9AOf","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"6aIr8r1jdKTdtN3T","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"f7dmuU34d3ntKtcD","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"xUyWwA5r0lyIE2Zt","name":"Expert Forger","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The sheer size of the Galactic Empire’s bureaucracy is such that few sentient beings can ever hope to familiarize themselves with the entirety of it during a normal lifespan. The volumes of permits, papers, licenses, and countless other forms of registration are enough to frustrate and stymie even the most determined soul. Fortunately for the Alliance and others unable or unwilling to pursue official channels, there are those in the galaxy who can and will produce whatever bureaucratic credentials are required—for a price. Forgery is an extremely lucrative, if dangerous, business, and one that thrives in virtually every corner of the known galaxy. Those who take up such a practice as their profession often choose to specialize in one particular aspect of the bureaucracy, as trying to diversify too much is resource-intensive and can bring unwanted attention."}},"items":[{"_id":"plYJN0a33hEyOpYu","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"xVRM4xLs2uV2bzEV","name":"Sacorrian Grey Bear","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The grey bear of Sacorria stands anywhere from two-and-a-half to three metres tall. With extremely long arms, blade-sharp claws, and a voracious appetite for anything it can get into its omnivorous jaws, the safest way to deal with one is avoidance or heavy firepower."}},"items":[{"_id":"2Br6mvPrfsMIJ3jn","name":"Vicious claws and teeth","type":"weapon","system":{"damage":8,"critical":4,"range":"Engaged","skill":"Brawl","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"xVXHAOkYCOShADFZ","name":"Guard Massiff","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"An armoured lizard native to the Outer Rim world of Geonosis, the massiff’s keen senses and predatory instincts make a formidable guard animal when combined with the right training. Massiffs have been employed in this role by the settlers and Sand People of Tatooine, the Coruscant Guard and Recon Force of the Grand Army of the Republic, and on many planets and organizations across the galaxy. These massiffs have been trained by their handlers to detect intruders and contraband by sense of smell, and to restrain rather than tear with their formidable claws."}},"items":[{"_id":"jaNV5DfPPn8QuC9q","name":"Tearing fangs","type":"weapon","system":{"damage":4,"critical":2,"range":"Engaged","skill":"Brawl","qualities":"Vicious 3"}},{"_id":"d2BwrjFeOtadOpcU","name":"Claws","type":"weapon","system":{"damage":5,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Ensnare 1"}},{"_id":"ov8xtpsTdhMMfswc","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
