{"_id":"0YIaWC1b0XdZiFa9","name":"Walisi","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Walisi has run his shop for years now, slowly rising in influence across Toydaria and becoming known at an interstellar level. Though he has been somewhat concerned about how much power the Gorensla kajidic has over him, so far the arrangement has been mutually profitable. He had anticipated that the auction of *Tragic Hope* would be his grandest achievement yet, but he was quite unprepared for the unwanted attention it brought — perhaps enough to make the statue his final acquisition."}},"items":[{"_id":"1FXeXQ2EduN1G7Pw","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"lBrZd4vCocuu3AEH","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
