{"_id":"TadF2DeAfGIKzQ78","name":"Magnet Modification","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session when an enemy uses a thrown metal weapon to attack an ally within Short range of QT-KT, she may negate the attack as an out-of-turn incidental."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"TbqiiLHT9rhI8kQb","name":"Centre of Being (Improved)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per round, when wielding a lightsaber, may make a Centre of Being incidental. Until the beginning of the character’s next turn, whenever an enemy makes a melee attack targeting the character, the critical rating of the enemy’s weapon counts as {ranks|words} higher."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Tcl09karsO32xFej","name":"Mature Tusk Cat","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Tusk cats are feline predators that can grow up to two meters high and three meters long. Named for the two distinct tusks growing from their lower jaws, these mammals are social creatures who mate for life and form prides. They even can “guard” herds of prey animals, eating one every so often while protecting the rest of the herd from other predators. These instincts make them surprisingly easy to do mesticate, and they are large enough that they can be ridden by most humanoid sapients. Many an Outer Rim wanderer relies on the keen eyes and sensitive nose of his trusted tusk cat companion."}},"items":[{"_id":"ttmXBdr2sjQicBIA","name":"Tusks and Claws","type":"weapon","system":{"damage":6,"critical":2,"range":"Engaged","skill":"Brawl","qualities":"Pierce 2"}},{"_id":"1KL27Hou6HU0tPL1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
