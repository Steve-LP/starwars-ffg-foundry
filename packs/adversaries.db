{"_id":"TPDTGVSDQytXtC0I","name":"Quolas Citizen","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The people of Quolas are a downtrodden lot after decades of Marcolf’s misrule, but they are not so broken in spirit that they will decline to rise up if the opportunity presents itself. Many are still old enough to remember a time before Marcolf."}},"items":[{"_id":"nx9obSELKJ90vYv5","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"HcIEMzlLfr3F2rjp","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
