{"_id":"NdfeMZCxMBLRIkfL","name":"Irrica the Hutt","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Irrica’s life on Toydaria is near perfect. As Gorensla’s leader in Riar, she enjoys a great deal of power, albeit on the local stage. The ongoing rivalry with the Desilijic kajidic, however, has reached an intolerable level; she has started to see Desilijic’s machinations (whether real or imagined) in each recent setback and failure."}},"items":[{"_id":"2cnpadJquASRTqOa","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"SrmfOuY9VSuXnoim","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"0umDC929SyYYboBB","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"7gOxVVQqWBBRo1TN","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Sql3dBccLiPcwfCX","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"jp2Qw31EZxn047QT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
