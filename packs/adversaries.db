{"_id":"xi9WSte5YE2PPiiv","name":"Kirruk Riding Beast","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"These muscular, horned reptilian quadrupeds are cave dwellers, and hardy enough to survive the decimation of Ossus. The Ysanna call them “kirruk” after their squawking call, and they breed them to serve as beasts of burden and riding mounts."}},"items":[{"_id":"lO4d4XfKaj389Kaw","name":"Teeth","type":"weapon","system":{"damage":8,"critical":2,"range":"Engaged","skill":"Brawl","qualities":"Pierce 3"}},{"_id":"hNtL0zlXW71YqL90","name":"Claws","type":"weapon","system":{"damage":6,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Disorient 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
