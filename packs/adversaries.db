{"_id":"B2JPXYs59TIUsgjC","name":"Cultist War Droid","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"These custom war droids look like skeletal humanoids with smooth, blank faces. Each carries a unique pulse-wave array that looks like a metallic unstringed bow, but fires a powerful disrupter blast. The ends are filed to sharp points suitable for spearing opponents if necessary.\n\nThe droids identify the strongest opponent within range and swarm until victorious, then systematically move to the next most powerful target. Sianna Sekko programmed the droids to fight the Jedi, so they always favour a target with an activated lightsaber."}},"items":[{"_id":"j1PeV3VChAu9i9vO","name":"Pulse-wave array","type":"weapon","system":{"damage":8,"critical":2,"range":"Short","skill":"Ranged: Light","qualities":"Vicious 3"}},{"_id":"WBUG5PtajBUMT4gY","name":"Pulse-wave edges","type":"weapon","system":{"damage":6,"critical":4,"range":"Engaged","skill":"Melee","qualities":"Pierce 2"}}],"effects":[],"flags":{},"ownership":{"default":0}}
