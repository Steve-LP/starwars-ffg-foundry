{"_id":"zYKJA3yEMHBJCBTv","name":"Blaster Spiral","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per encounter, Highsinger may suffer 4 strain to make a combat check with his light repeating blaster against the hardest to hit enemy (as determined by the GM) within Short range, with a base difficulty of :hard:. On success, every enemy in Short range suffers 1 hit that deals base damage plus additional :success:."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
