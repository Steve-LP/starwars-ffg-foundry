{"_id":"IyADGtw9sq9sfSfo","name":"Commander Freila","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Originally from Chandrila, Jyn Freila joined the Rebellion after pirating one of Mon Mothma’s speeches from the shadowfeed. Formerly a starfighter pilot, Jyn was promoted out of an X-wing cockpit after losing an eye and most of her squadron during a raid on an Imperial shipment of quadanium steel gone horribly wrong. Commander Freila is an experienced pilot whose combat record speaks for itself. Her chief concerns are keeping Keff Base hidden and “capturing” supplies arranged by SoroSuub to be unguarded."}},"items":[{"_id":"AwmCtVwy1TH3X9E6","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"wGe3oKNLnHG6p8yQ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"AWY7joaxnwfojyig","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
