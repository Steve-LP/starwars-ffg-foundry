{"_id":"uzFwDyMmayM86nia","name":"Saboteur Load Lifter","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Cybot Calactica CLL-series load lifters are capable of bludgeoning enemies with their powerful loading arms or bashing them with large crates and equipment."}},"items":[{"_id":"8xThr3vNpnpSIucs","name":"Truncheon lifters","type":"weapon","system":{"damage":6,"critical":5,"range":"Engaged","skill":"Brawl","qualities":"Disorient 2"}},{"_id":"GBYImtY263jJy3Tf","name":"Large improvised weapon","type":"weapon","system":{"damage":7,"critical":5,"range":"Engaged","skill":"Melee","qualities":"Cumbersome 4"}}],"effects":[],"flags":{},"ownership":{"default":0}}
