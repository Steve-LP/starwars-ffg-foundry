{"_id":"aKwM3UB60ON2ZdHf","name":"Passk","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Passk appears somewhat short for a Trandoshan, and he dresses in outdated business attire. His amber eyes glisten with a hidden cunning, and he always seems to be smiling about something. He prides himself on being able to find out anything; with enough time and credits, he usually can."}},"items":[{"_id":"ioMJBjMjRAOarRex","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"R2ljnU7HZ1hblzec","name":"Claws","type":"weapon","system":{"damage":0,"critical":3,"range":"Engaged","skill":"Brawl","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
