{"_id":"AfQ43kbw8ZEzIJG4","name":"Skyholme Astromancer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Skyholme Astromancers may seem odd to those who first encounter them; they are erratic and unstable men and women with long robes, disheveled hair, and a pouch full of strange and disgusting items. However, individuals would be foolish to discount their abilities, for they can see the future and even shoot fire and ice from their hands."}},"items":[{"_id":"qw6TwpVxrnAh2fJX","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"zoEgxWl8N3X9NpVU","name":"Unleash","type":"weapon","system":{"damage":4,"critical":4,"range":"Short","skill":"Discipline","qualities":""}},{"_id":"ULU675KY7uLNQXXb","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"8of6uTYDBa5h4wYg","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ao9511wqhhsKYawu","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"AfyDlHTnbZVnZy7P","name":"Sorority Kill Team Member","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Coming from various species, genders and back grounds, the only thing that unites the four members of the kill team is their loyalty to the Sorority. They are well paid and live reasonable good lives in Taleucema."}},"items":[{"_id":"G76yRljJyX97jKGl","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"dqUhnGbjzR9l3xQu","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
