{"_id":"UtD0VgDWn4QMu3aR","name":"Porel Vakra, Zann Consortium Underboss","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Given that Porel has been a Consortium member for nearly fifteen years, many are surprised he hasn’t advanced higher in the ranks. The truth is, he enjoys being where he is, and he has proven himself to be a loyal member of the Zann Consortium time and time again. Porel is a perpetuallt stoic Twi’lek, both in his manner and his speech. He dresses conservatively, favoring tailored suits that conceal his hidden pistol. Based on his plain appearance, many people underestimate him—often to their painful detriment."}},"items":[{"_id":"MHu4pr9r9lW7Ld7r","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"YpJIhvQKhntT74VK","name":"Holdout blaster","type":"weapon","system":{"damage":6,"critical":4,"range":"Short","skill":"Ranged: Light","qualities":"Stun Setting, Superior"}},{"_id":"8YaZPrQ5WI6uuvKP","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"GNfm0NMVrP0XFG69","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"PZ8i8g2jtDEkaLVw","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
