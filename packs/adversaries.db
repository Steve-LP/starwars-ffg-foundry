{"_id":"0JVJxXCmYY3hyHoS","name":"Fereallis Pirate Crewmate","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Captain Gideon’s crew consists of three Weequay enforcers, a Twi’lek first mate, two human smugglers, and an Aquilish hired thug. For convenience, all crew members use the same profile listed here."}},"items":[{"_id":"tKudBHHk7uncCD2u","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"hmqAJdVEL8PUcDzc","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"azsz7hQ0iHQLgxLh","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"0Ll5rfFA0hVog0BU","name":"Barrows’ Thug","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The oppressors of those residing in the Barrows are mostly bored-but-cruel men in their late teens and twenties. Natives of Ord Radama, the thugs enjoy a comfortable life thanks to their service to the IIS and won’t give it up easily."}},"items":[{"_id":"azKa8Bk2LF5JSs8W","name":"Makeshift weapons","type":"weapon","system":{"damage":5,"critical":4,"range":"Engaged","skill":"Melee","qualities":"Inferior"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"0LrPZa0HC4bAJQ9E","name":"Dirty Tricks","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per encounter as an action, Dengar may make a :hard: Skulduggery check. If successful, he may select one enemy within Short range, plus one additional target per :success:, to suffer 4 Wounds. After resolving this, Dengar may perform a Move maneuver as an incidental."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"0QfVBtlHLDOqSg9A","name":"Force Power: Move","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The character may hurl objects by making a Move Force Power check and rolling a ranged attack as part of the pool. The attack’s difficulty is equal to the Silhouette of the object being thrown (default is Silhouette 0) and only succeeds if they can also spend enough :forcepip: to move the object. The attack deals damage equal to the Silhouette of the object times 10 (Silhouette 0 deals 5 damage) plus one per :success:. To throw multiple objects, they must generate enough :forcepip: to move multiple objects, and must use rules for Auto-Fire to determine difficulty and targeting."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"0SD0pWyIjyX0ctS2","name":"Grapple","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per round, may perform the Grapple ma­neuver. Until the beginning of the character’s next turn, en­emies must spend two maneuvers instead of one to move from Engaged range to Short range of the character."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"0SxrIJ7zTDis7s0i","name":"Concentrate Your Fire!","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"May perform a maneuver to direct one allied minion group within Medium range; the group may perform an immediate free combat check action."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
