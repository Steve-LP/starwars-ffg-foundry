{"_id":"BhbUFu5N3wwsP5PD","name":"Raf, Workgang Leader","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Raf is a large, muscular, and albino Zabrak, with pale skin and pink, brooding eyes. A large black spot has been tattooed in the center of his forehead. He dresses in a worn work suit and carries a number of vibroknives. Raf has a reputation on the docks for being easily insulted."}},"items":[{"_id":"b2ZWooFf4uC5ZrW8","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"LEyhh3nwwJdrYNLE","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
