{"_id":"1yMuq5Zz6vtXHrOZ","name":"Revah, Decoy Pirate Queen","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The leader of the Veiled Sorority on Saleucami is Revah, a middle-aged human female who has been with the pirate group for over a decade. One of the Queen’s decoys, she wears a mask that is nearly identical to the one worn by the Sorority’s leader. Without her mask, she appears as a rather plain human female with high cheekbones, blue eyes, and braided grey hair. As far as the Saleucami’s Sorority’s pirates are concerned, she is the Queen; only one or two individuals know the truth behind her duplicity. Despite being a surrogate queen, Revah is a canny operator and leader who hopes to be elevated to the Queen’s position in time."}},"items":[{"_id":"nWvj974gwK7QXD51","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"Tf7qyXkje17MBqHF","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"jZMQoHjxYXbONyjs","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"cjndlDSBxU6Z5tSe","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"1yUJ6fpjqro4BUrk","name":"Lor Keln","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Lor Keln is the cruel, one-eyed leader of the Crimson Kreehawks, reporting directly, if infrequently, to Onrein Hasar. Keln takes a perverse joy in inflicting pain on her enemies, preferring to humiliate foes before delivering a killing blow, unnecessarily prolonging fights."}},"items":[{"_id":"DMubeUvNjWzxlITP","name":"Vibroknuckles","type":"weapon","system":{"damage":4,"critical":2,"range":"Engaged","skill":"Brawl","qualities":"Pierce 1, Vicious 1"}},{"_id":"m6Y9nfvJFqTynx0n","name":"Custom heavy blaster pistol","type":"weapon","system":{"damage":8,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":"Stun Setting"}},{"_id":"reIlUzG2MCCdWWpg","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
