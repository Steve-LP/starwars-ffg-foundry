{"_id":"XdhEuhGfbRRazJjz","name":"Petty Officer Tera Wen","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Tera Wen is a stern-looking young woman from the Core Worlds with regulation-length blond hair, brown eyes, and a fair complexion. She’s been assigned to Freighter M226 for several months, and has made a name for herself as someone who can be counted on to get the job done. She is just as loyal to the Empire as the troopers who serve under her."}},"items":[{"_id":"CKdLFEizeqL67Ds7","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"ISFDvPDihTov4qBB","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
