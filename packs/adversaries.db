{"_id":"pcUv8dr7B4q5pMJv","name":"Terrify (Improved)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As an action, may make an :average: Coercion check adding {Force Rating} to the dice pool. For each :success:, one target within Medium range is Disoriented until the end of the next round. Spend :advantage::advantage: to increase the duration for all affected targets by one round; spend :forcepip: to Immobilise an affected target; spend :triumph: to Stagger an affected target."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
