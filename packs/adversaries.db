{"_id":"ADiD8C1WWYDhFEJq","name":"Racing Varactyl","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"PVOrem9VRaEXKIyk","name":"Beak","type":"weapon","system":{"damage":11,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Vicious 3"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"AE7akZ2VtrxyWhAi","name":"Arrogant Heir","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Wealthy citizens of the Core Worlds are usually blind to the privilege and arrogance that are the hallmarks of their lives. Since birth, they have been taught that they are the leaders of the galaxy-economically, politically, spiritually, and in all other ways Inevitably, there are those amongst the people who have everything who want more, and these arrogant heirs may well come into conflict or contact with the galactic underworld. The independent operators of the fringe must tread carefully around these individuals, for fear of drawing the attention of more powerful Core World interests."}},"items":[{"_id":"5IfIToAnOI1XqC2R","name":"Duelist blaster pistol","type":"weapon","system":{"damage":5,"critical":4,"range":"Short","skill":"Ranged: Light","qualities":"Accurate 2, Stun Setting"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"AELstj4WqkKIVFMB","name":"Vursonk","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The vursonk is a small scavenging creature with six strong, whip-like tentacles equally spaced around the perimeter of an egg-shaped body, Its mouth is on the underside, with flaps that allow it to expand its maw and grab objects almost as large as itself. The creature has multiple eyes on each side of its body, giving it excellent all-around vision in light, and infrared vision in the darkness. A vursonk latches onto organic matter and either eats it in place or launches itself into the air for a fast getaway, taking the food back to a safe area for storage until later. It may make several trips if there is a ready supply of potential sustenance."}},"items":[{"_id":"BLjzgEewCc7lclJL","name":"Teeth","type":"weapon","system":{"damage":9,"critical":4,"range":"Engaged","skill":"Brawl","qualities":""}},{"_id":"Z4GSeJTN7bBXm71d","name":"Tentacle whips","type":"weapon","system":{"damage":8,"critical":3,"range":"Engaged","skill":"Brawl","qualities":""}},{"_id":"iyRmgXrieTWhdPvt","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"nPbR37qvyGxn13wC","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
