{"_id":"T7OxnWL7vSXcdCsy","name":"Urel Haydon","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Urel has fought to restore the Republic for nearly two decades, from the very first days of the Empire onward, and has suffered greatly in the quest to topple Palpatine. He has given an arm, a leg, and an eye to the cause and now sports a great deal of cybernetics to replace what he has lost.\n\nDespite the hardships he has endured, Urel is a jovial and gregarious fellow who goes out of his way to help other Rebels forget their troubles for a little while. He has shoulder-length brown hair tied back in a messy ponytail, reddish stubble on his face, and a crowd-pleasing smile."}},"items":[{"_id":"KSI9qLTvVgJk3MhQ","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"ovtLAMLOnGrsf8Qv","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"v68KQfabRZCXh9vh","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"qqi17ekXyXIxIkk4","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
