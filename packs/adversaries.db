{"_id":"zggEdI7r9kXAp5sE","name":"Ysanna Hunter","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Ysanna are humanoids who wear tribal masks and ride the powerful kirruk. While farming is the Ysanna’s main source of food, hunting is becoming more useful as creatures repopulate. The Ysanna hunt with a concussion bow, which fires projectiles whose trajectories they can influence with the Force. The tribes feel a duty to protect the Jedi ruins from each other and from outsiders, though they can’t explain why."}},"items":[{"_id":"9y2ud5BgOODugdjc","name":"Concussion bow","type":"weapon","system":{"damage":8,"critical":5,"range":"Medium","skill":"Ranged: Heavy","qualities":"Cumbersome 2, limited Ammo 1, Prepare 1"}},{"_id":"wApOtT3617qJzG2d","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"bgwEJ9YzqxiuRkjd","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
