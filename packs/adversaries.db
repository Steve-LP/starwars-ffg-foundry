{"_id":"orCOdmN7CbkkL0Bc","name":"Saber Swarm","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As a maneuver, suffer 1 Strain to gain Linked {Force Rating} on the next Lightsaber (Agility) combat check."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"ovM8GksHwfI1z5YG","name":"Silhouette","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The difficulty of an attack made against a character 2 silhouettes larger than the attacker is decreased by 1. The difficulty of an attack made against a character 2 or more silhouettes smaller than the attacker is increased by 1."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"ovZJR4rvWmwEIxpu","name":"Regeneration","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When recovering from wounds via natural rest or in a bacta tank, recover 1 additional Wound; first-aid, medical treatment, and stimpacks do not result in recovery from an additional wound; Trandoshans can regrow lost limbs, though it usually takes at least a month before such limbs are usable."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"owLaSdQZYTakfv0f","name":"Spooked Ronto","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The average ronto is easily domesticated for farm work and other means. Though not brilliant by any means, rontos are receptive to training and form string attachments to those they deem their masters. Strong and loyal, they can be ideal creatures for rural settings, but they have a strong tendency to spook readily around machines and loud noises.\n\nTypically, rontos are not dangerous. However, if they are being ridden by someone who intends another harm, they can be used to cause great damage. In addition, a spooked ronto will stop at nothing to get away from whatever startled it, making it very dangerous."}},"items":[{"_id":"VMYSVzplQ5E4DCIO","name":"Legs","type":"weapon","system":{"damage":12,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Knockdown"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"oxEWvRWvnslvqrAP","name":"Defel Assassin","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Murder for hire is a thriving business in galactic society and those who need the utmost in discretion or who require the death of a particularly cautious or protected target choose to pay for a Defel assassin. The Defel are bestial in appearance, and are consummate hunters and predators. T hey are masters of infiltration, stealth, and sudden bouts of vicious but silent violence. Many choose to train in a variety of melee weapons, but just as many choose to rely upon their natural weapons, either teeth or claws."}},"items":[{"_id":"BRkPKHLm5NoPLEhx","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"VpUOeEoGVUMJF9tf","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"eLBWfEHqwEKzdyTk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"9hO4fqhEPgKK2Yyl","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
