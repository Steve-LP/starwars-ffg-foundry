{"_id":"mWtqd8ZnUxms3DSw","name":"Reappropriate","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As an action, the guard captain can make an :easy: Brawl check to disarm an engaged opponent, and may spend :triumph: to immediately wield the item or weapon."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"mY85nZMeiRbHXhug","name":"Politician / Senator","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Denizens of the Core Worlds include former members of the Imperial Senate, recently disbanded by the Emperor, who remain in the area in hopes of maintaining their political influence, wealthy lifestyle, and general connection to the goings-on of the Empire as a whole. Under normal circumstances, these individuals venture into the more rural regions of the galaxy only very rarely. Even those who represent the Outer Rim Territories can scarcely find time for such a lengthy journey. When such individuals do venture out into the galaxy at large, it is typically to serve their own needs rather than the needs of anyone else. A rare few are genuinely interested in the fate of their constituents and seek to aid the Alliance in restoring a more compassionate government, but most have benefited far too much from their association with the Empire to willingly aid in its overthrow."}},"items":[{"_id":"t1OaphFNzIQ6UoO0","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"iGSSn0yV5SWhQ5Aq","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
