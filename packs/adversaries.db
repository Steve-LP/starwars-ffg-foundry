{"_id":"s0XFc7PJsUfoCpkG","name":"Jayk, Veteran Clone Trooper","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Jayk, Rafe and Tojo are the last remaining “rank-and-file” clone troopers in the platoon. As generalists, they are the backbone of the group, providing mobile firepower while Zeke gives orders and Oake lays down a heavy field of fire. While Jayk is the smart aleck of the group and Tojo is level-headed and stable under fire, Rafe is generally dour, pessimistic, and easily aggrevated."}},"items":[{"_id":"KTJ1C7DZkNPJ6vlX","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"m0PzM81GkMiwIocd","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"pa7aXxTGdCzU7DBR","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"uolIaMRXC69BhpTT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
