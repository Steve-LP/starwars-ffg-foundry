{"_id":"2uvsaY09koFFyT4d","name":"Obi-Wan Kenobi","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The High Council regards Master Kenobi as an ideal Jedi. During the Battle of Nabon, after dispatching Darth Maul, Kenobr promised his dying master. Qui-Gon Jinn, to train young Anakin Skywalker. By the time of the Gone Wars, Kenobi’s Padawan is among the most powerfu Jedi in history, but lacks experience. Kenobi must constantly extinguish fires lit by his apprentice. Kenobi and the 212th Attack Battalion deploy to some of the toughest fronts of the conflict, winning countless battles."}},"items":[{"_id":"PMmJ6TnxxElbPOCc","name":"Obi-Wan’s Lightsaber","type":"weapon","system":{"damage":10,"critical":1,"range":"Engaged","skill":"Lightsaber (Intellect)","qualities":"Breach 1, Sunder"}},{"_id":"zeiZA4aw3Xg4MSFo","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"BXbcMgcmRtJtDygD","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"8MiRZvzvU1ZwbybA","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"JWADPsyI7WvoCWdH","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"3QcQKTnnq0QAjctc","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"leeqPKlRsBm0qVWT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
