{"_id":"V4seOLlholR8m0ax","name":"Lar’omx Clan-scorned","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"If Tray’Essek has accumulated additional Obligation, his rival, Lar’omx, finds out about the raid on the Black Sun facility and decides to zero out Tray’Essek’s jagannath point score once and for all. If the conversation with the Falleen goes poorly, or if Tray’Essek confronts Verannis about his rival, Lar’omx accompanies the human and Aqualish Black Sun operatives to “take care of” the PCs. Lar’omx has forsaken Trandoshan traditions and isn’t afraid to fight dirty in order to beat Tray’Essek."}},"items":[{"_id":"9lGGKiSdN1poPj9N","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"bjesDnyAyxlTjPiA","name":"Poisoned claws","type":"weapon","system":{"damage":5,"critical":3,"range":"Engaged","skill":"Brawl","qualities":""}},{"_id":"DHuneaLN4vR9A0tz","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
