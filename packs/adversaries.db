{"_id":"3tYCono5SAHKx4OT","name":"Force Power: Sense","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The character may spend :forcepip: to sense all living things within Short range (including animals and sentient beings) and may spend :forcepip::forcepip: to increase the range of this effect to Medium. The character may instead spend :forcepip: to sense the current emotional state of one living target they are engaged with."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
