{"_id":"d9jqsD27RND95faS","name":"Red-Eye Dren","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Dren has operated deep within Kwenn for many years now, trading titbits of information for credits and more information. His signature glowing eyes are only the most obvious of his cybernetic replacements. Through his access to a wide variety of databases, Dren has made himself invaluable to criminal elements throughout the region."}},"items":[{"_id":"cLPzZZvEgmen93RD","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"dHUHTYVvtGBGjF1R","name":"Optical flare","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged: Light","qualities":"Slow-Firing 2"}},{"_id":"SPlLSwOqaDx0hjbW","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
