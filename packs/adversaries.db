{"_id":"KikRC2w7oSVZ8KlJ","name":"Incite Rebellion","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session as an Action, make a :hard: Coercion check to cause up to {Coercion} beings to become rebellious until the end of the encounter."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
