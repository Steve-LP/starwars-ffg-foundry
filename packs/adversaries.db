{"_id":"jx2OOfjfchNMF6qQ","name":"In the Know (Improved)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session as an action, may make an opposed Deception vs Vigilance check against an NPC with the difficulty downgraded {ranks|times}. The NPC believes false information created by the character."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"jxuFR0zORsmKjEph","name":"Gand Findsman","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"While seldom seen beyond their homeworld, Gand findsmen are some of the most skilled trackers and hunters in the galaxy. Their almost supernatural ability to track targets through the ammonia mists of Gand leaves many to mutter that the findsmen have a connection to the Force. In reality, most findsmen benefit from keen senses combined with an analytical mind, not a mystical sensing ability. This lets them read their targets’ intentions in the smallest clues, from a single footprint to a broken branch."}},"items":[{"_id":"6q2l5IJkDdzcfOV4","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"V29cpYFU9ZIeBJwj","name":"Scoped blaster rifle","type":"weapon","system":{"damage":9,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Stun Setting, Sniper Shot"}},{"_id":"vYkCsqysJcxA4BJ1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"X3CNrlxUZgGloirE","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"jy212YHuFpjCksgq","name":"Hold Them Off","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per encounter, as an out-of-turn incidental, Koth may redirect any ranged attack against an ally in Short range to himself. This must be done after the attack roll but before the result is calculated."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"jyQZUNJsP4f7NBtF","name":"Inspiring Leadership","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As an action, may make an :average: Leadership check to grant up to {Presence} allies within Short range an automatic :success: on their next skill check."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"jytlwtyr3taQDYK7","name":"Lathe, Sorority Slicer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Lathe is one of the Sorority’s best slicers on Saleucami. She’s been assigned to monitor the planet’s SororiNet node, and the job couldn’t suit her better. Though rarily seen outside the confines of her apartment in Taleucema, Lather emerges from time to time to replenish her supply of Booster Blue. She is a short, slight wisp of a human woman in her early twenties, with short-cropped red hair and hazel eyes."}},"items":[{"_id":"ZNJTVWfbOpVtSCGL","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"EJVsr0jHnqavXIL7","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"k0SpcZhp4AVR7B4n","name":"Vrblther","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Vrblthers are bipedal, carnivorous predators that are distinguished by powerful clawed hands and feet, long tails, and thick leathery hides that range in color from black to dark green to brown. Originally native to Varl, vrblthers were brought to Nar Shaddaa by the Hutts during their emigration to Evocar, the planet that became Nal Hutta. Hutts still make pets of vrblthers, and feral specimens can often be found hunting in packs in the lower reaches of Nar Shaddaa."}},"items":[{"_id":"AUmlI4JfDJQK7TeU","name":"Powerful claws","type":"weapon","system":{"damage":8,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Knockdown, Sunder"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"k1ZRb763Dr0p9BIw","name":"Protest Chant","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As a maneuver, a group of 5 or more Anti-War Protesters may upgrade their next Coercion check once."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"k6ToR1th5RNOOamS","name":"DC-17m blaster (rifle mode)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"k8bItjrcRswLFzpY","name":"Slicer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The computer networks that link the galaxy’s thousands of governments together are incredibly complex and contain extremely secure, sensitive information. Slicers are individuals who specialize in bypassing all manner of computerized security in order to delicately retrieve information for others—or, sometimes, for their own amusement. Skilled slicers can be hired to discover classified information from military databases, de-encrypt files recovered from military installations, or to be involved in any number of other variations on information trafficking."}},"items":[{"_id":"mjZIgAH80P2q1nB4","name":"Stun blaster","type":"weapon","system":{"damage":6,"critical":0,"range":"Short","skill":"Ranged: Light","qualities":"Stun Damage"}},{"_id":"DCXze83idySe1xyh","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
