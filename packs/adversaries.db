{"_id":"iJU4XHOUF4ir7hNE","name":"Orbak","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Orbaks were a species of horse-like riding beasts. Found on several worlds, their exact galactic origins were unclear, although the ocean moon Kef Bir was the homeworld of a herd of orbaks. On frontier worlds, orbaks were often domesticated for use in agriculture, transport, and occasionally warfare. Their tusks were used to uproot the grasses that they ate, and their sturdy hooves were well-adapted for uncertain terrain. They were related to other riding beasts, including pulga, fathiers, bordoks, and tris."}},"items":[{"_id":"v4nNxFa5y3Hb3Pli","name":"Tusks","type":"weapon","system":{"damage":5,"critical":3,"range":"Engaged","skill":"Brawl","qualities":""}},{"_id":"0Iud0Zq7AvXr0rin","name":"Trampling Hooves","type":"weapon","system":{"damage":8,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Knockdown"}}],"effects":[],"flags":{},"ownership":{"default":0}}
