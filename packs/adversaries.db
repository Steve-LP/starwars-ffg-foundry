{"_id":"zuQx43XXK3h9NTjp","name":"Var Narek, Lt. Field Assistant","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A human male in his late twenties, Var Narek is completely average. He stands just under two meters tall, with black hair and a slight build. Narek is the kind of person to whom people on the street do not give a second thought."}},"items":[{"_id":"5GRYmkejjjpCWlAC","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"OATR1MIL5WObdmXW","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"4CVyRkLKF7cBvH3h","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
