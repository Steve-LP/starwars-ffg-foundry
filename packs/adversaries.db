{"_id":"V8AgG2cDg12CKOE8","name":"Dive-bomb","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As an action, may make an opposed Coercion check vs. Cool against one character at up to Medium range; on a success, the target is staggered for one round and the falcon moves to engaged with the target; :advantage: may be spent to cause the target to suffer 1 Strain, and :triumph: may be spent to extend the effect of the stagger by 1 round."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
