{"_id":"rOkOnYVv97ym1LyN","name":"Band Of Brothers","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session, when another Clone Commando suffers damage that exceeds their wound threshold and removes them from the fight, this commando may make a single attack against the enemy responsible as an out-of-turn incidental."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
