{"_id":"Wt1jUmOPJ934FmnT","name":"Captain Gial Ackbar (HoBS)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"L7yTlArYSnBAaEBO","name":"Mon Calamari battle baton","type":"weapon","system":{"damage":"5","critical":"4","range":"Medium","skill":"Ranged: Light","qualities":"Stun Setting"}},{"_id":"mmcDYOfmXzHEYhE2","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"WvtA7stOYlTwYqDq","name":"MI-Series Security Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Holowan Mechanicals’ imposing MI-series security droids are some of the most efficient and dangerous droids in the galaxy. A recent entry into an already crowded security droid field, Holowan made its new droids stand out by arming them to their metaphorical teeth and marketing them heavily among wealthy civilians and small planetary governments. Its plan paid off, and within a scant few years it has a nearly two-year waiting list for new MI-series models."}},"items":[{"_id":"awj4UbthEyGAN2FK","name":"Twin light repeating blasters","type":"weapon","system":{"damage":11,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Auto-Fire, Linked 1, Pierce 1"}},{"_id":"vnAcHTi2cQVf652P","name":"Twin stun blasters","type":"weapon","system":{"damage":6,"critical":0,"range":"Close","skill":"Ranged: Heavy","qualities":"Linked 1, Stun Damage"}},{"_id":"VWEIiunxpLP4XFHK","name":"Over-sized arms","type":"weapon","system":{"damage":7,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Knockdown"}},{"_id":"yaqVf1vlZwg45FPT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"X0C2gPtrCwiv1MI4","name":"Mil Mikkir, Chagrian Executive","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Although Chagrians are typically taller than humans, Mil Mikkir is small for his species, not much more than 1.7 meters in height at his crown. His prominent horns do make him appear taller, and he favors imposing suits in rich colours to help make an impression despite his size. His deep blue skin is darkest on the lethorn growths from the sides of his head, and he takes great pride in this, as he does in his appearance in general."}},"items":[{"_id":"VbIFivkjCulW0TzZ","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"Xn00F78TNFOIR6T2","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"h8rO7ReRzKspZCXo","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
