{"_id":"AGRQmQvAy97OSpP2","name":"Terentatek Mauler","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Within the darkest sanctums of ancient Sith tombs dwell the terentatek maulers. Tougher, stronger, and more deadly, the maulers stand solidary guard over the remains of powerful Sith Lords. Heavy bone plating ending in long spines cover the mauler dramatically increasing its resilience."}},"items":[{"_id":"FkgqpcoWO8dMWJKl","name":"Massive claws","type":"weapon","system":{"damage":15,"critical":3,"range":"Short","skill":"Brawl","qualities":"Ensnare, Knockdown"}},{"_id":"iUGgeVli9K89G0D0","name":"Goring tusks","type":"weapon","system":{"damage":10,"critical":2,"range":"Engaged","skill":"Brawl","qualities":"Pierce 5, Inaccurate 2"}},{"_id":"YGr9hNtwECb1Rh4r","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"AHaqeMaBtYDiNrHh","name":"Intuitive Shot","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When making a Ranged: Heavy, or Ranged: Light combat check, may add {Force Rating} to the check. May spend :forcepip: to add :success: or :advantage: to the result."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
