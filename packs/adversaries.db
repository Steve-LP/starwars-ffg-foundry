{"_id":"md8gZFzSiYodRcvb","name":"B2 Super Battle Droid (Rival)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Created by Baktoid Combat Automata to serve as front line heavy infantry, the B2 Super Battle Droid is superior to its predecessor the B1 in all respects. Boasting reinforced armour, integrated anti-personnel weaponry, and programming capable of operation without a command signal, this hulking battle droid is a formidable foe on or off the battlefield. Before the introduction of the IG-100 MagnaGuard, B2s were seen serving as bodyguards to Separatist leaders such as Count Dooku. With the end of the Clone Wars, B2s are a rare sight. Some scavenged models serve crime lords or private militias; others have been re-purposed for use in gladiator arenas. Some abandoned B2s were never shut down, and still carry out their last orders, defending forgotten Separatist ships and installations awaiting unsuspected salvagers."}},"items":[{"_id":"365hJOPlreMve7uI","name":"Integrated wrist blaster","type":"weapon","system":{"damage":9,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":"Cumbersome 3, Auto-Fire"}},{"_id":"WgrAG7iI8Bt0oob0","name":"Rocket launcher arm","type":"weapon","system":{"damage":12,"critical":3,"range":"Medium","skill":"Gunnery","qualities":"Blast 8, Limited Ammo 4"}},{"_id":"BAifVHZpblDiHDwp","name":"Mechanical slam","type":"weapon","system":{"damage":6,"critical":5,"range":"Engaged","skill":"Brawl","qualities":"Knockdown"}},{"_id":"ORMgUNFfZgIbwJZr","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"meBofbZfza7Z5WvD","name":"Toydarian Farmer","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Most Toydarians make their living as subsistence farmers, growing or gathering swamp crops, paying their tithes to the king, and generally trying their best to avoid unwanted attention from the authorities, whether they be local, Hutt, or Imperial. The marshes of their homeworld can be extremely dangerous, but the farmers know them better than anyone else. Thanks to the harsh rule of King Maalva, they are often wary of outsiders, but can be convinced to help wanderers who make a favorable impression."}},"items":[{"_id":"RdwqbqOlVFrLXqDf","name":"Farming implement","type":"weapon","system":{"damage":3,"critical":6,"range":"Engaged","skill":"Melee","qualities":"Disorient 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
