{"_id":"5p1hEpJe3Jxk8m4J","name":"First Order Stormtrooper","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The foot soldiers of the First Order are raised as warriors from birth. Unlike that of the Galactic Empire, the training regimen of the First Order emphasises guerilla warfare, improvisation, and unquestioning loyalty."}},"items":[{"_id":"68oWQFkabN2ffQ0o","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"Y0Xa9A0OFJByIF9B","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"0IfA2hplmn4BQTr9","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
