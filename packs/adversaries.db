{"_id":"AB5X7doaZX2H0bol","name":"Flame Ibbot","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"One of the more common of the ibbot species, the flame ibbot is a mild-tempered, medium-sized raptor that makes its home on the shore of the Boiling Sea. They stand a little over a metre high and have a wingspan of roughly two and a half metres. Their plumage is primarily copper or brass coloured with crimson, orange, and white highlights. Occasionally, a flame ibbot develops primarily iridescent, blue-black plumage with coppery or crimson highlights, and these rare creatures are highly sought as pets. The flame ibbot’s diet consists of both small fish and insects native to the Boiling Sea, as well as the kettleweed that grows there. In fact, it is more from their habit of eating kettleweed, and not their colouration, that gives the flame ibbot its name. When threatened, flame ibbots spit a powerful jet of caustic bile and steaming hot water that builds up in their stomachs as they digest kettleweed. This viscous liquid causes extreme discomfort, disorientation and temporary blindness."}},"items":[{"_id":"WhbRqq4E21hQSnb7","name":"Sharp beak and slashing talons","type":"weapon","system":{"damage":3,"critical":5,"range":"Engaged","skill":"Brawl","qualities":"Pierce 1"}},{"_id":"KUwPiGTTCfeJELTM","name":"Scalding bile","type":"weapon","system":{"damage":2,"critical":5,"range":"Engaged","skill":"Brawl","qualities":"Burn 2, Disorient 3, Slow-Firing 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"ACpIDAlOsU4t4Avq","name":"Aura of Command","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Spend a maneuver to allow one allied minion group at Medium range to immediately perform one maneuver or action. Add :boost: to any actions they perform."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
