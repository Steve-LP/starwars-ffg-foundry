{"_id":"nWvFdVPOtOc9rTJE","name":"Saboteur Astromech","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"R2- and R3-series astromech droids with upgraded piloting and gunnery protocols. These droids are capable of slicing computer terminals and repairing damaged machinery. They have an arc welder that they can use as a weapon, though astromech droids flee combat if their protocol escorts are destroyed."}},"items":[{"_id":"j5lM1IFA6LMnX2dU","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
