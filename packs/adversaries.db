{"_id":"pC4j8C9RCqTHJvU9","name":"Rebel Specforce Infiltrator","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The special forces branch of the Alliance military is simply known as the SpecForce, and its troops are seen as the most dangerous and capable of all Rebel soldiers.\n\nAmong members of SpecForce itself, the infiltrators are considered to be the most deadly. Extensively trained in stealth and assassination, these infiltrators specialize in gaining entry to hardened installations and effecting horrific damage before the enemy ever becomes aware of their presence. Infiltrators are often used to “soften” targets prior to a direct assault, and are also used to eliminate particularly important targets or retrieve especially important and well-guarded data. Because of the nature of their duties, infiltrators often choose to specialize in melee weaponry rather than louder and more easily detected blasters."}},"items":[{"_id":"REGbdEfpR6suc2Gn","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"Gqe8mjzWu5N5CeIH","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"PkukaXt0ZKTQzmUC","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"WjhHWVqxKNAK84Jk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"pCHcEeSMZ52CTemE","name":"Decoy","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session, the Naboo Queen may spend a Destiny Point to reveal that she is in fact a Naboo Royal Handmaiden, who has swapped places with the real monarch."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"pCYDdxxYO0H4L421","name":"Captain Balrekk","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Captain Narell Balrekk is a ruthless leader who commands Talon Company within the 84th Stormtrooper Legion. He has made a name for himself by interrogating Rebel prisoners through torture and other unsanctioned means. Balrekk is perfectly at home in the Empire, finding its cruel and sadistic ways to his liking."}},"items":[{"_id":"RoeTMTcHxAXnkzGe","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"ZAnciDDo79uOpGJH","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"RqHKPqAfLwHOSFbp","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
