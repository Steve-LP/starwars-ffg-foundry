{"_id":"rps12WEj54BxgUaY","name":"Zygerrian Royal Guard","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Zygernanc; who serve within the royal guard are the elite soldiers or the Zygerrian Slave Empire. Their duties are to protect the royal family and their holdings. and to help ensure that slavery within the Empire thrives. These brutes patrol the streets of Sclavos, enforcing the Molec family’s rule and defending it from equally malicious rival slavers. Zygerrian royal guards are trained to corner, subdue, and capture their adversaries so they may be sod into slavery, but they do not hesitate to resort to lethal methods if necessary."}},"items":[{"_id":"5uUAIdBoNbnHZUSX","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"4LSOzCWKJ3mchaCZ","name":"Shock whip","type":"weapon","system":{"damage":4,"critical":4,"range":"Short","skill":"Melee","qualities":"Ensnare 3, Stun Damage"}},{"_id":"gIbYM1cN7y1Dc7yz","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
