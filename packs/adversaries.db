{"_id":"bGjoA8HV4LJJc9fI","name":"Tera Sinube","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"Rng2JrsyHbbff1Uc","name":"Sinube’s Lightsaber","type":"weapon","system":{"damage":"9","critical":"2","range":"Engaged","skill":"Lightsaber (Cunning)","qualities":"Breach 1, Sunder"}},{"_id":"HVC9tYS7Y1sXplCN","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"5FmXt0DGseQAvlr7","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"zkMYyJ0TJ6hVFGYF","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Eyo0rBIPBSsiU3re","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"9EGs8D4DK3BwxDji","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"SFmPV3QckC9sbZrc","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"8pWhEXDTRzTix03Z","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"bHDfLIWnA4n4oSJB","name":"Teryx","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Teryx are small, feathered species of reptavian found in abundance all throughout the Cloudland Peaks. Tiny and exceedingly nimble, these fist-sized creatures have long, sharp, needle-like beaks and lovely, multi-coloured plumage that shimmers in the sunlight as they dart among the small alpine meadows where they make their nests. They feed on insects and the bodily fluids of small rodents, stabbing their prey with their beaks, injecting the target with a numbing venom, and drinking its blood. While individually they are not particularly dangerous, their habit of swarming around any creature and draining them completely of blood is one of the many well-documented dangers of exploring the Cloudland Peaks."}},"items":[{"_id":"KlYSoiAos2yd89vr","name":"Beak","type":"weapon","system":{"damage":2,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Disorient 2, Pierce 3, Stun 3"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"bJKLQ8dxl1KYdUpo","name":"Stormtrooper: Range Trooper (d20radio)","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Enforcers of the Emperor’s will on far flung frontier worlds, it is the range troopers of the Stormtrooper Corps that carve order from chaos on the ever expanding fringes of the Empire. Range troopers secure and patrol vast territories on uncivilized, icy worlds selected for imperial development. Although not special operations forces, range troopers screen candidates for mental toughness and physical resilience above the norm. These traits breed a strong collective identity and feeling of eliteness above regular stormtroopers.\n\nEquipped similarly to the cold assault stormtrooper, known to most as snowtroopers, range trooper armour integrates arctic survival gear and provides freedom of movement for long patrol routes. Unlike the offensively oriented snowtroopers, range troopers are equipped to conduct security patrols and sentry duties. Range troopers utilize a variety of overboot systems to enhance mobility, from simple skis and snowshoes to climbing cleats and magnetic boots. This ensures Imperial assets can be protected, whether over vast swaths of snow or on high-speed conveyex transports.\n\nRange troopers operate in small units on detached service, often with little contact or oversight by higher command. This isolation from the rest of the imperial military, and indeed galactic civilization, fosters a frontier spirit of cold determination. Range troopers strive to accomplish any mission assigned, but they do so their own way and prefer not to cooperate with other units they deem less capable."}},"items":[{"_id":"DKelp9sRGZZO5oSA","name":"E-10R blaster rifle","type":"weapon","system":{"damage":9,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Stun Setting, Accurate 1, Cumbersome 2, Multi-optic Sight"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"bOcJL5f1S6CC3Kpq","name":"Snowfeather","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Snowfeathers are small, clever, flightless birds native to Ilum. Their bodies are covered in a dense layer of oily, white feathers that protects them from Ilum’s bone-chilling cold and vicious weather. Relatively harmless creatures, they live in nesting colonies built into ice shelves or cliff faces.\n\nDespite their inoffensive nature and inability to fly, snowfeathers have few natural predators, for two reasons. First, their meat tastes terrible and is mildly poisonous, causing painful cramps, bloating, and loosening of the bowels in those unfortunate enough to eat them. Second, they have a connection to the Force that gives them the ability to project an illusion that makes them seem larger and more formidable than they really are. These characteristics have allowed them to survive and even thrive on an inhospitable planet full of savage creatures like gorgodons and asharl panthers."}},"items":[{"_id":"3mTc4CTqd3Ms9PMH","name":"Beak","type":"weapon","system":{"damage":3,"critical":5,"range":"Engaged","skill":"Brawl","qualities":"Pierce 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
