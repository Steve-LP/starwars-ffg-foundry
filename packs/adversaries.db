{"_id":"6C6L4U4wvYwqclTE","name":"Force Power: Harm","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"May make a Harm Force power check against one engaged target. Spend :forcepip: to inflict {Intellect} Wounds on the target, ignoring Soak. Spend :forcepip: to increase wounds inflicted by {Intellect} (may activate this multiple times), and spend :forcepip: to heal Wounds equal to Wounds inflicted."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
