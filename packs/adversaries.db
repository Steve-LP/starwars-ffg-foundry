{"_id":"M26f5vbenMe7dLDV","name":"Klatooinian Elder","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Council of Elders controls all internal affairs on Klatooine. Each elder serves for life and is selected based on age and experience, as well on performance in a series of debates intended to test the elder’s knowledge of Klatooinian myths and cultural traditions. The Council of Elders also the guards Klatooine’s holy sites, including the Fountain of Ancients, and its members are thus literate in the language of the Klatooinians."}},"items":[{"_id":"TxtRADluaYNdtiUd","name":"Ceremonial shamshir","type":"weapon","system":{"damage":0,"critical":3,"range":"Engaged","skill":"Melee","qualities":"Pierce 1, Vicious 1"}},{"_id":"bZxv6aK71yANAk5W","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"q3m5xFkw25Zk4smk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"3xzip3l4N8x62aXn","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"LYw2gTVr9sy2fzpM","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
