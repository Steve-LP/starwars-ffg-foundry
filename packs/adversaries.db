{"_id":"OGyOle937Wm6llSL","name":"Luminara Unduli","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"Wx6TRjd8wm4VkNNZ","name":"Luminara’s Lightsaber","type":"weapon","system":{"damage":"9","critical":"2","range":"Engaged","skill":"Lightsaber (Intellect)","qualities":"Breach 1, Sunder, Vicious 1"}},{"_id":"icOzzNMw7Hc2r16O","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"n7xdKy53wTlOnxNp","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"zf7KD1iyUM9BVPWI","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Zr8TTC0f6sIGMCWp","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"PO9DyiRhVwh7vu7Z","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"KQoWBCmN2PNqWi1C","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"TiyVDHVoAitbeFsi","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"OHg1cfIwSNprNMGV","name":"Imperial Valour","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"May perform a maneuver to cause all ranged attacks targeting the character to instead hit one ally or helpless enemy in Engaged range, until the beginning of the character’s next turn."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"OHyoyL1lWlKcbXBV","name":"Imperial Intelligence Watcher","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The exploits of Imperial Intelligence in the fields of assassination, deception, and manipulation were infamous, but were only possible through the sheer analytical horsepower of its Watchers. Analysts and handlers, Watchers provided direction and information to agents in the field. While Watchers worked closely with fixers and cipher agents, they were supervised directly by Keeper, the operational head of Imperial Intelligence. A team of operatives, or a single Cipher Agent, would often be assigned alongside a Watcher subject matter expert as a task group. While field operatives conducting covert operations, the Watcher would provide intelligence and direct future operations on behalf of Keeper.\n\nIntelligence’s most recent cohort of Watchers benefited from enhanced cognitive abilities, the result of the Empire’s experimental eugenics program. These natural abilities were enhanced with a punishing regimen of academics and mental conditioning, creating a class of analyst that was also a biological CPU on par with conventional information processing droids. The loyalty of these enhanced Watchers was ensured by deeply implanted post-hypnotic suggestion, essentially encoding a psychological kill switch linked to a specific audiovisual stimuli capable of rendering a watcher unconscious or even comatose. The existence, let alone the nature, of this stimuli was a closely guarded secret, as that information could be used to debilitating effect on Imperial Intelligence."}},"items":[{"_id":"kjqVASLpLgJfGKLe","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"IPr7kMukp5zeRxo8","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"tCPsoyubA2Y6LcOl","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"5oe6gFrd7gcZFyRw","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"11rtmvGcj95hQeSk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"sWgiUYtiOcUrEZxa","name":"Thorough Assessment","type":"talent","system":{"description":"Once per session, take a :hard: Knowledge check to add :boost: equal to the number of :success: that can be distributed during the encounter.","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"OJuOPiplWy9nwbfR","name":"Eeth Koth","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"o347BtJFRFOZN50B","name":"Eeth Koth’s Lightsaber","type":"weapon","system":{"damage":"8","critical":"2","range":"Engaged","skill":"Lightsaber","qualities":"Breach 1, Defensive 1, Sunder"}},{"_id":"OEcanH3b7N7HFrrq","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"UblkDr62MHvi4BCW","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"VCGryHupyRnGYYfS","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Lc1tvbW8ZLz25Yh7","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"FmTAtCCeuncziMWc","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"gcMveHxLEBbxy2dy","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"OMWM3fqclMmCLurc","name":"Venlana Sipal, Consortium Underboss","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Venlana Sipal is a Saleucamian native descended from the original Pantoran colonists. She wears a mask of polite professionalism at all times, but her true nature is much more sinister. Ambitions and merciless, she does anything to ensure her own advancement. Her skin is blue and her hair a dark shade of blue-black. She generally dresses in conservative suits."}},"items":[{"_id":"nvSGbb6AhjeKOHY0","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"7ljKMvJN7DWYTpMl","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"IFo4HIBirQhu18SB","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"rWCpkPDyPexawnwZ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
