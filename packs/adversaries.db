{"_id":"NOO6hdSv9yapoDnO","name":"Planetary Defence Trooper","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"There are very few planets that rely entirely on an outside agency for their protection. Most possess at least a marginal military force of their own, dedicated to protecting the planet’s most valuable or sacred sites. Planetary defense troopers rarely have the most advanced or most up-to-date equipment, often employing locally produced weaponry and armour, but what they do have is typically well made and serves its purpose."}},"items":[{"_id":"KYWadzxVyT21YbFI","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"LD1q4oopo4PivnL3","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
