{"_id":"NREfYCx18aJDEzmT","name":"Toydarian Royal Guard","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"King Katuunko’s assassination brought superstition and fear into the Toydarian royal court. Fearing reprisals after the Declaration of the New Order, the royal guard formed an elite brigade tasked with uncovering and eliminating Force users. The king’s royal guards wield specialized weaponry such as cortosis-lined scimitars and train their wills to resist the mystical influence that Force-sensitives wield. Of course, like most galactic citizens, they have a limited actual understand ing of Force users and the powers they manifest."}},"items":[{"_id":"M2IuGCRShFTEJJRL","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"lF5TxL8vlAzzvQjV","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"q8Jc6vVMbbL97mYZ","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"KXkkC08W16kFhEpV","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
