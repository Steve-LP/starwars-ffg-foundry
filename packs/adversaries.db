{"_id":"2KDkiMNVHhY1592s","name":"Blackback","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Blackbacks, birds of prey with a wingspans over five meters, feed on squalls and other small rodents. Prized trophy birds, these majestic creatures were almost hunted to extinction centuries ago. Overhunting led to rampant growth in the squall populations, which had negative impacts on Chandrilan crops. Blackbacks are now protected by the Chandrilan government and given vast conservation habitats, including the Hanna Wild Game Preserve. Hunting permits for blackbacks are upwards of 200,000 credits per kill, which is then put back into blackback breeding programs."}},"items":[{"_id":"ROv5BXaeBhRNK4p8","name":"Talons","type":"weapon","system":{"damage":6,"critical":2,"range":"Medium","skill":"Brawl","qualities":"Ensnare 3"}},{"_id":"uz0RkFnnZ6h6M4WK","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2M0oqL9bXDbfDHus","name":"Impenetrable Armour","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Zillo Beast’s hide has the Cortosis quality and all non-Stun damage taken after soak is halved, rounded down."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2P21Lm6QRKXvXz0Y","name":"Preemptive Avoidance","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Immediately after an opponent moves to engage the character, may spend a Destiny point to disengage from that opponent as an out of turn incidental."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2PJj9WkJLoNxePdE","name":"Blaster Drone","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"This small, robotic drone is designed to fire weak blaster shots as part of a training programme. It hovers approximately 1.5 metres from the ground, and can be set to fire shots at regular or irregular intervals."}},"items":[{"_id":"db7aXENy2zNz7CJG","name":"Training blaster","type":"weapon","system":{"damage":2,"critical":0,"range":"Short","skill":"Ranged: Light","qualities":"Stun Damage"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2S1qAMFmrhEHflBK","name":"Medtech Mini-Med","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Mini-Med is less a droid and more of a skilled set of surgeon’s tools. Designed specifically to aid sapient doctors, the Mini-Med is a small, spherical droid with five spindly legs that can double as manipulators. It cannot perform any sort of operations on its own, but when working under the direction of a talented doctor, a team of Mini-Meds can greatly enhance his abilities. However, their almost spider-like appearance has guaranteed they’ve not caught on in galactic society. Even pragmatic doctors tend to use them only when the patient is anaesthetised."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2SsdAE9c01LkjRd5","name":"Forager","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Remove up to :setback::setback: from skill checks to find food, water, or shelter; Suvival checks take half the time."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
