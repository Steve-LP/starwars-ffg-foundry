{"_id":"muXzDyvvj9YxXig2","name":"Duracrete Slug","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Named for the material that comprises the bulk of their diet, the invasive duracrete slugs are particularly dangerous to buildings, as they eat away at the foundations. Their tunnels are a common sight in the underworld, where slugs may grow up to 10 meters long."}},"items":[{"_id":"SCjn5YVqWOuhrFXd","name":"Bite","type":"weapon","system":{"damage":3,"critical":4,"range":"Engaged","skill":"Brawl","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
