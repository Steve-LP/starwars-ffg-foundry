{"_id":"91uLHI8nzCpnOnU6","name":"Distracting Behaviour (Improved)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As a maneuver, may suffer up to {Cunning} Strain to make an equal number of adversaries at Engaged range suffer :threat::threat: on their next skill check. Ranks increase range band."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"93audiCPygjdZBcc","name":"M226 Crew Chief","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The typical naval crew chief is a seasoned veteran who has been serving aboard Imperial ships for many years. Crew chiefs are the most technically proficient in their areas of expertise and are often looked up to by their subordinates. Like other crew, they wear grey Navy jumpsuits, but their rank is easily distinguished by the insignia on their lapel."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
