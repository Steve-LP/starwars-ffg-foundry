{"_id":"ELClE0IR9pCQqp3A","name":"Anakin Skywalker","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"o7bZwG7fUSMEndAG","name":"Anakin’s lightsaber","type":"weapon","system":{"damage":10,"critical":1,"range":"Engaged","skill":"Lightsaber","qualities":"Breach 1, Sunder, Vicious 2"}},{"_id":"wv3KvOx2BeiVwk2C","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"cfX7LfAEdDTVydfz","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"urNqsjeZ4goHBiel","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Ia9TGLIph75iZoZB","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"EMsFlMJA8FLXFg2W","name":"Sprantal","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Sprantal are massive amphibians with thick hides, long legs, and longer necks. They are typically a deep mottled-green colour that helps camouflage them, particularly underwater. Their flat heads have three spherical eyes on top in a triangular arrangement, giving them a 360-degree view. When they hide underwater, their heads are just under the surface, allowing the dark-coloured eyes to remain above the water to watch for potential prey and enemies. Sprantal have an additional, forward-facing eye below their wide, toothy mouth that allows them to see underwater as well as giving them a better view when attacking prey. Their stout bodies are approximately three to four metres long and half again as wide. Their necks can extend in a highly flexible manner, allowing sprantals when standing at full height to attack creatures everywhere except directly to the rear."}},"items":[{"_id":"OTO5t6bke9BdF26J","name":"Teeth","type":"weapon","system":{"damage":8,"critical":4,"range":"Engaged","skill":"Brawl","qualities":""}},{"_id":"hP0Efl4dmE6yQOcQ","name":"Sprantal Spit","type":"weapon","system":{"damage":6,"critical":5,"range":"Medium","skill":"Ranged: Heavy","qualities":"Blast 6, Ensnare, Knockdown, Limited Ammo 5, Sunder"}},{"_id":"cUWMtrlUhSGDePbI","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"ERvTAPizzCi1DCdK","name":"Master Bounty Hunter","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Master hunters have reached a level of independence that permits them to choose any hunts they desire. The guilds never give master hunters orders, only requests. Master hunters typically have a ship at their disposal and can pursue their prey across the entire galaxy as needed. Master hunters occasionally have journeymen assigned to them as staff, although they often work alone. They are also authorized to deploy apprentice hunters as necessary to complete a hunt."}},"items":[{"_id":"4lFVjWWPTtBUT2I8","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"jh77oSZ6xY4mSTIH","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"sjJq41OXpxXVrDMM","name":"Modded heavy blaster rifle","type":"weapon","system":{"damage":13,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Auto-Fire, Cumbersome 3, Pierce 1"}},{"_id":"UZwiCOU88CbPtBg8","name":"Under-barrel flame-thrower","type":"weapon","system":{"damage":13,"critical":2,"range":"Short","skill":"Ranged: Heavy","qualities":"Burn 5, Blast 8"}},{"_id":"z6Rb3buysW24moRy","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"rY2L7JEKdlVGm2TT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"d7YuAq4OUfuq5ofm","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"M5AMj02oUeeOU7Ku","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"EUnemQ61DAvlu1mm","name":"Clumsy","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Jar Jar adds :setback::setback: to any checks he makes or assists with."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"EXybpq2XxlDUYIXR","name":"Sorority Palace Guard","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The pirates who act as guards inside the Queen’s palace are experienced troops of a variety of species and genders. They don’t wear specific uniforms, though most of them wear heavy clothing. The guards take their jobs seriously, but are pirates at heart—many of them are bored and hope they can go back to doing what they enjoy most: namely, taking prizes in space. This makes them complacent and sloppy."}},"items":[{"_id":"uZP4uYKhSHQJFJuu","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"3wUACf1x82vhg64B","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"EYLYTGEeuTwLcLxm","name":"Aiwha","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Thought to be native to the waters of Naboo, aiwhas are also found on Kamino, and have been imported to other oceanic worlds. As water-based mounts, aiwhas have unique physiological adaptations that allow these air-breathing cetaceans to take flight for brief distances in the open air. While not truly domesticated creatures, they are friendly and are often trained as mounts amongst amphibious species."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
