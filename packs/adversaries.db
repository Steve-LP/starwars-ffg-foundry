{"_id":"LZOn63QDvshRCNxP","name":"Tholme","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"rRjHXpNqoNBopRrL","name":"Tholme’s Lightsaber","type":"weapon","system":{"damage":"8","critical":"1","range":"Engaged","skill":"Lightsaber (Cunning)","qualities":"Breach 1, Sunder"}},{"_id":"ngHROSM4a7zcalYh","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"rOQuNjyWxhcL88Ct","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"HBwJrbON1fNipsye","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"AII9Jz1ldYN3GSMl","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"7upTQ4EOfIFiUnFN","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"5AeLJjRa4RvIeiEl","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"LafPb9fQ3JTl1FaZ","name":"Trandoshan Slaver (Custom)","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Trandoshans are infamous throughout the galaxy for their brutal slavers. While some slavers use deception or guile in capturing their slaves, Trandoshans prefer to use shock tactics to overwhelm any opposition and seize their prizes. Equipped with short range weapons, Trandoshan slavers use stealth to get as close as possible to their foes before launching a fierce assault of accelerated charged particles, blades, and electronets. While preferring stealth, these slavers are no cowards; they will fight tooth and claw to take and hold their targets. Since these slavers are armed to the teeth, they often find work between hunts as mercenaries and pirates in the Outer Rim."}},"items":[{"_id":"darVUS4swm1S127V","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"5UG7n6QFz2cO7JOk","name":"Trandoshan ACP array shotgun","type":"weapon","system":{"damage":6,"critical":2,"range":"Short","skill":"Ranged: Heavy","qualities":"Blast 5, Vicious 1"}},{"_id":"LMVppuZ8sNEWM1q3","name":"Trandoshan ACP repeater gun","type":"weapon","system":{"damage":7,"critical":3,"range":"Medium","skill":"Ranged: Heavy","qualities":"Auto-Fire"}},{"_id":"eb4cOi52AHwjdkp5","name":"Two vibroblades","type":"weapon","system":{"damage":5,"critical":2,"range":"Engaged","skill":"Melee","qualities":"Pierce 2, Vicious 2"}},{"_id":"MpisOrRrP2xxYbNW","name":"Electronet","type":"weapon","system":{"damage":6,"critical":6,"range":"Engaged","skill":"Melee","qualities":"Ensnare 5, Knockdown, Limited Ammo 1, Stun Setting"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"LcPiJ3MAnXXB9vpp","name":"Dream Shimmer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The dream shimmer is a large, winged insect with a thorax and abdomen similar in size to a small rodent. Its name comes from the sparkling glow of its wings, which seem to shimmer in any light. The dream shimmer’s sole means of defence is a stinger containing hallucinogenic venom. This evolutionary adaptation gives the shimmer enough time to flee from danger or to continue to deliver repeated stun attacks with its stinger."}},"items":[{"_id":"BcvL2JbonwTXP4u3","name":"Stinger","type":"weapon","system":{"damage":6,"critical":4,"range":"Engaged","skill":"Melee","qualities":"Pierce 2, Stun Damage"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Le2W1fsfTiHbo74N","name":"Careful Planning","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session, may introduce a “fact” into the narrative as if a Destiny Point had been spent."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"LeKfBgNCD3OyeaTJ","name":"Lesser Bogwing","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Lesser bogwings are a constant sight throughout the swamps and jungles of Dagobah. They rarely venture into the canopy, where they become the prey of much larger flying creatures; instead, they feast on rodents, lizards, and other inhabitants of the swamps. Lesser bogwings are winged reptavians with four spindly legs and leathery, cold skin. They’re usually dark brown in color, although their cousins the greater bogwings, which have adapted to life above the canopy, are a bluish green. Lesser bogwings are harmless individually, but a flock of them could quickly become a nuisance."}},"items":[{"_id":"NmWZGyPsKEoCUJQT","name":"Claws","type":"weapon","system":{"damage":3,"critical":6,"range":"Engaged","skill":"Brawl","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
