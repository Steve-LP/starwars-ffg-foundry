{"_id":"I2uvw9J14uZXcePU","name":"Ugnaught Mechanic","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Indefatigable workers, Ugnaughts have been taken to the ends of the galaxy by slavers who exploit their work ethic. Even enslaved, the Ugnaughts have not forgotten the customs of their society, relying on a rich oral tradition to keep their heritage alive."}},"items":[{"_id":"S21enppTc7Yeb47J","name":"Giant hydrospanner","type":"weapon","system":{"damage":3,"critical":4,"range":"Engaged","skill":"Melee","qualities":"Knockdown"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"I3zAuIXgGFTn7kmO","name":"Loyalty","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Upgrade the difficulty of social checks targeting the Vodran enforcer once if they conflict with the Vodran enforcer’s loyalty or interfere with his duty to his Hutt masters."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"I4rYMRfIYXgKkfWa","name":"Tusken Raider","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"nyPv095bOb01EwDr","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"pclCXYynfAgziudU","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"I5zABYUm1DiZ04dN","name":"Cadet Jai Kell","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As a student at the Academy for Young Imperials, Jai Kell met with early success in its many trials. This was due partly to his devotion to the Imperial cause, but also to his natural Force sensitivity, which he did not recognise at the time. During the training, Jai became disenchanted with the Galactic Empire after discussions with fellow students Dev Morgan (actually Ezra Bridger, who was operating undercover at the academy) and Zare Leonis. Jai eventually left the academy and went into hiding with his mother to escape the Inquisitorius."}},"items":[{"_id":"2KSc8q60Pyypqtap","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"I79bX46wCg7Svbjx","name":"Spaceport Security Detail","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Individuals who serve as part of a spaceport security detail possess the same authority as planetary law enforcement, although they have only a portion of the training and are limited solely to the grounds of the spaceport itself. Because of the much more limited mandate compared to most enforcement agencies, many spaceport security details have more narrowly focused, but higher quality, equipment."}},"items":[{"_id":"FJO00H4O7OOkJz8g","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"iS0ovk3kRo1mzOMT","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
