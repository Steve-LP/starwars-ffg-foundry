{"_id":"9EJSXnuCbHifk9KU","name":"Ambrae Environmental Security Guard","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The guards hired to keep Ambrae’s Environmental’s assets secure aren’t the best in the district, let alone the business. They have families, and they just want to do their job and go home after their shift is over. They don’t take excessive risks and would prefer to call for backup rather than play the hero. That said, they do their job to the best of their ability, but if confronted by a superior force, they gladly lay down their weapons or retreat."}},"items":[{"_id":"F1FDfrJYlphLF3cP","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"CxgGWRTqbjuQ3Ls8","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
