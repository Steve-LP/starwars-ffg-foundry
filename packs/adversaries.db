{"_id":"qNSSPuwSwc5SHoiQ","name":"Blood Eagle","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Many creatures inhabit the Thyferran rainforests, but few are as formidable and terrifying as the gigantic blood eagle. Blood eagles are massive birds with waxy red feathers, long curved beaks, and oversized talons capable of grasping a mature Vratix. In flight, these creatures have a wingspan over four meters wide, and they scan the treetops and alazhi fields in search of their next meal. Once a blood eagle spots its prey, it swoops down to snatch it up, thrashing armoured targets against rocks with its blood-red beak. While Vratix take many precautions, blood eagle attacks during alazhi harvests still occur, with lethal results."}},"items":[{"_id":"QTdMUHyN0unRw9ut","name":"Razor talons","type":"weapon","system":{"damage":7,"critical":2,"range":"Engaged","skill":"Brawl","qualities":"Ensnare 3, Pierce 2, Vicious 2"}},{"_id":"TREWtjbXLqN7V7cN","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"qSOe0lken7Z7Fsps","name":"Queen Miraj Scintel","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"5fTIH1J4Fi1PKtgX","name":"Shock whip","type":"weapon","system":{"damage":"4","critical":"4","range":"Engaged","skill":"Melee","qualities":"Ensnare 3, Stun Damage"}},{"_id":"4uYZ5AdRDOhL64MN","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"p9Sf0ftiYOAEsGzP","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"vqlGtjDQbCDIKSDm","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
