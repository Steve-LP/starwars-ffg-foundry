{"_id":"LU3LNMv8nIpZpOdO","name":"Jar Jar Binks","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"Lhe5uJdMgiRU1sZH","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"K1Kj6eyXOdHN3nFD","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"wS4G5Pk6gqJFDOz3","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"LU7o9RKxFyJw5qCD","name":"Horse (Equinoid)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"“Horse” is the generic term in Basic for a wide array of single-hoofed quadruped species found throughout the galaxy. While more properly described as equinoids, they share a common physiology in size, speed, and the ease with which they can be trained as swift mounts. Many varieties of equinoids are found throughout the galaxy, as they have been traded as livestock for generations. Some are larger, more suited as draft horses and excellent at pulling large loads, while others are smaller and can be very stubborn. Such beasts are frequently used as pack animals, rather than riding mounts. The following profile is for a standard equinoid riding mount."}},"items":[{"_id":"Er7drEk3OD6Y8GbX","name":"Trampling hooves","type":"weapon","system":{"damage":8,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Knockdown"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"LWUxPLJigAcvscCv","name":"Improved Parry","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When struck by a melee attack but before applying Soak, suffer 3 Strain to reduce damage by {ranks|plus-2}. When parrying a hit that generated :despair: or :threat::threat::threat:, may hit attacker once with a wielded Brawl, Melee, or Lightsaber weapon dealing base damage, after the original attack is resolved."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"LYSMUPU5dJVjHfCG","name":"Vynock","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The vynock is a genetic cousin of the mynock. Known for eating raw and refined metal with equal relish, vynocks are found on terrestrial worlds throughout the galaxy. Their mouths secrete a powerful acid that renders even the hardest metals digestible. Like mynocks, vynocks have worm-like bodies with round, toothy maws, and clawed, leathery wings."}},"items":[{"_id":"b8IgSlzIS3PXlp65","name":"Sucker mouth","type":"weapon","system":{"damage":3,"critical":6,"range":"Engaged","skill":"Brawl","qualities":"Burn 4"}},{"_id":"y4CivOTpMBP4TTs6","name":"Claws","type":"weapon","system":{"damage":4,"critical":5,"range":"Engaged","skill":"Brawl","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
