{"_id":"4y039iLEgo5aFwvv","name":"Photon Spider","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Measuring three meters in diameter, the photon spider lives deep within the underground of Varl. It requires no atmosphere, as the crystalline life form does not breathe, and it survives on the veins of aurodium that run through the planet. Thus, anyone engaged in mining this valuable mineral is likely to see one of these creatures sooner or later—and the truly unfortunate might get a closer look."}},"items":[{"_id":"kUA1I9jXpgL8vVfh","name":"Bladed legs","type":"weapon","system":{"damage":6,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Vicious 2"}}],"effects":[],"flags":{},"ownership":{"default":0}}
