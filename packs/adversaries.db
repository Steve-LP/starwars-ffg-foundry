{"_id":"rymGnP64AJZpuxHO","name":"Dalgo","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The imposing dalgo is a riding beast native to Onderon and has a long history as both a beast of burden and a powerful mount. Though they resemble other equinoids, the herbivorous dalgos are larger and heavier, sporting short defensive tusks from their large mouths. While they make effective mounts, dalgos are often stubborn, and can spook if their riders are inexperienced or careless."}},"items":[{"_id":"USt6SygO5xCokwaR","name":"Trampling Hooves","type":"weapon","system":{"damage":7,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Knockdown"}}],"effects":[],"flags":{},"ownership":{"default":0}}
