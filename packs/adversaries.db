{"_id":"ik7oxGFICtTFFKMY","name":"COMPNOR Agent","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Committee for the Preservation of the New Order is a name used to describe multiple branches of the Imperial bureaucracy, all of which are completely devoted to maintaining support for the Emperor’s rule. The precursor agency, COMPOR, was established as a grassroots political movement during the Clone Wars era, and was a powerful tool for maintaining support for the Supreme Chancellor. After the establishment of the Empire, the organization was reorganized to support the Empire as a whole rather than the Emperor specifically, although he factors significantly in their extensive, pervasive propaganda campaigns. COMPNOR agents are easily the most overzealous of all Imperial agents and genuinely believe that any and all horrors committed in the execution of their duty to root out disloyalty are for the greater good of the galaxy."}},"items":[{"_id":"EvgjjeLuF0CJt74X","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
