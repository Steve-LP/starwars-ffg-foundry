{"_id":"rYzpFpFHncrnaPEg","name":"Ursosaur","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The ursosaur is a stocky, scaled quadruped covered in thick scales ranging in color from light brown to verdant green. Its dark beak is capable of clipping off the twigs of young neelee trees for nesting, but it could just as easily snap a character’s limb clean off. While they primarily subsist on a diet of berries and freshwater fish, these massive reptiles are still considered a threat to those who wander close. Ursosaurs are verv territorial, especially if still caring for their young."}},"items":[{"_id":"pW1oUbooSje9Si5H","name":"Beak","type":"weapon","system":{"damage":4,"critical":1,"range":"Engaged","skill":"Brawl","qualities":"Inaccurate 2, Vicious 4"}},{"_id":"tn6fCJay5LCBUEG3","name":"Claws","type":"weapon","system":{"damage":6,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Pierce 2"}},{"_id":"Pw6DQ9toX5qKCXlO","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"rd5JkEW88RRJEpbA","name":"Quolas Elder","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Quolas elders often represent their families’ interests to the city, the reeve, and other houses. Traditionally, elders are respected figures within the community, though Marcolf has largely ignored or marginalized them over the decades. As such, most are extremely dissatisfied with the current state of politics in Quolas. However, Marcolf’s mysterious abilities and, more importantly, the Empire’s support of his rule have made the surviving elders extremely cautious, and they wish to choose their moment with care."}},"items":[{"_id":"HGgUugB5cjyvtujO","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"hFjmNTTqwrD5gn0J","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
