{"_id":"GwxjoOfUrMmu3zGO","name":"Brana Tsaro, Mercenary Leader","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Brana Tsaro is a burly woman whose armour and gear show signs of significant wear. When she removes the wrappings and goggles that protect her weathered face from the blowing sands of Jakku, her steely grey eyes show a depth of determination and calculation that marks her as a dangerous woman."}},"items":[{"_id":"vMM4eGusuSYdtMcA","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"jYILcMlvFViAJ1xD","name":"Modded blaster carbine","type":"weapon","system":{"damage":10,"critical":3,"range":"Medium","skill":"Ranged: Heavy","qualities":"Defensive 1, Pierce 2"}}],"effects":[],"flags":{},"ownership":{"default":0}}
