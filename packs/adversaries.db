{"_id":"BXrxMuQeTfxSBjd8","name":"Healing Trance (Improved)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Whenever the character heals Wounds as a result of Healing Trance, if they are suffering from a Critical Injury, they may make a Resilience check with the difficulty equal to the Critical Injury’s severity rating. If successful, they recover from the Critical Injury."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"BY0fKrzEFrdfCETR","name":"EV-8D3, Merendata Ev Supervisor Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"EV-8D3 is the visible figure head at the top of the New Droids’ Rights Movement. He is a sadistic droid, compelled by his MDF motivator to cause suffering and distress to others, be they droid or sentient. Under the guise of freedom for all droids, he figures he could be at the head of a bloodthirsty revolution. The resulting opportunities to cause widespread pain, both directly and indirectly, could be imnmense."}},"items":[{"_id":"56b8ksT4lgxj3xyG","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"7PHsPki6MPhZwwsl","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"lbMUYc2iWgsvPiAH","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
