{"_id":"vSWISBz2Q0GITsGa","name":"Harass","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"vTmM8CbXJ3vfsjzF","name":"Philanthropic Senator","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Imperial Senators have a great deal of influence throughout the galaxy, even after the dissolution of the Senate by the Emperor’s decree. Since the Senate’s dissolution, the Senators have a great deal of time on their hands and significant resources. Many choose to travel the galaxy, looking for ways to alleviate the suffering of the people who have been oppressed under the new totalitarian doctrines of the Empire. Although it is not particularly common for these individuals to come into contact with the criminal underworld, it certainly is not out of the realm of possibility, particularly if the criminals in question have some resource that the Senator thinks can be of use to the poor and downtrodden."}},"items":[{"_id":"ex3jEhPEqLrpNJwk","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"vUjPNFzMHCWyDw3O","name":"Master Strategist","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per phase during a mass combat, may suffer 2 Strain to decrease the difficulty of a Mass Combat check once."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"vV6XABKH35wpLHnw","name":"Cacique Kal Coorsa","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Grandson of Jans Coorsa, the legendary Phantom of Gall. Kal was still an infant when his father died resisting the Empire. Primarily raised by his mother, Kal was twelve when she died during an Impetial bombardment of their village. His infamous grandfather took him and moved him with the remnants of his clan to Xorrn.\n\nShortly after Kal’s nineteenth birthday, Jans Coorsa died under mysterious circumstances. Jans’s last will and testament designated Kal as the interim cac1que, a position he has worked hard to retain through mult1ple Clan Assembly votes. Kal does his best to govern Foundry Four with the same keen foresight as his grandfather. However, Kal’s hatred of the Empire blinds his judgement, and he has frequent clashes with former Imperial Lira Hardin."}},"items":[{"_id":"RuJUqIXyTLBn4eEj","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"hglYNokAC19aAGQl","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"pnXTADu23iHV7yXK","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"CTOt3BvDIxVqbzhB","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"TteX4ZgDpeJcyqBk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Ymn6rI1YEKDCcQXF","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
