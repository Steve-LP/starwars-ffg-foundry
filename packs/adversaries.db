{"_id":"cK0s7GEO6QqJQcaj","name":"DC-15x sniper rifle","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"cKFySW1CRgPY9vPu","name":"Dianoga","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The dianoga is a spectacularly unattractive life form native to the planet Vodran in Hutt Space. A type of cephalopod, the dianoga is uniquely suited to camouflaging itself in a number of different environments, a fact that has permitted it to spread far beyond the world of its birth (or even Hutt Space). The creatures are scavengers, living off organic material (primarily waste products) and metabolizing it while leaving behind any mineral content that it might contain. In this regard they are quite useful, and they are generally tolerated as long as they do not make a nuisance of themselves. They can be found in sewer systems and garbage repositories on thousands of worlds, and even aboard larger space stations. Their widespread presence is due to the fact that the larvae of a dianoga is virtually microscopic in size, and thus can make its egress from one location to another very simply."}},"items":[{"_id":"b1JTRFGRAM9KDbep","name":"Tentacles","type":"weapon","system":{"damage":5,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Ensnare 2, Knockdown, Linked 6"}},{"_id":"71sCFNQlFewScCGF","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"cKuTzf5Ch8HDszw7","name":"Wise Warrior (Improved)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per round when making a combat check as an incidental, may spend one Destiny point to allow the character and one ally at Short range to use any characteristic for the check."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"cLzYya8jZjAo4Cuf","name":"Crushing Grip","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Can maintain a grip on an unfortunate target; as long as it has a victim immobilised in its tentacles, it inflicts 2 Strain and 1 Wound at the start of the victim’s turn."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"cMLcp0mCs1jXS03Y","name":"Earned Loyalty","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When commanding clone troopers, Aayla’s Leadership has a rank of 4."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"cMd4wJDjFDn4ejtO","name":"Dalan Oberos","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"To deal with true inheritors of the Jedi legacy, the duke turns to a human bounty hunter named Dalan Oberos, who specializes in dealing with such enemies of the Empire. During the Clone Wars, Oberos first came into conflict with Jedi while completing contracts from Count Dooku and the Separatist Alliance. In the earlier days of the Empire, he further cemented his reputation by tracking down and bringing in Jedi survivors and other Force sensitives. In more recent years, such bounties have become fewer and further between, and the bounty hunter is eager for the opportunity to test his mettle and earn a considerable commission from Duke Irbian."}},"items":[{"_id":"aQTxPmsWgg5IbM71","name":"Custom slugthrower carbine","type":"weapon","system":{"damage":8,"critical":3,"range":"Medium","skill":"Ranged: Heavy","qualities":"Auto-Fire, Cortosis, Cortosis Rounds, Superior"}},{"_id":"nnnhAoj60VZ2bqKt","name":"Cortosis gauntlets","type":"weapon","system":{"damage":6,"critical":4,"range":"Engaged","skill":"Melee","qualities":"Cortosis"}},{"_id":"BmSSt1hs1u2JilLF","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"dJDTCTGmaE2poi7z","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"5fJiT5Qi17H0Aw88","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"CoSTU430Mss052Fg","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
