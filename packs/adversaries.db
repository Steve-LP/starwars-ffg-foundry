{"_id":"1zvS99WFPwMUOHeh","name":"Rise Sisters","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As an action, Old Daka enters a meditative state that leaves her unable to move or defend herself. Each subsequent round she uses her action to roll a :hard: Discipline check with :force::force::force: to summon a single Undead Nightsister minion group. Additional minion groups are summoned per additional :success:. Each group summoned contains a number of Undead Nightsisters equal to :darkside: generated."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"232JJ7xofah52P83","name":"Neimoidian Citizen","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Most citizens of Cato Neimoidia are individually tim id, but fear is a powerful motivator. Rumors of Jedi or allies of Suljo Warde are sufficient to rile up an angry mob."}},"items":[{"_id":"x1aY4WFP46YEVuOs","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"tkdVRqjMyTBZBaOQ","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
