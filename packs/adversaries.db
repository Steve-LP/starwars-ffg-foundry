{"_id":"DKPsYZDuCN6h2RKD","name":"Stormtrooper: Jet Trooper","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A constant sight across the galaxy, stormtroopers exist as a constant reminder of the Empire’s power. On Toydaria, some squads deploy wearing jetpacks, allowing them to counter any targets who seek to escape into the skies."}},"items":[{"_id":"8AQejlo3ioZ7zEYK","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"4xYLCcmSbgTJj5bR","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"lIrBQRCFBtjwajMX","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"kTn2kfGkd02kFOrz","name":"Light repeating blaster","type":"weapon","system":{"damage":11,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Auto-Fire, Cumbersome 4, Pierce 1, Weapon Sling"}}],"effects":[],"flags":{},"ownership":{"default":0}}
