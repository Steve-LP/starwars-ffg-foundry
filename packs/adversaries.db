{"_id":"UGXLjFWlaG4Z02Vp","name":"VX-19, Engineer Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"VX-19 is a modified LOM-series protocol droid with a number of hidden upgrades. His dark gunmetal exterior has been painted with red accents on the shoulders, forearms, and shins.\n\nThe droid has a number of glitches and “quirks” (as Clik refers to them). The droid is very good at what he does and goes out of his way to describe in great detail just what steps he took to complete a task and why his method was far superior to any others tried. He also lapses into periods of inactivity from time to time."}},"items":[{"_id":"EeuspryIcxBs4G3R","name":"Built-in blaster pistol","type":"weapon","system":{"damage":6,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":"Stun Setting"}},{"_id":"gW0uT87QZbb3i3MV","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
