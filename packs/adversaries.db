{"_id":"oc7cwWtbDAS5X08a","name":"A0-2","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"AO-2 is a tall, lanky combat droid with a matte black chassis layered with plates of laminate armour. A single red optic glows from his expressionless faceplate, and a black cloak hangs from his shoulders, covering much of his body. Given the time he spends in Torani’s presence, he is often referred to as her shadow. Though their relationship appears to be more or less egalitarian, some individuals have started to wonder if AO-2 is actually Torani’s master rather than her servant."}},"items":[{"_id":"c3xqTG43I3lUB7ZA","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"sp4V9B34Lx3TZPTi","name":"Integrated vibroblade","type":"weapon","system":{"damage":5,"critical":2,"range":"Engaged","skill":"Melee","qualities":"Defensive 1, Pierce 2"}},{"_id":"2nLVFITPuJvrPjBF","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"2mbyCWMT7Cs9xEyL","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"QkqrFmHtd91oCOPC","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
