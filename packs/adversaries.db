{"_id":"anxTYWKjkGvhQWv4","name":"Gustip","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Baron Kaldo depends on Gustip, his fastidious Drall majordomo, to manage the day-to-day affairs of his criminal empire. Gustip carries himself like an aristocrat, and is never without his aurodium-plated cane. When not on Kaldo’s Hollowtown or Null Town estates, Gustip is accompanied by a gang of Selonian thugs."}},"items":[{"_id":"LcLopyngtMHBC2E0","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"ZHdbG9XujoKYnRqd","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"aoFdhzjCWJA1ivUb","name":"Commander Jun Sato","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Jun Sato hails from Mykapo, a planet that saw the Empire’s power grow so onerous that multiple resistance uprisings sprung up against it. His own brother led one of the cells, the Iron Squadron. Later, thinking the cell lost when his brother died, Sato joined a rebel cell that oeprated in a wider area. As its commander he often displays a stern, by-the-book bearing. His dedication to the cause is second to none, and he is willing to make any sacrifice to protect his personnel and hasten the end of the Empire."}},"items":[{"_id":"iDJh5xDkGpRMNSi7","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"ZEI9olwDQLuwzWQP","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"A9eqO5Ie3imM7B55","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"w0FnGNNWnUBH2OR8","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
