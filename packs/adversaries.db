{"_id":"AkEXiwHSe24O70FV","name":"Tactical Direction","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"May perform a maneuver to direct one allied minion group within Medium range; the group may perform an immediate free maneuver or add :boost: to its next check."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
