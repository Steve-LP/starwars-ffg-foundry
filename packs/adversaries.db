{"_id":"x4s5rJ22UNviYRIG","name":"Boffen Nibs","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The wayward son of Duchess Lassa Nibs, Boffen seeks thrills and adventure. Having decided to undertake a life of crime, Boffen stole the Eye of Corell from his mother in order to fund his underworld career. Unlike most of his kin, Boffen has a talent for lying and underhanded duplicity. Though not malicious in any sense, Boffen is self-centered and relatively naive about the dangers of the galaxy."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"x5IQo1vUVmrXeVwv","name":"Strategic Direction","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per round, Admiral Yularen may spend a maneuver to direct three Republic Navy NPCs or minion groups within Medium range (this can be at planetary scale for targets on other ships); each target may perform an immediate maneuver as an out-of-turn incidental or instead add :success: to their next check."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
