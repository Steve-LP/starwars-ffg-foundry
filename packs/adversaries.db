{"_id":"avoIp60KgZ3oDp96","name":"Commander Abyss","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Amis Abyss started out in Imperial Intelligence, the beneficiary of political connections. Several of those benefactors came to regret it, when Abyss reported them to the Imperial Security Bureau for real, and fabricated offenses, to ingratiate himself with ISB. As he hoped, he was rewarded with a transfer to ISB.\n\nLike many Imperials, Abyss considers non-humans lesser beings. Even lower than that, in his estimation, are Force-sensitives, who are “freaks”. A sentiment he hopes none of the Inquisitors he has worked with in the course of his duties ever guesses. His contempt is based in fear."}},"items":[{"_id":"6bIjUt2rZ69ru5E0","name":"Blaster pistol","type":"weapon","system":{"damage":7,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":"Stun Setting, Superior"}},{"_id":"NUKNjvUjNXDWz4As","name":"Combat knife","type":"weapon","system":{"damage":0,"critical":3,"range":"Engaged","skill":"Melee","qualities":"Pierce 3, Superior, Vicious 1"}},{"_id":"gNxj1BbahqlZoQ9H","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"G1oJLUvOHdPBDz7l","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"xlF46kHvbzvFSWPP","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
