{"_id":"byfs7uXIk6Mjx6N4","name":"Miim","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Miim are large, fat, burrowing creatures that were used as beasts of burden in early mining and agricultural efforts on Sullust. The creatures are smart, social, and easily domesticated. When frightened, miims thrash potential threats with their large tails and flee. Today, Sullustans romanticize the miim and their place in history."}},"items":[{"_id":"oumoYH4OpKaZmM4b","name":"Tail","type":"weapon","system":{"damage":5,"critical":5,"range":"Short","skill":"Brawl","qualities":"Knockdown"}},{"_id":"Pps0xF54IUV5P6TI","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"c3x0dCbaEfOce9C0","name":"Conditioned","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Remove {ranks|setback} from Athletics and Coordination checks. Reduce Strain suffered from falling by {Coordination}."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
