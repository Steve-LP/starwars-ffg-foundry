{"_id":"JpGbkGMoZY1RgyKP","name":"Captain Gideon","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Captain Gideon is a member of the Suwanee Pirates, a desperate group of pirates and cutthroats who have been preying on starships in this area for years. Gideon is a Devaronian whose thick, white horns and trademark devilish grin, and wickedly sharp vibrosword serve to accent his sinister appearance."}},"items":[{"_id":"zmcWcpLlATTGksRA","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"0QBjS22OVgceNCEJ","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"C7i9ntwp1lNjMqfA","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"nojxsZSk9QhWX8hd","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"2vTnkAANREzqLqmk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
