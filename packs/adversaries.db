{"_id":"GdTnfMKQMDZx1Pyw","name":"Mining Guild Enforcer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Mining Guild is one of the single most powerful organisations on Empress Teta. While it uses subtle political maneuverings In the rarified halls of the planet’s government, on the streets it enforces its authority with tough individuals who can be as brutal as any mobster."}},"items":[{"_id":"1cYaHPGytvLPPNep","name":"Spiked knuckle gloves","type":"weapon","system":{"damage":5,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Vicious 1"}},{"_id":"wolImv7ICTWdZTNA","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
