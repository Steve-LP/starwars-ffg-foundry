{"_id":"z6VHfW7zEUv1MtYh","name":"Cin Drallig","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"E0TCBpECHA9yj9JO","name":"Cin Drallig’s Lightsaber","type":"weapon","system":{"damage":"9","critical":"1","range":"Engaged","skill":"Lightsaber","qualities":"Breach 1, Defensive 1, Sunder"}},{"_id":"0FoSKEjF9Vju2JhA","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ZiR4wNdYu1sKenVP","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ajRzKZ4a4Xo3iy10","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"wABMJ5WdNymFyFj7","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Fk7MLpuCxba1FUp1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"3xmhR9sHRXnfkjg8","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"wFCrCXTFOvmZy04M","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"z6vMPiARrqCRQYBP","name":"Fallen Master","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"While not true Jedi or Sith, there are those who stylise themselves as “masters” of the Force. If these individuals turn to the dark side, they can be incredibly dangerous and terrifyingly savage. Some may even track down old relics from a bygone era such as lightsabers. In the hands of a fallen master, these blades often taste the blood of innocents."}},"items":[{"_id":"ZHOUGmPSf34icwc9","name":"Double-bladed mephite lightsaber","type":"weapon","system":{"damage":8,"critical":2,"range":"Engaged","skill":"Lightsaber","qualities":"Breach 1, Linked 1, Sunder, Unwieldy 3"}},{"_id":"jszFCBFFEBCjXDCi","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"LvRAxM6xMTHAAPXN","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"lBCWJTyaxNZmFsNk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ju8gp5FC2H72N0wF","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"awLgYnoTRot4Nxx9","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"z6xBlazL3dcnQKz7","name":"Ithorian Storyteller","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The noble lthorian people, often known by the semi-derogatory nickname “Hammerheads” because of their unique cranial shape, are known for their peaceful, scholarly nature and their devotion to the natural environments of the galaxy. Many lthorians travel the galaxy aboard massive ships known as “herd ships,” although some choose to travel in a solitary manner. Those who do are often steeped in the traditions and lore of their people and enjoy gathering stories of others like themselves. To them. stories are a unique form of culture that should be studied and maintained at all costs and they are happy to speak with others who might have stories to share with them."}},"items":[{"_id":"4iHM4UA2AlKhkR2w","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"z9bVc1FeqPGmn1I0","name":"Spice Pusher","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Perhaps no other underworld figure rivals the spice pusher in terms of sheer antisocial tendencies. Preying on the weak, the helpless, and the addicted, spice pushers are completely without conscience, demanding ever-higher payments for substances that eventually destroy the lives of those who purchase them."}},"items":[{"_id":"qzntZ7UIIKXbSR2S","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"SQFbyg4HOp0sKWE9","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
