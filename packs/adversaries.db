{"_id":"jAQBTGBvBClLdtZZ","name":"Mandi, Revah’s Bodyguard","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Mandi is the only member of the Sorority on Saleucami who knows that Revah is not the real Pirate Queen. She possesses ambitions of her own, however, and these include engineering Revah’s capture or death so that she can claim her mask on Saleucami. To this end, Mandi ensured thatg Krezo Wasanti knew the name of the pirate base’s location when she sold him a large amount of Consortium plunder."}},"items":[{"_id":"Z4hcOXnrCelqWvHn","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"VS12iMwk3UDaeoxG","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"jsvXkoyuHhxqGR8X","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"UBhcw0T56oMIx5Na","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
