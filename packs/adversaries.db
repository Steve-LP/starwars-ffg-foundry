{"_id":"XutFKKTZNfszn6Yd","name":"BL0-Series Non-lethal Combat Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"IVHQfgSzsKNDWZKb","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"JnNAZOFPL6o5tsUs","name":"2 Built-in stun whips","type":"weapon","system":{"damage":5,"critical":0,"range":"Short","skill":"Melee","qualities":"Stun 3"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"XwO05zGNaQAvGBSE","name":"Kouhun","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Kouhuns are small, multi-legged, venomous arthropods approximately thirty centimeters long, with gray, segmented bodies and large mandibles. Kouhun bites deliver a fast-acting and fatal neurotoxin, making them a favorite “weapon” of many assassins. On their home planet of Indoumodo, they are simple predators who track prey by heat. Their tiny size makes them adept at slipping through ventilation systems, windows, cracks in masonry, and other tight spaces. When cornered, kouhuns can also use a sharp, non-venomous tail spine to defend themselves."}},"items":[{"_id":"8nkHNn2zTw8vDumy","name":"Spine","type":"weapon","system":{"damage":2,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Pierce 5"}},{"_id":"TNxNkfF82RK8WVhP","name":"Mandibles","type":"weapon","system":{"damage":2,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Pierce 2"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"XwU6sE1eqx7ooR91","name":"Rocket Pack","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Allows Teska to function as a Silhouette 1, Speed 2, Handling 0, System Strain Threshold 6 vehicle that requires Piloting (Planetary) (:proficiency::proficiency::proficiency:) to operate."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"XzK7g1Stvp1bRL0G","name":"Scout Trooper Speeder Bike Pilot","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"These scout troopers are trained in the operation of light planetary vehicles, such as speeder bikes and AT-STs. These vehicles are normally used to fly patrol routes through the jungles of Onderon."}},"items":[{"_id":"HGc6blu73Uc0UGIQ","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Y0W4cpV9UulJmAzA","name":"Marksman-H Combat Remote","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Also referred lo as a “seeker droid” or “training remote,” the Marksman-H by Industrial Automaton is a versatile little droid that has found many niches. some of them unintended. This model of droid is employed variously as a basic security unit, a training tool. a pest controller. and even as a tiny as sassin. Individuals the galaxy over continue to find new and innovative uses for this versatile droid.\n\nSome Jedi once preferred the Marksman-H as a training tool when teaching Padawans to reflect blaster bolts with their lightsabers. Even after the fall of the Jedi Order, some of these same droids remain active. A Marksman-H can be a tenacious opponent. It responds to a handheld signaler that transmits high-pitched bursts of coded data. and can be programmed to receive verbal commands.\n\nThe Marksman-H is a small, spherical droid only fifteen centimeters in diameter. Its tiny repulsorlift unit propels it in seemingly random directions without warning. making it hard to track. Studded with a number of emitter nozzles which are factory equipped with micro stun blasters. these droids are commonly programmed for use as security drones."}},"items":[{"_id":"LUDdU6sm7X4MBExm","name":"Micro stun blaster","type":"weapon","system":{"damage":1,"critical":0,"range":"Short","skill":"Ranged: Light","qualities":"Stun Damage"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Y38DcFubH8WRwYOv","name":"Vaapad Flourish","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per encounter when making a Lightsaber combat check, Windu may add any uncommitted :force: to the roll. Each :lightside: generated counts as an additional :success: and each :darkside: counts as an additional :threat:."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Y53nzFNujS2YFpGB","name":"Corrupt Bureaucrat","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Politics is a deadly game and often those who play it have a wide variety of plots and machinations in motion at any one time. Many of these depend upon the extensive use of ignorant, expendable pawns. Criminals, and those who society would prefer to ignore, are ideally suited for this manner of operation. A cunning politico knows how to make use of such vassals, promising them enough cash to ensure they are interested without asking too many questions. Those who can get the job done and keep their mouths shut can find lucrative, long-term employment, while those who cause too much of a spectacle can quietly be diverted into situations that allow the problem to resolve itself, usually in a violent manner."}},"items":[{"_id":"yoXgA9pPgLCdbPwd","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"MitlKJ2nTm5JkElk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ltjcA25BAK72eW59","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Y5h3NOYzJPTBBNhO","name":"Crucial Point","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session during ongoing negotiations, as an incidental, may introduce one concession that an opponent will do anything to obtain."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Y6UR5OEqsSHHP5kA","name":"Etiquette and Protocol","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Protocol droids allow allies to add :boost: to any Negotiation checks or other checks made to negotiate or mediate."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Y7E4g8p0NqLQEUyD","name":"IG-RM Series Enforcer Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"HCG4W8iAyJGkNIOu","name":"DLT-18 Heavy blaster rifle","type":"weapon","system":{"damage":10,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Auto-Fire, Cumbersome 3"}},{"_id":"6yETx3E5uDriDJWT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"hLCTsIGQNkNLSQcC","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Y8EhzeXVMyCSVR9I","name":"Envenomed Bite","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Whenever the bearsloth suc­cessfully attacks a target (whether or not it deals damage), the GM may flip a dark side Destiny Point to have the target suffer the effects of being exposed to bearsloth venom."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"YAs8SfvC73orVPSU","name":"Barabel Enforcer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A step up from a simple thug, an enforcer is a bit more trained and intelligent in the application of brute force. To avoid excessive expense in training such individuals, as well as to inspire fear in those they need intimidated, criminal figures tend to look for imposing beings with significant physical might to fill these slots. Gamorreans are common, of course, as are Aqualish and Wookiees, but Barabels are particularly feared because their reptilian appearance inspires a deep, primal fear in many mammalian species. Barabels are an intelligent species, but often seem otherwise be cause of their halting command of Basic and their seemingly primitive social customs. Their physical strength is prodigious, however, and they also enjoy a significant amount of natural armour that protects them from many threats, making them ideal enforcers to send into danger ous situations."}},"items":[{"_id":"ZrcdRQuhjs1DpXjf","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"MWyeOxrBNAphPXzM","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"CtK51TF86aI51maN","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"S1mBDJ7XyBJGINCh","name":"Serrated combat knife","type":"weapon","system":{"damage":0,"critical":3,"range":"Engaged","skill":"Melee","qualities":"Vicious 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"YBW7wtmSmQY63754","name":"Gutkurr","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"zmBUG1h0p1JSdb4r","name":"Mighty jaws","type":"weapon","system":{"damage":"8","critical":"3","range":"Engaged","skill":"Brawl","qualities":"Vicious 3"}},{"_id":"nSjttFm2YxdaDlI1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"YDQ9O5VyYfCh6BfQ","name":"Clone Trooper","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Genetically engineered for loyalty and combat ability, and trained as soidiers from decanting, the clone troopers of the Grand Army of the Republic are among the finest fighting forces the galaxy has ever seen. Thanks to their training and ability to think on their feet a clone trooper is easily the equal of several battle droids—and doubly so when clone troopers work as a team with their brothers."}},"items":[{"_id":"FVeHkYjzp1dJR0jq","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"D71Jm8XO8mxQfqvy","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"YDTswgtj4QFTQncz","name":"Bog Spitter","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The bog spitter is a fast-moving quadrupedal lizard distinguished by its thick scaly hide and the venomous poison it projects into its victim’s face when attacking. Bog spitters can grow up to 4 meters long and 1 metre tall, weighing as much as 9 0 kilograms. Despite its large size, the bog spitter is surprisingly fast, able to outrun most small– and medium–size prey in and around the marshes it calls home. Once the bog spitter blinds its prey with its poison spit, it pounces and attacks with its massive front claws and powerful bite."}},"items":[{"_id":"oaMWzTSb76Yh0dfQ","name":"Poison spit","type":"weapon","system":{"damage":3,"critical":0,"range":"Short","skill":"Ranged: Light","qualities":"Pierce 2, Slow-Firing 2"}},{"_id":"8HT407KiJrg2T4AA","name":"Claws","type":"weapon","system":{"damage":7,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Knockdown"}},{"_id":"er0i3hDdAWiKtEFs","name":"Bite","type":"weapon","system":{"damage":7,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Pierce 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"YJZCTt0fxy3SuQp0","name":"Smuggler Baron","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Some smugglers not only survive in the industry long enough to retire, but prosper beyond their expectations. Some of them find the notion of retire ment too boring to contemplate and instead decide to become something of a middleman, helping other smugglers connect with clients and individuals who need goods moved from one place to another without any troublesome questions. These men and women are sometimes called smuggler barons, a fitting title given the aristocratic airs some of them put on. Smuggler barons are not quite powerful enough to be considered crime lords in their own right, but can be powerful allies or inconvenient enemies."}},"items":[{"_id":"hE6GeQk0gK7t8AVt","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"HAQCDKxNw801QYyh","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"2OeHTAtGY1Xi6CQ7","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"oJywlurFI0bFrUPL","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"YM8MiDxACCdvl3rZ","name":"Improved Reflect","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When struck by a ranged attack but before applying Soak, suffer 3 Strain to reduce damage by {ranks|plus-2}. When reflecting a hit that generated :despair: or :threat::threat::threat:, may hit one target within Medium range dealing the same damage as the initial attack, after the original attack is resolved."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"YNr3AH1qSB7erz6a","name":"Toydarian Merchant","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Despite common stereotypes, not all Toydarians are merchants. Still, as with most sentient species, many Toydarians make their livelihood via commerce on Toydaria and across the span of the galaxy at large."}},"items":[{"_id":"1fY2CtVeC2vanGR9","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"m7uqff15w7O5xWxd","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"hXmSzq7mQiZQaVk1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
