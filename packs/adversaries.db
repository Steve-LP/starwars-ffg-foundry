{"_id":"BBRKC8qoo21BHAt6","name":"Ink Spray","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per encounter, as an out-of-turn incidental, a Quarren may spray ink from their gills, suffering 2 strain to add :setback: to a combat check made by a character within Short range or :setback::setback::setback: if the check is underwater."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
