{"_id":"qV7m2sj2LVGNkVGj","name":"Alliance Commander","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The individuals chosen by Alliance High Command to serve as individual commanders, whether of military units or fixed assets, are invariably intensely focused on their duties. The position of commander leaves no time for a personal life, and those who accept the duty understand that they are surrendering all in order to serve the Alliance. In addition to their talent for logistics and tactics, commanders must also be prepared to make difficult decisions that will, without question, result in the loss of lives under their command. These individual commanders are granted tremendous autonomy by High Command, and thus are often free to pursue objectives of their own choosing."}},"items":[{"_id":"U66s4N65ymiIQ3KA","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"YKAOqeyP7Kuz5j9A","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"IW0K9bw5pfGcrcy1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"JA0ZBbVdCd5FXGGD","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ArezAFiQm3QT91PG","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
