{"_id":"ZNPEJX4871CfxCB7","name":"Frangawl Cultist","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A tiny minority of Bardottans long for a return to the days when the Frangawl ruled their planet. These cultists are usually content to stay in the shadows, their heretical beliefs hidden, but occasionally the cult grows in power enough to make a political move against the Dagoyan Masters.\n\nFrangawl cultists wear large, fearsome masks carved from wood in the shape of fantastic creatures. In addition to creating an unsettling appearance, these masks hide the cultists’ identities."}},"items":[{"_id":"u6v4UaWp4vN5u1ml","name":"Spear","type":"weapon","system":{"damage":6,"critical":3,"range":"Engaged","skill":"Melee","qualities":""}},{"_id":"hxtZGeKZfKEtmzYp","name":"Thrown spear","type":"weapon","system":{"damage":6,"critical":3,"range":"Short","skill":"Ranged: Light","qualities":""}},{"_id":"5rHjfgHRpOUnaJz1","name":"Bag of sleeping powder","type":"weapon","system":{"damage":0,"critical":0,"range":"Short","skill":"Ranged: Light","qualities":"Limited Ammo 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
