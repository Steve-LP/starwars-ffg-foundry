{"_id":"mOlBV3A0moWpTD80","name":"Sakiyan Bounty Hunter","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Sakiyan bounty hunters have been known to give both Gand findsmen and Rodian bounty hunters a run for their money as the most efficient hunters of sentients in the galaxy. Using their keen senses, deadly instincts, and superior repulsorlift technology, they have a diverse arsenal from which to draw when seek ing to bring in their marks either dead or alive."}},"items":[{"_id":"iMWtGgluEmBFeSaY","name":"SakTek D-29 repulsor rifle","type":"weapon","system":{"damage":8,"critical":4,"range":"Medium","skill":"Gunnery","qualities":"Disorient 3, Knockdown, Stun Damage"}},{"_id":"dUVTE1lXg4Dh4uyM","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"QxYP9gGQJ1pe8Mxw","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
