{"_id":"OAcadabAqlZ4jFtp","name":"Maul","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once a Dark Lord of the Sith and then a criminal warlord, this Zabrak is now known simply as Maul. A lifetime of hatred and betrayal have transformed the Dathomirian native both physically and mentally. A prowling predator upon cybernetic legs, Maul is obsessed with revenge — especially for a long-time foe whom he first met on Naboo before the fall of the Republic. Maul believed him dead, but has recently discovered he still lives on a desert planet with twin suns. Enraged with this knowledge, Maul will not rest until he finds and defeats this former Jedi Master."}},"items":[{"_id":"QPZwir7kyc8RNTTb","name":"Sapith lightsaber","type":"weapon","system":{"damage":9,"critical":2,"range":"Engaged","skill":"Lightsaber (Agility)","qualities":"Breach 2, Sunder"}},{"_id":"w6t3heusNdEigMOd","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"TuT6egAl1U3fVBqI","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"tJPYeb5rSyiUfft9","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"QHuJVR0d0qAyG2Vk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"s2GsBfbTlOhZiwdK","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"gR648by5opVylOtG","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"S8Dzi2Bg0kNAEXZV","