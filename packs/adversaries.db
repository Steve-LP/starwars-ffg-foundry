{"_id":"eya767jbEv4jQrLD","name":"Minister Tua","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Minister Maketh Tua is the public face of Imperial government when Governor Pryce is offworld (which is often). She is a graduate of the Imperial Academy. Like the governor, she aspires to greater things away from Lothal, but unlike Pryce, Tua still cares about the planet and its people. Unfortunately for her, events and expectations often exceed her experience and training. As the Empire grows impatient with events on Lothal, her position becomes ever more precarious — something she is becoming more and more aware of with each passing day."}},"items":[{"_id":"iLXoKb8dvGtsVqIO","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Nnw3fWGq1mjy8vLc","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
