{"_id":"xei5kYStOwF8fjXv","name":"Ghorla","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"An equinoid mount used in traditional hunting parties, the ghorla is, like most Chandrilans, independent and stubborn, but intelligent. Ghorla are bred for a variety of activities, including racing, showing, mounted sport, and more menial tasks like herding, labor, and transportation around the farm."}},"items":[{"_id":"7jtH2sHByt6BbJWX","name":"Trampling hooves","type":"weapon","system":{"damage":7,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Knockdown"}}],"effects":[],"flags":{},"ownership":{"default":0}}
