{"_id":"kAIqUe4uulFMi0L8","name":"Armed Security Guard","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Archive’s armed security forces are a subset of regular campus security. Their main difference is that they are authorized to carry weapons. However, they are under strict instructions to leave their blasters on stun unless they are confronted with deadly force."}},"items":[{"_id":"0jt7HH8MY0wi5eGI","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"NZg5qVcOT5SJRjIj","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
