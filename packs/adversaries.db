{"_id":"6N7prPJ8ebWExZne","name":"Scarred Gladiator","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Sometimes the most effective way to hide your Force-sensitivity is to hide it in plain sight. The Scarred Gladiator discovered that his combat skills could make him a lot of money in the arena. He’s the veteran of hundreds of battles and has the scars to prove it. He is deeply invested in the criminal underworld, and there are too many people who make money off his skills for anyone to turn him over to the authorities. He doesn’t flaunt his Force-sensitivity, but he enjoys his notoriety as a deadly and feared fighter. He knows there may be a day when it all comes crashing down. Until that day comes, he’s more than content to use his abilities to live life to the fullest."}},"items":[{"_id":"W21CYP2Dn3szwJNu","name":"Vibro-trident","type":"weapon","system":{"damage":0,"critical":2,"range":"Engaged","skill":"Melee","qualities":"Defensive 2, Pierce 4, Vicious 3"}},{"_id":"O5ZspqN1KTVH2sAn","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"zjFhmu1SThWLzygz","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
