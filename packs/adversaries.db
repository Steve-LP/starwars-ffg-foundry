{"_id":"krBUMz3ys2D0X651","name":"Meditative Trance","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When suffocating, suffers 1 Strain each round instead of 3. When exposed to vacuum, suffers 1 Wound each round instead of 3."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"kvvhLerfIuKJdBpa","name":"Consortium Starfighter Pilot","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Zann Consortium’s fighter pilots are highly skilled and proud of their elite status. Though many are cocky and overconfident, they possess the talent to back up their bravado. They come from all genders, backgrounds and species. The Consortium starfighter pilots aboard the *End of Days* are part of Sabacc Squadron, otherwise known as the “Gamblers”. Sabacc Squadron pilots are well known for their willingness to face and overcome incredible odds. Each has a callsign that corresponds to a face card from sabacc, such as “Endurance”, “Demise”, or “Star”."}},"items":[{"_id":"vMTFBRPGPH7gfK9O","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"6S3hECx2qUb2Euwq","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
