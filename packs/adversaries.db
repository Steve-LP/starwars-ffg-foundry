{"_id":"Ecx1JvXPiGj1e0tj","name":"Freff, Nightbrother Leader","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Freff is highly honoured to be part of Jerserra’s quest, having seen first-hand not only her powers with the Force but also her resources as a mercenary leader. Now that she is deep underground with the Nardithi cluster in her command, his awe of her has only grown, while her powers have increased."}},"items":[{"_id":"g7k889XNl6asEJbi","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"yR1wIxdPHeCsNy3k","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"HrDlZrJB5tMTUiGs","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"8476FKpvLtxPZ0cJ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Eczw8KormVOTKaIH","name":"Stormtrooper: Snowtrooper","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Just as desert worlds present environmental conditions that are a barrier to normal military operations, planets with an extremely cold environment are likewise impractical for traditional protocols, including the stormtrooper legions. Snowtroopers have specialized armour and equipment that can function regardless of the temperature and are capable of operating for long periods of time without needing any support of any sort. Furthermore, they are equipped with sensor packages that allow them to seek out thermal images in a sea of ice, which dramatically increases their effectiveness in combat."}},"items":[{"_id":"TUfQKoOchf2D37nW","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"xgjIhv8HMt8SRQQl","name":"Multi-optic sighted blaster rifle","type":"weapon","system":{"damage":9,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Stun Setting, Multi-optic Sight"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"EdYrguwBvLau70md","name":"Spectre Of The Dark Side","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"All attacks from the apparition ignore the target’s soak value. Instead, the damage is reduced by the target’s Willpower and ranks in Discipline combined. All damage is dealt as strain."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"EiyvQLOYwmqbeFSa","name":"Chandrilan Navy Officer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Graduates of the Brionelle Academy often find work in the Chandrilan Security Force as ranking customs officers, on orbital defense platforms, or as pilots in the starfighter defense wings. Graduates of Brionelle are well educated and considered pillars of the community in many cases. It is common for naval officers to also engage in some form of boating, whether the boat is a powered yacht or a sailing vessel."}},"items":[{"_id":"49xKr2v1qVP6OAQe","name":"Stun pistol","type":"weapon","system":{"damage":6,"critical":4,"range":"Medium","skill":"Ranged: Light","qualities":"Stun Damage"}},{"_id":"IQyJiNQ0rYmXo6CP","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Eizc7aPzVIc7Rcpv","name":"Skyholme Lucite","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Skyholme Lucites are part of a secretive cabal of evildoers who masquerade as Astromancers. It is unknown how many of this order are secretly part of the Lucite cult, but even one of these devious individuals can cause untold suffering and devastation if allowed to run rampant."}},"items":[{"_id":"7BKb3qJvszAoqyJf","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"0M1CCYd7OvkexqNl","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"Kz3kjzHLBDHMyv5w","name":"Unleash","type":"weapon","system":{"damage":4,"critical":4,"range":"Short","skill":"Discipline","qualities":""}},{"_id":"Ff5mzPIZw7z7xBuZ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"CKtBrNjGLQWLxryL","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"f3MPI5gphRKFgfYJ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
