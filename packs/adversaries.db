{"_id":"u5c5o979t2FsNEQf","name":"Alliance Airspeeder","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"AJOqZWQ1ROK3BHff","name":"Twin heavy blaster cannons","type":"weapon","system":{"damage":5,"critical":4,"range":"Close","skill":"Ranged-Light","qualities":"Linked 1"}},{"_id":"qWknAMAE1TAXF84u","name":"Aft turret-mounted electromagnetic harpoon","type":"weapon","system":{"damage":0,"critical":0,"range":"Close","skill":"Ranged-Light","qualities":"Tractor 3, Knockdown, Limited Ammo 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
