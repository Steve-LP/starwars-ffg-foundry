{"_id":"btV0Gs1GAZQSrWJu","name":"Lt. Rik Torrence","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Rik is a skilled pilot in his mid-thirties. An up-and-coming hotshot and lieutenant in the Alliance, he has dark brown hair, a clean-shaven face, and is physically fit. He is just shy of two metres in height.\n\nRik has a somewhat cavalier attitude to go along with his impressive service record. He loves to talk of past exploits and missions, especially over drinks. He’s somewhat of a celebrity among the Arda Rebels, being the one for whom the Torrence Run on Arda I was named. This popularity goes to his head, however, and he often comes off as condescending or arrogant. Now that the PCs have become the new “heroes of Arda I,” his jealous side has begun to show."}},"items":[{"_id":"DGnh10Mjq68rzgmI","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"9OcJbNZP35LdUgFZ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"QJQGMSabL2qogUdm","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
