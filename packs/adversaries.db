{"_id":"zrj0h2XAyGEzvM2O","name":"Autoturret","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Each of these security droids resembles training remotes with black spherical bodies, protruding blaster barrels, and red sensor lights that ring them. They are extremely mobile and difficult to hit, and they pack a considerable punch for their size. The devices have been used in many galactic conflicts, including the Clone Wars, as cover for snipers on both sides."}},"items":[{"_id":"1uhhYayiq8xr9qqv","name":"Built-in repeating blaster","type":"weapon","system":{"damage":6,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":"Auto-Fire"}},{"_id":"UkqcYOVcX2ceFX3O","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
