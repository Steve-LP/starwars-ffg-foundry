{"_id":"yJEjfganyAEtHs1N","name":"Governor Varla Prule","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Varla Prule is a middle-aged woman of means who managed to secure the questionably prestigious rank of Governor of the Remduba system. She speaks with a refined Coruscanti accent, and dresses in a fine white Imperial uniform when seeing to her duties aboard Martle Station."}},"items":[{"_id":"QVvzR69pPQc5SVDc","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"yK8d99HZw2hMz638","name":"Force Power: Battle Meditation","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Spend :forcepip: to add one automatic :success: to all checks made by a number of engaged friendly targets to up Presence before the end of the next turn. If any :darkside: were used to generate :forcepip:, reduce each target’s Willpower by 1 (to a minimum of 1) until the end of the encounter."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"yKBSQlyOhpFHwsz8","name":"Mustafarian Miner","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Hailing from the young, volcanic world of Mustafar, the Mustafarians are the first species there to evolve to sentience, which is remarkable considering the violent nature of their homeworld.\n\nThese bipedal humanoids stand almost two-and-a-half meters tall, and are very much at home in some of the harshest planetary conditions in the galaxy. Mustafar’s immense mineral resources have made the Mustafarians quite wealthy, and they have traded for technology and equipment to help them occupy even the harshest corners of their home planet. They quietly support the Galactic Empire in exchange for Imperial protection, happily exchanging their mineral wealth for relative privacy and advanced technology."}},"items":[{"_id":"5Ufml2kqCyD5lelZ","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"kdtd2iqZACpACp76","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
