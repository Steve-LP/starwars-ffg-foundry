{"_id":"4c7k4iJdS0R3Q5ZO","name":"Mon Calamari Mechanic","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Mechanics are a regular sight at any modern spaceport and most keep at least one trained mechanic per berth on staff to ensure that there are enough to meet the needs of their clients. Of course, many clients prefer to maintain their own vessels, but those who have access to trained staff, like the naturally talented engineers of the Mon Calamari race, are often wise to make use of such an opportunity. Mon Calaman typically take great pride in their work and are careful to ensure that any ship on which they are working operates at least as well as it did when it came off the showroom floor."}},"items":[{"_id":"MvOU9EJwz2LyP8zN","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
