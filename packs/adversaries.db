{"_id":"DYuyGrIdHZL2m1Cc","name":"Physician","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Although there are certain cultures that strongly emphasize and specialize in medical training, for the most part, the finest medical academies and universities in the galaxy can be found in the Core Worlds. The physicians, surgeons, and specialists of the Core Worlds are among the best in existence, far better than the admittedly gifted and more commonly employed medical droids. Because of their reputation, Core World physicians are sometimes found in other regions of the galaxy, either because they are hired by the incredibly wealthy or because they are on a mission of mercy to the poorer planets and systems of the Mid Rim and Outer Rim Territories."}},"items":[{"_id":"DBwFF9pXsiSQhr28","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"wSlRA1tWmrktamG5","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
