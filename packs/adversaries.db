{"_id":"XaFyZpHkBLW8e08c","name":"Hound Master","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"May spend a maneuver to direct any trained beast within Medium range. The beast may perform an immediate free maneuver or add :boost: to their next skill check."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"XaGKR6UkhPXO2ZRn","name":"Cassian Andor","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"SZkeKFhQ6VnbvVn3","name":"Assault rifle mode","type":"weapon","system":{"damage":8,"critical":3,"range":"Medium","skill":"Ranged: Heavy","qualities":"Stun Setting, Auto-Fire"}},{"_id":"Q7p57N0721jvOpy0","name":"BlasTech A280-CFE blaster pistol","type":"weapon","system":{"damage":8,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":"Stun Setting"}},{"_id":"nERg8iJTC2lF9sgL","name":"Sniper rifle mode","type":"weapon","system":{"damage":8,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Accurate 1, Pierce 1"}},{"_id":"GxgjTqPYuBdNBgTS","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"GJF8teHKyjI9ttWp","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"XbAdcSzaWHX6DrXy","name":"Jerethian Clamberwolf","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"TVmIKx9KTDQzBCHd","name":"Claws","type":"weapon","system":{"damage":7,"critical":2,"range":"Engaged","skill":"Brawl","qualities":"Vicious 2"}},{"_id":"vaWU3Aj6gUqa1Qtm","name":"Teeth","type":"weapon","system":{"damage":7,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Pierce 3"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"XcAECtFz5WjR6NV2","name":"Imperial Navy Officer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Officers in the Imperial Navy are highly trained, often at a military academy. Most of their duties naturally fall into the category of ship-bound activities, monitoring the hundreds or thousands of personnel necessary to maintain the massive capital-scale ships the navy depends upon However, it is also possible that officers are deployed at the head of naval troopers, taking part in ship-to-ship actions against pirates or independent vessels or. even in sorties on the ground. In these cases, most naval officers prefer to lead from the rear, using their superior training and experience to direct the activities of their subordinates. Despite their reluctance to “get their hands dirty,” it is unwise to underestimate naval officers."}},"items":[{"_id":"Ih5K9X033ikriiHF","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"gUaexjEYyvplsenB","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
