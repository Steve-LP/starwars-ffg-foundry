{"_id":"vbXQtrDsOmU8oduk","name":"Pirate Crew","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The vast void between worlds is not something that most citizens of the galaxy spend a great deal of time thinking about; it is simply something to be passed through until a journey is complete. However, the dangers of the void are innumerable, and pirates are far from the least of them. Apolitical and cursed with endless avarice, pirates prey upon any ship weak enough for them to target. This rarely includes military ships, such as those belonging to the fleets of the Empire and the Alliance, but individual teams of operatives on either side of the Galactic Civil War can fall victim to pirates’ endless greed if they are not careful."}},"items":[{"_id":"PbNtgVwCgzvrEdfX","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"w0Wt2Yt3wUCCMTGC","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"2GejULm62YF9veRu","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
