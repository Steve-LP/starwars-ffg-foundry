{"_id":"gtmTZHW771UtX3Zk","name":"Dug Agility","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Gains +1 ranged defence due to Dugs’ natural mobility."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"gu7BV7j6juD0pPYl","name":"Nerf Herder","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The nerf was a domesticated herd beast that originated on the planet Alderaan. Because the nerf was simple to raise, useful as both a beast of burden and as a source for meat, it became one of the most extensively farmed animals in the galaxy. Eventually, the nerf spread to planets in every region, including the Core Worlds. Multiple variants of the incredibly adaptable animal were bred to thrive on numerous planets and in myriad environments, ensuring that it is one of the single most prevalent livestock species in Known Space. Those individuals who choose to raise nerf herds are typically simple folk, embracing a meager domestic lifestyle with the security of a long and easily maintained career."}},"items":[{"_id":"PhwebtqKs03cUshp","name":"Sheperd’s crook","type":"weapon","system":{"damage":3,"critical":4,"range":"Engaged","skill":"Melee","qualities":"Disorient 2"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"gyvlsbOyPdHkOQqW","name":"Martle Station Dockhand","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The dockhands of Martle Station work together in tight-knit groups called workgangs. Each workgang dresses in a similar fashion, using distinguishing markings and colours to proclaim their allegiance. Some workgangs are divided along species lines, though most integrate members of any species so long as they are loyal and productive."}},"items":[{"_id":"qrlkjbQzf9ITMkhj","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h0OVm7vrT4rTI4pI","name":"FX-769, Medical Assistant Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"FX-769 was employed by Oridelve to diagnose and treat any aliments or injuries suffered by the miners. While he is poorly equipped for violence, he nevertheless believes in the violent struggle for the droids’ rights and does what he can to help his fellow revolutionaries."}},"items":[{"_id":"8h4kTXFjHpEIid02","name":"Molecular Scalpel","type":"weapon","system":{"damage":3,"critical":2,"range":"Engaged","skill":"Melee","qualities":"Pierce 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h0T7syLXwmn8eVPq","name":"Zam Wesell","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"ETb77zGIFiK0Qbpq","name":"Model 38 sharpshooter’s rifle","type":"weapon","system":{"damage":"8","critical":"3","range":"Extreme","skill":"Ranged: Heavy","qualities":"Accurate 2, Pierce 3"}},{"_id":"1z8uRymLZkEk9Wdl","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"DiZqbgymrrXpSDaS","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"fPikwRTtUkviQnfc","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h1qe0TfDt2x2ZgIB","name":"Diplomat","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The adamant, absolute stance of the Empire when dealing with others, even its allies, is a benefit of its overwhelming size and force, but it also serves as an advantage of sorts for the Alliance. With each atrocity or military intervention that the Empire commits, it becomes easier for the Alliance to point toward them when attempting to recruit new allies in their struggle. While some are afraid of the power of the Empire, validating such terror tactics, just as many individuals take great offense at the oppression and totalitarianism of their would-be masters and offer their support to the Alliance. High Command has a limited corps of diplomats, many formerly associated with the Galactic Senate, which is employed to make this sort of agreement happen. These diplomats are extremely patient, willing to wait as long as necessary for the innocent people of the galaxy to realize the truth; trying to press the point only increases their resistance. Waiting to secure what is necessary for victory as more atrocities are committed is a price that weighs quite heavily upon many of them"}},"items":[{"_id":"sjUv1JIVavh9Ya8p","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h3K7s0T4QWgMF8Jl","name":"Constrictor","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Opponents affected by the En­snare quality immediately begin suffering the effects of suffocation."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h3pLVjiSpcuLMUvE","name":"Vorse Tabarith, Mob Boss","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Even without his fearsome reputation, Vorse Tabarith would be an easy man to recognize. His huge frame and thick bristly beard have led a few brave souls to compare him to a Wookiee when he was out of earshot. While well shy of a Wookiee’s height, his broad shoulders and burly chest allow him to approach some of them in mass and muscle. He wears sturdy but expensive clothing when handling day-t-day affairs, and often a few pieces of gaudy jewelry as well."}},"items":[{"_id":"z2lLDG4XTqNnCh1j","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"bGGTlzJmOhsMgBay","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"v5TMLVo3f0mVqcPo","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"dGMtAMuFlzvItodN","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"T3Pbdrf08Ng9zynR","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h5gfLtIpx6IiJxEM","name":"Neurotoxin","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"If a target suffers wounds from a kouhun’s mandible attack, the target must make an :average: Resilience check. The target suffers 5 Wounds if he fails, plus 1 Strain per :threat:; :despair: means the target must check against the poison again at the start of his next turn."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h5omD2OGrsrci1aB","name":"Duke Erron Irbian","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"i6K1CJjHYKu1JGgi","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"d8kSaToFo4tge5eE","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"E2Ed4P0OqG6iPnP9","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h6DNm9tStRnnUVfl","name":"Swoop","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h6HFoSzisSK5JSEi","name":"Stormtrooper Captain TH-313","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"TH-313, sometimes known as Tacker, served under Suljo Warde during the Clone Wars. Tacker was very fond of Warde and held him in high esteem. His respect for Warde remained even as sentiment began to turn against Warde due to the harsh measures he took to maintain Republic control of the city. Clone troopers rarely questioned their superiors’ orders, and though Tacker had some reservations about Warde’s methods, he never gave voice to them openly. As a combatant, Tacker saw Warde as peerless even among the Jedi he knew and served. He can recount numerous anecdotes in which Warde’s power of foresight saved his life and those of his fellow soldiers. If the PCs engage him in conversation about Warde and the days of the Clone Wars, he also tells them of the Jedi Knight’s skill with the lightsaber, his ability to lift objects with his mind, and the superhuman feats he performed in combat, leaping from one foe to another with incredible speed. Tacker expresses regret that such warriors are so rare today, and encourages them to pursue their own gifts as the Jedi of old once did."}},"items":[{"_id":"TCqArHkWDgBpObvm","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"SHfXPHS3eFPlDMBq","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"Anf9D28qLdXFsSHj","name":"Two SE-14r light repeating blaster pistols","type":"weapon","system":{"damage":6,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":"Auto-Fire, Stun Setting"}},{"_id":"i01XuJZvCUvkfpk8","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h6TEbbhBSEjnAKZP","name":"Leap","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Adds :boost::boost: to all Athletics checks made to perform vertical or horizontal jumps."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h7pN4kAanJBfxGvV","name":"Starfighter Pilot","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Prior to the Battle of Yavin, starfighter pilots were already a celebrated group among the ranks of the Alliance. High Command held firm to the opinion that their new starfighter design, the X-wing, was superior in every respect to the craft commanded by the Imperial Navy. It was thought that this superiority would translate into a distinct advantage in naval battles. Since the destruction of the Death Star, this philosophy has only gained ground and become more prevalent among other ranks of Alliance personnel. While well-founded in many regards, this philosophy has also caused something of a rift to form between starfighter pilots and the other enlisted personnel serving in the Alliance. Pilots are often considered arrogant and coddled by High Command. Whether this perception is true or not, most Alliance pilots are extremely confident to the point of being cocky."}},"items":[{"_id":"lWb1cAwQ4jl71jeg","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h8ix1esPwjRHyCzi","name":"Q7-Series Astromech Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Q7 was the result of a joint venture between Industrial Automaton and Kuat Systems Engineering. Designed specifically for use in KSE’s A3 Nimbus short-range interceptor, the Q7 is unique among IA’s astromech droid catalog in both construction and personality. Using design specifications and access to the Nimbus’ advanced new software architecture, IA developed its new droid specifically for use in the new fighter, a process that both companies felt would be a growing trend in the near future. After numerous failed prototypes, IA finally perfected the interface systems and the brand new Q7 was revealed along with the Nimbus to overwhelming praise from both the military and civilian sectors."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h8ttvxPjL4PRoRzZ","name":"Catrinna","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Catrinna is a beautiful, charming, and alluring young woman who dresses well and presents herself as possessed of class and refinement. She is, however, born of the streets and has a ruthless streak that bares itself whenever she is cornered or is in competition to get something she wants. She is a capable thief and con artist, and is currently partnered with Cam Truuvik. He came up with their current scam, but she refined it to perfection."}},"items":[{"_id":"doacH62v7pTd3Xpa","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"MoJ8iSkpNLYQaCQB","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"D5XU5FhpCthHTRTG","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"TpGTTcTuOPVWL90K","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"h8w17kwyRjFEXTkW","name":"Bleshk Callor","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Bleshk Callor has been an intelligence agent all of his adult life. He has seen the best and worst that the calling has to offer, and the years of clandestine work have made him aloof, capricious, and generally strange. Despite his quirks, he is a dedicated and highly competent head of security, respected even by his enemies in the ISB. He values initiative, lateral thinking, and perseverance in an agent, and those who find themselves in his good graces could wish for no better chief and ally than the grizzled old Deaon."}},"items":[{"_id":"yXY6faVEeMDOKcOH","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"N2wB9JNpqlzb1AoC","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"xr9zJb6Dr7flc3bE","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"jO2F3G4s3jW8ZhVz","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Ip5lhK8KHZ9Vxy1A","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"SghqPUgZQ4x1CRFg","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"BclfGuvz6HG0QekD","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"fGty8zUi17r8uVzn","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
