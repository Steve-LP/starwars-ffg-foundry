{"_id":"SvJDmqsYD1RXudji","name":"Godon Netakka","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Rodian bounty hunter Codon Netakka is only a provisional member of Dobah’s crew. By the time Godon had trailed the smuggling gang back to the asteroid, his own ship was in such a state of disrepair that he had to abandon it and throw himself on Dobah’s mercy."}},"items":[{"_id":"Pjq1YuUKwo3wRwCY","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"7W0og1og9pvnrB4c","name":"Reinforced gauntlets","type":"weapon","system":{"damage":3,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Disorient 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
