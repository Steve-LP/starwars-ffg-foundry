{"_id":"OCMXCoGi74qrngjC","name":"Yeel Dresk","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Yeel has seen his triumphant sale of *Tragic Hope* turn from riches in credits to a ruin of a crashed starship. As his lack of repair skills is matched only by his stubbornness, he has yet to leave the planet. Now stranded in a roaring river as flood waters rise, Yeel is beginning to feel that perhaps he might finally be amenable to outside help."}},"items":[{"_id":"UU9Hu6Q8nNwklFjp","name":"Duelist blaster pistol","type":"weapon","system":{"damage":5,"critical":4,"range":"Short","skill":"Ranged: Light","qualities":"Accurate 2, Stun Setting"}}],"effects":[],"flags":{},"ownership":{"default":0}}
