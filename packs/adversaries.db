{"_id":"2ASzwe22CD6PD6dU","name":"Ink Spray","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per encounter, as an out-of-turn incidental, a Quarren may spit ink from a specialised sac within their gills, suffering 2 Strain to add :setback: to a combat check made by a character within Short range (under water, it adds :setback::setback::setback: to the combat check instead)."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2EgmkYVrkBiRovYy","name":"Senex, Krath War Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Unique Droid. Holocron Database & Combat Instructor, Senex functions as a Holocron party resource, but grants access to three skills: Charm, Knowledge (Lore), and Lightsaber.\n\nhttp://www.d20radio.com/main/galaxy-guide-masters-in-exile-senex-jedi-training-droid/"}},"items":[{"_id":"i2RqloD53VVnraoU","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"NwMQShabluyey1nv","name":"Built-in retractable blasters","type":"weapon","system":{"damage":5,"critical":3,"range":"Short","skill":"Ranged: Light","qualities":"Vicious 3"}},{"_id":"5AcU1XQwhhUqiKEw","name":"Dual lightsabers","type":"weapon","system":{"damage":7,"critical":2,"range":"Engaged","skill":"Lightsaber","qualities":"Breach 1, Superior"}},{"_id":"w2iVHtZHbKZ0XnV6","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"iiAUTwVCnuPOn4hT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"zcTOvYnz1xldPqKJ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"0t9xLzDkw8ME1PxT","name":"Secrets of the Jedi","type":"talent","system":{"description":"Senex may decrease the difficulty of checks made to construct or repair lightsaber hilts twice.","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2I1ClF2I66hfiGkW","name":"Quick Draw (Improved)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Twice per round, may draw or holster a weapon as an incidental."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2I1R0h1jZGJQEgDd","name":"Commanding Presence","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"At the beginning of an encounter with Tarkin, each enemy and ally within Medium range or in communication with him makes a :hard: Discipline check as an out-of-turn incidental. Allies who succeed add automatic :advantage: to any skill checks they make until the end of the encounter. If they succeed with :triumph:, they add automatic :success: instead. Enemies who fail add automatic :threat: to skill checks until the end of the encounter. If they fail with :despair:, they add automatic :failure: instead."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
