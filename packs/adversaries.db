{"_id":"LpqXGIYqf9BoKchC","name":"First Order Fleet Officer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Trained in secret shipboard military academies created by the remnants of the Imperial Fleet, the officers of the First Order Fleet often see their ships as their homes and have never set foot planetside. Highly trained leaders, these officers can synthesise highly complex tactical data and direct the forces beneath them with practised ease."}},"items":[{"_id":"7kbxAstUrLiy4RVj","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"yUyw7piHDQ4xAAnz","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"TyVFcC5o2kvpopun","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
