{"_id":"8DdvrZwULrUT8Pp2","name":"Republic Judicial","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Not ail Judicials made the transition to the Republic Navy at the outset of the war. Even at the height of the Clone Wars, the Republic needs peace officers to maintain law and order on its loyal worlds. The blue-uniformed Judicials of the Republic come from a range of backgrounds and homeworlds, but all received intensive training at the Judicial Academy. Judicials are empowered to enforce the laws of the Republic on member worlds and the spacelanes, and are more than capable of handling themselves if a suspect turns violent."}},"items":[{"_id":"iZmnFA2IVilxieN3","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"XYNgtJGEL2uimgCk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
