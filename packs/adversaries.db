{"_id":"Bb6nSC5jIvsSRDUd","name":"Makashi Flourish","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per encounter, as an action action, make an :average: Lightsaber (Presence) check. If successful, one Engaged opponent suffers Strain equal to :success: and the character recovers an equal amount of Strain. May also spend :triumph: or :advantage::advantage::advantage: to Stagger the opponent until the end of their next turn."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
