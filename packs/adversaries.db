{"_id":"2mwgaOuGzTsgBiSC","name":"R2-D2","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"cSunJ0cimYmchUFM","name":"R2’s fusion welder","type":"weapon","system":{"damage":5,"critical":4,"range":"Engaged","skill":"Melee","qualities":"Burn 2, Stun Setting"}},{"_id":"w99QMRYl6ZT6HFs2","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"YBMQqxCNiNJCSJHk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"zPNbX0j59xxGYRLh","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"6gcskZ8QMgtrd19T","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"qtWHI4LmdR4k2bk8","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"4vt6WV0uikirr3wC","name":"Hidden Storage 1","type":"talent","system":{"description":"R2-D2's body contains a hidden compartment that can hide small objects totalling no more than Encumberance 1. Checks to detect this compartment are :formidable:.","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2nM9S4TXzdc4GEps","name":"Wrix","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Wrix are huge, savage creatures with thick hides and long, sharp tusks. Incredibly powerful and savage, they seem to subsist solely on raw meat and rage, and are one of the few extant animal species in the galaxy that kill for sport. The average wrix stands around 1.5 metres high. They have huge, brutish, ugly heads with short snouts, red eyes, porcine ears, and broad mouths filled with long, tearing teeth. Their hairless skin is usually mottled brown, tan, and green (though black and even gold-coloured individuals are not uncommon) and appears stretched to near bursting over their powerful muscles. Corellian biologists are unsure from whence the wrix originates. They seem to have no natural ecological niche on Corellia, nor is there anything like them found in the planet’s fossil record. Some believe they are genetically engineered solely as competitor animals for underground fighting rings. Whatever the case, the population of wrix has steadily grown over the past few decades, causing much alarm in Corellia’s farming and ecological communities."}},"items":[{"_id":"l0pA32xGjupYP8NE","name":"Teeth and claws","type":"weapon","system":{"damage":10,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Vicious 2, Sunder"}},{"_id":"bdML4MguGZdn2NxG","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2oUNEoQuyoL3GmJa","name":"Inferior","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Generates automatic :threat: on all checks."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2oXAi2BqzWWkTcAP","name":"Partisan Fighter","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Whether seen as desperate freedom fighters or vile terrorists, these radical militants are prepared to take the fight to the Empire at any cost. The origin of the Partisans lies with that of the Onderon rebels trained by the Republic and Jedi during the Clone Wars. Few original members remain alive, let alone within the ranks. Regardless of origin, these fighters are fiercely loyal to their leader, Saw Gerrera, and zealously believe in the cause. They are prepared to die, and kill, to end Imperial tyranny. They favour ambushes and other guerrilla type tactics, with a favorite tactics being close range ambush by infiltration of the civilian population. That these attacks put local civilians at risk is a minor concern to the Partisans when compared to the titanic abuses of the Empire."}},"items":[{"_id":"sczeYgSX2vQV1N2M","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"0AMpI6VrCcDeLJSq","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2rnfeQaWisogNbOQ","name":"Infiltrate And Execute","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"May impersonate a known enemy’s voice to gain :boost::boost: on all Deception checks, but upgrades the difficulty once if also attempting to maintain a physical disguise (such as wearing an enemy uniform)."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
