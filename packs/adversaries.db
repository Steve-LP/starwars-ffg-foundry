{"_id":"9B0hndgEHoOGArrT","name":"Orange-Rated Constable","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Infrared-rated constables are still recruits, and red-rated constables are rookies, but most of the constabulary comprises orange-rated constables. These constables operate in teams of two, usually with a long-term partner who is a relative. Orange-rated constables often patrol a specific beat from within a speeder or guard a specific checkpoint or location."}},"items":[{"_id":"s65avgUpAVl5OeQR","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"MX62ZgtL1FmifQzt","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
