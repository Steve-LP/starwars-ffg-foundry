{"_id":"zNsqkMwgFCifKlp5","name":"Vodran Enforcer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The reptilian Vodrans are hardy and, by and large, slavishly devoted to their Hutt masters. While some resist the rule of the Hutts, most Vodrans are content to serve the overlords they view as divine."}},"items":[{"_id":"aGmh2AL6cUn0io3l","name":"Vodran hunting rifle","type":"weapon","system":{"damage":7,"critical":4,"range":"Long","skill":"Ranged: Heavy","qualities":"Cumbersome 2"}}],"effects":[],"flags":{},"ownership":{"default":0}}
