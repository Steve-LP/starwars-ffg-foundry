{"_id":"4qjId6FCL3h4UA8u","name":"Cadet Zare Leonis","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"An Imperial cadet and a resistance sympathiser, Zare Leonis came into contact with Phoenix Cell while a student at the Academy for Young Imperials on Lothal. He had enrolled at the academy to try and find his sister Dhara, who had disappeared from the same school previously. Following leads, Leonis feigned Force-sensitivity and accepted a transfer to Arkanis Academy. Throughout his search, he has remained willing to work against the Empire and aid Phoenix Cell. He has readily accepted the personal risks associated with working against the Imperial Academy system from within it."}},"items":[{"_id":"RcgKGG8sAQMY56qr","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
