{"_id":"TTmKqsLpKQFtcXf7","name":"Lt. Masi Qual, Bothan Spy","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Masi is a young Bothan with beige fur covering her 1.6-metre-tall body. She usually dresses in her lieutenant’s outfit and can be often seen barking out orders to newer members of her intelligence cell.\n\nCold and calculating at all times, Masi has little time for those she perceives as beneath her in stature. She grew up with a chip on her shoulder, and nothing has diminished that attitude. She has had success in the Alliance, and the praise and recognition she receives further fuels her belief in her own superiority."}},"items":[{"_id":"NIulvN5tNBRXmIKn","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"FWU8mbehx118Y3C3","name":"Throwing knife","type":"weapon","system":{"damage":3,"critical":3,"range":"Short","skill":"Ranged: Light","qualities":"Limited Ammo 1"}},{"_id":"dXZ3xnVpvAKvKOmt","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"TUtjxiRJu8VSfARi","name":"Kaaten","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The kaaten is a one-and-half-meter, bipedal, semi-intelligent predator found on Felucia. It is a mimic, able to use the Force to appear to its prey as some one familiar to the individual the kaaten is hunting. Kaaten are solitary, with well-defined territorial lines that are crossed only when they mate. Therefore, they have not developed any kind of social structure or language. A kaaten can appear as a lost loved one, a companion or friend, or a member of its prey’s species if the kaaten is hunting something non-sentient. Once the kaaten has lured its prey close, it strikes with its claws, attempting to quickly incapacitate its unsuspecting quarry."}},"items":[{"_id":"y8LGzHb3oGndcvpZ","name":"Claws","type":"weapon","system":{"damage":7,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Pierce 2"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"TVx30lxRcmdu9SzG","name":"Heightened Awareness","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Allies within Short range add :boost: to Perception and Vigilance checks; allies in Engaged range add :boost::boost: instead."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"TXcBc31n9BQs8WR8","name":"Lead from the Back","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per round when an enemy makes a successful combat check targeting the character, the character may spend one Destiny point to perform the Lead from the Back incidental. The character chooses one allied NPC subordinate within Short range, who becomes the target of the attack instead. At the GM's discretion, the character may select an allied NPC at a greater distance if they are between the character and the attacker."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
