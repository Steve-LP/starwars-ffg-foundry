{"_id":"R6JsOaPvSA3ZpCgy","name":"Corellian Bloodhound","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Corellian bloudhounds are often kept as pets and guard animals, though packs of wild bloodhounds occasionally roam in areas where they’ve been transplanted. Unlike most canids, they rarely bark or yelp. When they do bark, however, the vocalization has a whisper-like quality. This behaviour is instinctual, as Corellian bloodhounds in the wild rely on stealth to ambush their prey. At up to one meter in length, Corellian blooodhounds are slim and agile, relying on stealth and speed rather than brute strength to take down prey. A fine coat of tiny quills covers their body, and their head features an oversized snout to aid in scenting prety, and a mouth lined with sharp, dagger-like teeth."}},"items":[{"_id":"HPbOQeMldxk2gQiG","name":"Teeth","type":"weapon","system":{"damage":3,"critical":4,"range":"Engaged","skill":"Brawl","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"R6sNXLqokCO7COoZ","name":"Bric","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"uLPQN1hljIRCxBJJ","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"1LaI2f9p0hVV48sy","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"xDMBkUlTCr89HIo9","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"PV0g8seGPukYLPg0","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"h5HYnu8MjwxTKb7t","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"HWRJ4bJQGfKzisag","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
