{"_id":"vz9RviLXBfXFFQ0D","name":"Phantasmal Beast of Moraband","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"These prowling beasts feed on terror rather than flesh. Whether they are animals twisted by the dark side or illusions of the Force, it is impossible to say."}},"items":[{"_id":"geEi0Q3AAlBvipGv","name":"Claws and teeth","type":"weapon","system":{"damage":6,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Ensnare 1, Vicious 2"}},{"_id":"3CbLlVxHeaFDoDr9","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
