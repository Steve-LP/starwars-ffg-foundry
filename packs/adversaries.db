{"_id":"4L7W9KcQpWfboxvt","name":"Sense the Scene","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session as an action, may make a :hard: Perception check at a crime scene, adding {ranks|Force Rating} to the roll. Spend :forcepip: to identify the emotional state of one person involved."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"4O7lcsKWR0lRfbPh","name":"Liddy Ravora","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Liddy used to waitress at Bell’s Cantina, a veteran spacers’ hangout. However, once she recognised the value of information, she became an amateur infochant. Liddy amassed a small fortune trading secrets and purchased the cantina a decade ago. Spacers trust her, and she has been known to help many a down-on-his-luck spacer find work. Still, her first loyalty is to her top-paying customer, Gormo the Hutt."}},"items":[{"_id":"YFVPlAc7to5PylCM","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
