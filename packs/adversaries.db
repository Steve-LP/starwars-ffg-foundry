{"_id":"LJMnYCwBsL7vNIGj","name":"Keen Senses","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Thanks to their finely honed senses of sight and hearing, they gain :boost: on all Perception checks."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"LJbskkDPNS9TUZpF","name":"Tik, Ranat Leader","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Tik is larger and stronger than his Ranat companions, and they obey him without question. His fur is a deep and dirty yellow, tinged with grease and other, fouler substances. He is a cunning adversary who seeks to maintain his lofty place in the tribe by whatever means necessary."}},"items":[{"_id":"jmXhg1K7pb3mGHQx","name":"Bite","type":"weapon","system":{"damage":0,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Pierce 1"}},{"_id":"IFglpIFBj0pco1Ht","name":"Makeshift spear","type":"weapon","system":{"damage":0,"critical":3,"range":"Engaged","skill":"Melee","qualities":""}},{"_id":"ztfRdjrbkhCpXi7M","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"6TeIor1ll5P2qegQ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"LK4B2sgUMI71CJkM","name":"Sarlacc Sweep","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As an action, make a Lightsaber combat check with +1 difficulty against one engaged target; spend :advantage::advantage: to hit one additional engaged target."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
