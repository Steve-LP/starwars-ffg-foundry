{"_id":"1uls07tLWMf5YFpg","name":"Nosh Droma","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Nosh Droma is a conniving, venal, greedy, and untrustworthy young Chadra-Fan with lavish tastes and a known gambling problem. In fact, it was his gambling and inability to live within his means that allowed the ISB to turn him. While he is relatively intelligent, he is neither as smart nor as clever as he thinks he is. He is relatively weak-willed and easily manipulated, and he has a raging entitlement complex that makes him believe he should be placed higher in Alliance than he is. He will not hesitate to beg for his life or run like a coward when confronted, and there is a high likelihood that his ISB handler will burn him if things get too hot."}},"items":[{"_id":"T5sCsAByTH9QZEQe","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"dhlSFuDr8B46uIhP","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"77t5YEOXwC1pCMR1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"8LbAbKDFwEPDDCQI","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"SnSGj7eTRBvlPyyN","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"tENtzsq2O8JHCb3h","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ZJYv52a5JHsj3VY7","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"be8qgmVK6fnM0Sm5","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ROjDCFKOZnrsIDMc","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
