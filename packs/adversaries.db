{"_id":"CyymvAM4kYPywdvq","name":"Peekay 4 and Peekay 7","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"These two are short and stocky general purpose droids who handle manual work and mine labour. These two droids proved somewhat resistant to the indoctrination of R2-B7, EV-8D3 has taken the rather cynical step of fitting them with restraining bolts, effectively coercing them to follow his order.s"}},"items":[{"_id":"ObNVDCHz8jvuYqj4","name":"Mining beam drill","type":"weapon","system":{"damage":5,"critical":3,"range":"Engaged","skill":"Melee","qualities":"Vicious 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"CzOZMBV4Gzh1T9ER","name":"Aris Shen","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Arend’s point person (and his daughter) to make sure the PC’s are eliminated."}},"items":[{"_id":"XAOiCVNuXk3sRAFw","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"9umBFtgsu2CA5ahi","name":"IR-5 “Intimidator” blaster pistol","type":"weapon","system":{"damage":5,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":"Auto-Fire, Inaccurate 1"}},{"_id":"bGcv5VDYtRgSTVzK","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"GlKNGfRl5ypn31Tv","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"QNGRV0YlJ6czzjXo","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"8MM7PkjN9cMVJYOS","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
