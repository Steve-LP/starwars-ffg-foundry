{"_id":"p2WuVmuWuoVCLGFF","name":"“Boss” Trelon","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Trelon has gone by “Boss” since Jerserra assigned him as commander of her smuggling/information-gathering group on Toydaria, and he has lived up to the nickname. He’s developed a wide net of informants through intimidation and blackmail in order to further her cause (and his own). While loyal to Jerserra, he’s also ambitious. He hopes to impress her enough with his work that she advances him to greater power within her operation."}},"items":[{"_id":"ETWuowhtH5RsIYiM","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"tEIAnfafuWPWsMXT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
