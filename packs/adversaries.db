{"_id":"aYXpDXKKv2JtWoQD","name":"Marus Grayson, Corrupt Imperial Exchequer","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"J2HFu4UxKV3tmYqX","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"LI0D70bTxTXNvHXi","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"w27ol5hbXRmtjm49","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"aaqRcxuf3WImcSZq","name":"CSA Intrusion Specialist","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Corporate Sector Authority’s vast holdings make it an attractive target for slicers. The CSA’s Security Police, commonly referred to as the Espos, employ a number of slicers to counter these threats. Elite slicers seem to have a natural ability to foil security protocols, guess passwords, and find backdoors in computer code. Their abilities seem almost supernatural, and in a few rare cases, maybe they are."}},"items":[{"_id":"a4izSGGcNJprHkcC","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"HAfrvEXJdcjV9JZ2","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"GErHI5XNurZTOnFS","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"acxpPtF4WRayzqpB","name":"Mimbanese Resistance Sniper","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Striking fear into the hearts of the Imperial Army on Mimban, it is often the blaster-burned corpse of an officer that is the first sign a Mimbanese sniper is in the area. Resistance snipers leverage their home turf advantage, effectively using navigation and camouflage to turn the mud into protection from Imperial observation and fire. These superior skills allow snipers to take optimum positions, laying in wait for the best targets to emerge.\n\nThe legendary Clone Commandos of the last war trained many of these snipers, instructing them to fire at Separatist organic commanders or tactical droids instead of the rank and file. The Mimbanese have adapted this tactic, preferring to eliminate officers and senior NCOs where possible. Given the Imperial Army infantry is made up of washouts from stormtrooper training, troublemakers booted from the Imperial Academies, and single-term enlistees trying to earn a credit, this decapitation tactic has proven exceptionally effective for the Mimbanese."}},"items":[{"_id":"JY6saEfSa9PRJG1z","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"SWijv3pcmvMDN6Uk","name":"Sniper rifle","type":"weapon","system":{"damage":10,"critical":3,"range":"Extreme","skill":"Ranged: Heavy","qualities":"Accurate 1, Cumbersome 3, Pierce 2, Slow-firing 1, Telescopic Optical Sight"}},{"_id":"miikOsN1ZdkFSFwQ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"Oyw80dlWBKUer2EW","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"ai53RFPjy6klYpns","name":"First Order Specialist Trooper","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Units of First Order stormtroopers are accompanied by specialist troopers carrying heavy weaponry designed for specific engagements. Flametroopers wield terrifying flame projectors to drive entrenched enemies out of cover, while specialists carrying light repeating blasters lay down a hail of blaster bolts to suppress even the most courageous foe."}},"items":[{"_id":"K2LtcK9qjjLTLf1R","name":"Flame projector","type":"weapon","system":{"damage":8,"critical":2,"range":"Short","skill":"Ranged: Heavy","qualities":"Blast 8, Burn 3"}},{"_id":"WonJK34PJZojdSRU","name":"Light repeating blaster","type":"weapon","system":{"damage":11,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Auto-Fire, Cumbersome 3, Pierce 1"}},{"_id":"waRRobNT8MYUARbR","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
