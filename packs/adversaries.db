{"_id":"ZWhXHRGTBUCCNW9l","name":"Hutt Majordomo","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Many Hutt clan leaders employ a majordomo, or master of the house, who manages the daily business of the Hutt’s holdings. They arrange their lord’s schedule, decide who can meet with him and when, and can even speak on their master’s behalf regarding matters of lesser importance. Humans, Rodians, Twi’lek, and Weequay are commonly found as majordomos, but it is not unheard of for an up-and-coming Hutt to serve as one for a time as well."}},"items":[{"_id":"Xip2ZPdmnS86ga48","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"jZINr3tEvFy8NUV5","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"zJksRGF8PfGCDerx","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"ZYrRzCwFHY4EWzCO","name":"Gut-Guro","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Gut-Guro’s age is hard to estimate as he has the same ruddy and wrinkled features common to most members of his species. He wears his hair in three long braids and dresses in the rough quilted leather that serves as traditional Weequay garb."}},"items":[{"_id":"daJpcJqJr1CXZcSm","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
