{"_id":"mnyB8jAOBZe24u2m","name":"HK-series Assassin Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Produced by the infamous Czerka Corporation, HK-series Assassin Droids were ruthless killers programmed for unmatched lethality. Despite their sinister appearance and psychopathic behavioral programming, HK-series droids are capable of serving as protocol droids. This allows the droid a degree of plausible deniability. This protocol capability allows the HK-series droid to infiltrate by hiding in plain sight. Once in position, the droids activate their higher level assassination protocols and eliminate their targets with maximum prejudice."}},"items":[{"_id":"ZJzGdU4L2KJOjgJb","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"Ckc2zrLSGOxYYmT1","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"9EQL0S5zbE2zia7K","name":"Wrist-integrated flame projector","type":"weapon","system":{"damage":6,"critical":2,"range":"Short","skill":"Ranged: Light","qualities":"Burn 3, Blast 6"}},{"_id":"2UDQ2fXIKrftDcl1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"JgN8Clm4Tzqkd16P","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"i2WZUvJRnBTYGE8u","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"i12y0Z9WDdUmZrnv","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"quI4jEFUzw593XLk","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
