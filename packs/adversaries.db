{"_id":"BF5DwMcTGdU8mQKd","name":"Strong Arm","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Treat thrown weapons as if they had one step greater in range, to a maximum of Medium range."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"BKyw6eH1wdatWA5p","name":"Contraption","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session, as an action, may make a :hard: Mechanics check to fashion a device to solve a current problem using just the tools and parts on hand."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"BMYyeNUWPuIg2v6n","name":"Olfactory Perception","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Gain :boost: on all Sur­vival checks made to track prey, and adds :setback: to enemy Stealth checks made against the vrblthers."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"BNDDNxKcZOOSVVMu","name":"Force Power: Misdirect","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":":forcepip:: Make one target within Short range unable to perceive one Silhoutte 1 object, or perceive one non-existent Silhoutte 1 object; spend :forcepip::forcepip: to create up to six additional illusory people or objects; spend :forcepip: to increase the number of affected targets by 3."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"BPcPiKHyhAABoFAG","name":"Sector Ranger","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"There are a great number of similarities among the majority of law enforcement personnel, but few are cut from the same mold as the Sector Rangers. These individuals are authorized by the Empire, through the local sector government, to seek out any and all viola tions of law in an entire sector of the galaxy. In many ways, sector rangers are the opposite of smugglers; fiercely independent and possessed of a tremendous degree of autonomy and ingenuity But instead of selfish desires for wealth, they possess a strong desire to see justice served. Sector rangers rarely work well with others but their tenacity can hound a lawbreaker across a sector and back, making them among the most carefully avoided authorities in the galaxy."}},"items":[{"_id":"Jh9mezHPf9WCgoiO","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"zojAgcCIEeWn3niS","name":"Scoped blaster rifle","type":"weapon","system":{"damage":9,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Stun Setting, Sniper Shot"}},{"_id":"j2udIzb5jxxAfTSI","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
