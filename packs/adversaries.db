{"_id":"LAOAvMeAyd9KUOEa","name":"Gerk, Houk Supervisor","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Gerk is the biggest and the strongest of the slavers, so naturally, he’s in charge. It’s his responsibility to negotiate with scrap buyers and to replenish the workforce when too many slaves die. While intelligent for a Houk, Gerk often lets his cruelty get the better of him."}},"items":[{"_id":"bfGjZzHjw5Nz5fIY","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"SF8EaeGImaDv2uxv","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
