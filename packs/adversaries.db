{"_id":"vCVgzMgFuRkjr5gW","name":"Luke Skywalker","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"Yp2Tw7mGiyLH19iG","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"XuzL2QhVORdVaXHt","name":"His father’s lightsaber","type":"weapon","system":{"damage":10,"critical":1,"range":"Engaged","skill":"Lightsaber","qualities":"Breach 1, Sunder, Vicious 2"}},{"_id":"VCjBHp7vdRWV6k74","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"oW3W8GTw5xOs0LzR","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"iIki0XbB9F0a1w4p","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"dnEhq71gE2VoSLdi","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"5A8JnqMIIEzG1WHT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"BWliuqgH6EOVH73Y","name":"Exhaust Port","type":"talent","system":{"description":"Before attacking a starship or vehicle, Luke may spend 1 Destiny Point to ignore the effects of the Massive rule for the attack.","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"vDPFwer9xQ5XKXjR","name":"TC-Series Protocol Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The TC-series, produced by Cybot Galactica, is less widely known than the more affordable 3PO models from the same manufacturer, but it remains one of the most highly regarded lines of protocol droids. Officially registered as a variant line on the more common 3PO models, the TC-series is actually a solid upgrade in most aspects. The differences are not apparent to the casual observer, as the two droids are nearly identical visually. Instead, the improvements of the TC-series lie in two key areas of programming.\n\nFirst, TC units have benefited from increased design attention, giving them more stable and helpful personalities after some 3PO-series droids were reported to develop eccentric and grating personalities. Secondly, and perhaps more significantly, the TC-series is equipped with a more advanced version of the TranLang III communications module used throughout the protocol droid market.\n\nWhile almost any protocol droid is programmed with a vast array of languages and the capacity to decipher new ones with impressive speed, the TC-series excels above its competitors. The TranLang variant used in these droids uses adaptive programming to improve the unit’s grasp on a language throughout a conversation, enabling them to attempt communication after only a few words spoken by a new species or culture."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"vENPaFDmEXhvL11D","name":"Azurdactyl","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The aquamarine, four-winged azurdactyls are a common sight above the Jagomiri canopies, where they are known to play with each other and fly alongside starships. They appear to be somewhat intelligent, perhaps even semi-sentient, and some Rebels report that they have helped hunt for food in exchange for a share of the catch. Resolute Base’s xenologists hypothesize that the avian species may be related to the Alderaanian thranta or Kaminoan aiwha, albeit distantly."}},"items":[{"_id":"KjN9MWhi0SvTT5yp","name":"Claws","type":"weapon","system":{"damage":5,"critical":5,"range":"Engaged","skill":"Brawl","qualities":"Pierce 1"}},{"_id":"d7R2WjXY8p0bI3B2","name":"Wing buffet","type":"weapon","system":{"damage":4,"critical":4,"range":"Short","skill":"Brawl","qualities":"Knockdown"}},{"_id":"WEAewI9Z9asc6hQw","name":"Dive bomb","type":"weapon","system":{"damage":10,"critical":3,"range":"Medium","skill":"Brawl","qualities":"Prepare 2"}},{"_id":"nfep9sMqiZJ2ngV0","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"4cytQdVBf8HHjJwr","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"vFYObFRekyze8TzO","name":"Gaffi stick","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
