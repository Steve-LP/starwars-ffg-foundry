{"_id":"48DPp2kLxAYEqHV8","name":"Graf Lind, Former Pirate","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Graf is a human male in his fifties, though his lifestyle has ages him prematurely. His hair is long, gray, and unkempt, and his blue eyes are dull—unless he’s interested in something. His cheap prosthetic leg—all he could affford following the tender mercy of the Veiled Sorority—makes him walk with a noticeable limp, and often uses a polishes bubse wood cane for support. Graf hsd largely given up on life, whether he admits ir ot not, and has decided to drink himself to death. Despite this, he fantasizes about returning to the Sorority someday, for he believes the best years of his life were spent there."}},"items":[{"_id":"V7i3ZGmjjhrEhh7Y","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"bp0WOFf6790R376d","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"jmJlYU7w41xnfIaA","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"hIgdDsUJH436COOA","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
