{"_id":"teWIQQ9mbavIhbn4","name":"Lasting Inspiration","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per session, make a :hard: Leadership check when giving orders to an ally; if the check is successful, the ally gains one :boost: for each :success: which can be split up and added as desired to any skill checks the ally makes until the end of the session."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"teklGB0F7NaGNPa7","name":"Boddah Venik Rin","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The boddah representing the Player Characters is a middle-aged Zabrak known as Venik Rin. Rin once survived being mauled by a rancor, which left him scarred and twisted as a result. His horns are cracked, his skin marred with hideous scars, and his body is twisted. He walks with a pronounced limp, but he speaks with a voice that is both strong and confident. Rin is comfortable working as a puppet for his unnamed master, so long as the spice that dulls his pain continues to trickle in."}},"items":[{"_id":"kluiHI95mMflDdzC","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"YWlSpDJUU63wlIaq","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"tfKqteFhtchw35hz","name":"Riar Air Patrol Pursuit Drone","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"These disc-shaped drones are fast, but not particularly well armoured. They are designed to capture suspects rather than destroy their craft, and so are armed with potent ion mesh arrays. As they are relatively cheap but effective, Riar Starport authorities use them in high number to ensure that air traffic routes remain clear."}},"items":[{"_id":"GwyKzIu8qJPUAtnH","name":"Ventral turret-mounted ion mesh array","type":"weapon","system":{"damage":5,"critical":3,"range":"Engaged","skill":"Ranged: Light","qualities":"Ion"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"tfS0KsZrBjLgJEYF","name":"Carn Truuvik","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Though by no means a crime lord, the human Cam has achieved some success in the Blue Sector. He is very charming, able to put forth a congenial and disarming demeanour even when he has someone at blaster point. He always presents the choices he intends for his marks and his prisoners in the same manner—this is what is best for them, and it’s a “win-win” for everyone."}},"items":[{"_id":"n2AWR9vG4KJs10xh","name":"Filed blaster pistol","type":"weapon","system":{"damage":6,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":"Stun Setting"}},{"_id":"IzTuTLMVhPSEdec9","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"uczWtbdCIiuPEJrQ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
