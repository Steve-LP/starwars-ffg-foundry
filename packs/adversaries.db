{"_id":"R59suGUVbDzh46nx","name":"Stormtrooper: Shoretrooper","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Shoretroopers are Imperial stormtroopers trained in amphibious landing combat in coastal environments. They wear a modified version of stormtrooper armour over a heat-modulating dry suit that protects them from adverse atmospheric and geographic conditions where land meets water. They are typically stationed on watery worlds like Mon Cala or Scarif where their training and specialised equipment allow them to operate with little to no difficulty in and out of the water."}},"items":[{"_id":"IclsR8H9P0gzVjJc","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"mjmAf4VYcUaLrYSb","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"5Xr9PsdkIytn2bTU","name":"E-22 blaster carbine","type":"weapon","system":{"damage":8,"critical":3,"range":"Medium","skill":"Ranged: Heavy","qualities":"Cumbersome 2, Linked 1, Stun Setting"}}],"effects":[],"flags":{},"ownership":{"default":0}}
