{"_id":"dBYhLhZ2E5vgOx31","name":"Sala Vindako, Human Beastmaster","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Sala has a penchant for hunting, capturing, and training beasts. Her reputation as a beastmaster is well known, and she makes a point not to unnecessarily abuse the animals in her care. She wears a thick leather coat studded with animal teeth, and can move with impressive agility despite her bulk."}},"items":[{"_id":"jSmhandIw11Nfxid","name":"Beast goad","type":"weapon","system":{"damage":6,"critical":4,"range":"Engaged","skill":"Melee","qualities":"Disorient 2, Pierce 2"}},{"_id":"t1fOiWOGMkWLhCvK","name":"Soporific-tipped bow","type":"weapon","system":{"damage":5,"critical":4,"range":"Medium","skill":"Ranged: Heavy","qualities":"Limited Ammo 1, Stun 4"}},{"_id":"QSFQ5UYhOy4FoTju","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"XRnARZrSAVhSBzxZ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"dCSPUhgRjUNKSFqC","name":"Politician","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Denizens of the Core Worlds include former members of the Imperial Senate, recently disbanded by the Emperor, who remain in the area in hopes of maintaining their political influence, wealthy lifestyle, and general connection to the goings-on of the Empire as a whole. Under normal circumstances, these individuals venture into the more rural regions of the galaxy only very rarely. Even those who represent the Outer Rim Territories can scarcely find time for such a lengthy journey. When such individuals do venture out into the galaxy at large, it is typically to serve their own needs rather than the needs of anyone else. A rare few are genuinely interested in the fate of their constituents and seek to aid the Alliance in restoring a more compassionate government, but most have benefited far too much from their association with the Empire to willingly aid in its overthrow."}},"items":[{"_id":"KwGNP9y5DvfdfRAh","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"B1m2Fnund5UgV3Fg","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
