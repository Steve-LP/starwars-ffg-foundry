{"_id":"zbvJu3onMWMPIdxC","name":"Talz Warrior","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Talz living in Vlemoth Port’s northern tundra are generally peaceful but very xenophobic. Thanks to frequent clashes with slavers, they view intrusions by outsiders as acts of aggression. Talz warriors tend to own at least one hunting spear which they can either throw or use as a melee weapon. Their bone knives, designed to skin animals, are also useful in combat."}},"items":[{"_id":"cHDShG4Kuy9BLX01","name":"Hunting spear (thrown)","type":"weapon","system":{"damage":9,"critical":3,"range":"Short","skill":"Ranged: Light","qualities":"Limited Ammo 1"}},{"_id":"yfNwUKs7yCvCXs2E","name":"Hunting spear (melee)","type":"weapon","system":{"damage":7,"critical":2,"range":"Engaged","skill":"Melee","qualities":""}},{"_id":"nZmovFVnfnm0m53r","name":"Knife","type":"weapon","system":{"damage":5,"critical":3,"range":"Engaged","skill":"Melee","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"zcoOrAXd4MjGFvL1","name":"Excellent Climber","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Once per game session, the thaelo may reroll any one Athletics check made when climbing."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
