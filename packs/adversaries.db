{"_id":"VTA6beE7TBs8HABK","name":"Jocasta Nu","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[{"_id":"F3wzJ2h7N4fBbAk7","name":"Jocasta’s Lightsaber","type":"weapon","system":{"damage":"8","critical":"2","range":"Engaged","skill":"Lightsaber","qualities":"Breach 1, Sunder"}},{"_id":"20nls2TOqv0wLO0h","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"QaFSpzpvLq53T76A","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"212q7GgRIaNpDRgA","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"vYyaM1QZbL0fsYFZ","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"5XtbZEDx2O8CzpHY","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"XWulNQm5GVY7GY4P","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"VUwxpBxazKflLbUx","name":"Tusken Raider Huntsman","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Tusken Raider Huntsmen are responsible for the day-to-day survival of their clan. Skilled hunters, they prowl the twisted canyons and rocky flats of their territory hunting womp rats, eopie, dewbacks, rontos – and even human settlers.\n\nIn addition to their Gaffi Sticks, a Tusken Raider Huntsman carries his long-barreled slugthrower rifle known as a Cycler Rifle. Antiquated in the extreme, these loud, cumbersome weapons are still capable of taking down prey - particularly if the Hunstman has time to line up his shots from a good distance.\n\nIntimately familiar with their hunting grounds, Tusken Raider Huntsman are excellent at chasing down prey and cutting it off at the pass - as represented by his “Outdoorsman” and “Shortcut” talents. An unwary animal, or human interloper, can find themselves ambushed and outpaced if they stumble into Tusken Raider territory.\n\nA favorite tactic of Tusken Raider Huntsmen is to snipe foes from long range, then disappear into the terrain, only to harry their foe again later from a different angle. In this way, even a few Tusken Raiders Huntsman are capable of holding off much larger numbers."}},"items":[{"_id":"0mf9tOs4ttbGZCDl","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"r2iV1HgkPloedtA9","name":"Slugthrower rifle with telescopic optical sight","type":"weapon","system":{"damage":7,"critical":5,"range":"Medium","skill":"Ranged: Heavy","qualities":"Cumbersome 2, Sniper Shot"}},{"_id":"5xtQ43CRS6o9eQq3","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"W0SAR4yN3bbmyXXA","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"IK648Sym73YL92mD","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"WN9PhzLV7wcdpXSh","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"IbtiUscA7OA3hZGC","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
