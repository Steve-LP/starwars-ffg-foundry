{"_id":"SwtIL9XHoDbHPZo7","name":"Gorensla Weequay Enforcer","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Gorensla kajidic has many blasters-for-hire on its payroll. Most don’t survive their first assignment, but there are always more to be found. The clan uses Weequay enforcers quite often, some of whom have already been operating as bounty hunters or bodyguards."}},"items":[{"_id":"OLVKUm4IZwgAdNSK","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"izVcR58eUm0AZOpG","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
