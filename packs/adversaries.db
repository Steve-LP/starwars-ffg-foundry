{"_id":"A7IpHa0WwPNZp6Eq","name":"Bypass Security","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Remove {ranks|setback} from any Computers or Skulduggery check to bypass security."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"A7dcylc3Nd1XqcwN","name":"Tunnelling Garrix","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The Jagomiri tunnelling garrix lives deep under the surface of the planet, emerging only to feed or defend its network of tunnels. This massive predator subsists on the large, meter-long grub worms that nest widely throughout the rich soil of the planet, though the garrix eats many other creatures if it can sink its fangs into them. The creature is blind, relying on its sense of smell and the vibrations around it to navigate through the dirt under the swamps. It is innately cowardly, and flees if it sustains more than 15 wounds."}},"items":[{"_id":"FZu2YhTtSOpQ3uPW","name":"Sideways slam","type":"weapon","system":{"damage":5,"critical":4,"range":"Short","skill":"Brawl","qualities":"Blast 4, Knockdown"}},{"_id":"LCgYWIqFWHKOLs9L","name":"Garrix smash","type":"weapon","system":{"damage":8,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Disorient"}},{"_id":"EwOCGZ5efeKKTI3M","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
