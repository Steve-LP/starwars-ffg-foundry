{"_id":"zm7dEzNuUhGECWlk","name":"Camouflaged (Jungle)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When in jungle environments, add :boost::boost: to all Stealth checks."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"zn3NORBoR2K4vg5x","name":"Inspiring Rhetoric (Improved)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As an action, may make an :average: Leadership check; each :success: removes one Strain or Wound from one ally in Short range; spend :advantage: to remove an additional Strain or Wound from an affected ally; all affected allies add :boost: to all checks for two rounds."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"zpVAkkL0DGcO0qqH","name":"Aurean Vulture","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"With a wingspan of more than four metres, an Aurean vulture won’t hesitate to swoop down on a humanoid for a chance at a solid meal. The creature has excellent long-range eyesight, enabling it to find prey while it drifts on warm updrafts over the planet’s desert lands. Flocks follow their prey for days. Then, at the height of the day, they dive in from the angle of the sun, hoping to blind their targets long enough to slay them."}},"items":[{"_id":"kPdhRT48DLv3AcMF","name":"Beak and talons","type":"weapon","system":{"damage":4,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Vicious 2"}}],"effects":[],"flags":{},"ownership":{"default":0}}
