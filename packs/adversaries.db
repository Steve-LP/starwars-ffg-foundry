{"_id":"2gjjRInXnJIokaks","name":"Guardian Police Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"GU-series “Guardian” police droids were the primary law enforcement droids operated by the Coruscant Security Force during the final years of the Republic. Designed and built by Cybot Galactica specifically for the CSF, countless thousands of these droids patrolled the sprawling upper levels of Coruscant’s Galactic City for generations. While in service GU-series droids gained a reputation as solid and level-headed, if unimaginative, law enforcers. They were programmed for various police work, such as patrol, peacekeeping, crime scene investigation, detective work and riot control. Although they were reliable, the GU-series droids suffered from a lack of initiative. Clever or dedicated criminals could usually out think them with little difficulty."}},"items":[{"_id":"HInhFi52PqW2RKlO","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"nCnrmEpNDUmqXaFs","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"cknPDO5GUfO29TcF","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2hZ2ipOcQJBczw6X","name":"Regeneration","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When recovering from wounds via natural rest or in a bacta tank, recover 1 additional Wound; first-aid, medical treatment, and stimpacks do not result in recovery from an additional wound; Trandoshans can regrow lost limbs, though it usually takes at least a month before such limbs are usable."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2i6KV0gpbbojoXGy","name":"Stunning Blow (Improved)","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"May inflict damage as Strain instead of Wounds; may spend :triumph: on Brawl checks to stagger target for 1 round per :triumph:."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
