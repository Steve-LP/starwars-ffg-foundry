{"_id":"BgMoq7fIy9hEU7PK","name":"Firefighter","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"May make an :average: Athletics check to extinguish a fire; success extinguishes the fire within a number of rounds determined by the GM, and additional successes may reduce the time needed to extinguish the fire. Particularly large or dangerous fires may require more difficult checks at the GM’s discretion."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
