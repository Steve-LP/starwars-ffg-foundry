{"_id":"xjwc75ewDvbXEjtw","name":"Karazak Acquisition Specialist","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Careful planning goes into every potential Karazak Slavers’ Cooperative operation. Acquisition specialists scout planets and hyperspace routes all over the Outer Rim, looking for new markets and “product species.”"}},"items":[{"_id":"Sgl28GFwIWMfI2A7","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"yGTHknfNg5bpTMWn","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"xoiCXgLJqi96LOkp","name":"Talz Hunter","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The best hunters in any Talz tribe are like ghosts on the tundra, ambushing their prey from within snowdrifts, or slaying a creature with a spear from thirty metres away. The tribe’s very best hunter often aspires to the position of chieftain, a right earned through single combat."}},"items":[{"_id":"A92JOPTqucAI0bnE","name":"Hunting spear (thrown)","type":"weapon","system":{"damage":9,"critical":3,"range":"Short","skill":"Ranged: Light","qualities":"Limited Ammo 1"}},{"_id":"XTQbVIxuncqLMUgl","name":"Hunting spear (melee)","type":"weapon","system":{"damage":7,"critical":2,"range":"Engaged","skill":"Melee","qualities":""}},{"_id":"Swuk8toXFL0wh5kq","name":"Knife","type":"weapon","system":{"damage":5,"critical":3,"range":"Engaged","skill":"Melee","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"xqeMlBCFcLSim50G","name":"Asajj Ventress","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"An agile fighter from Dathomir, Ventress is one of Dooku’s most trusted agents. Sold into slavery on Rattatak as a child, she became stranded after her captor died. Jedi Knight Ky Narec found and raised her, taking her on as his Padawan; however Narec died before informing the Jedi Council. Bereft, Ventress gave in to me dark side, becoming the ruling warlord of Rattatak. When Dooku found her, he immediately recognised her potential. As Dooku’s apprentice, Ventress acts as his dark agent, often wielding her dual lightsabers against Kenobi and his allies."}},"items":[{"_id":"jsn0egaIySn3Cg22","name":"Ventress’s Twin Lightsabers","type":"weapon","system":{"damage":9,"critical":2,"range":"Engaged","skill":"Lightsaber (Agility)","qualities":"Breach 1, Defensive 1, Sunder, Vicious 2"}},{"_id":"fzxN0JD4r3U8J6Yt","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"4wHo58BJeRViAjbr","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"r2nIaINBYk6b1A5c","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"zLfFIxvZXlEssndm","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"HAXTJ4BuOGRj787G","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"6SyOAimtk1apeBOn","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
