{"_id":"26NElDqIJDCSXn3c","name":"Detect Force-Sensitivity","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The vornskr may make an :average: Perception check to detect all Force-sensitive creatures or characters with a Force rating within Medium range; this ability functions regardless of intervening terrain or material."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
