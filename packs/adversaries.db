{"_id":"lkJWgYgB28ih6ye8","name":"Bio-Cybernetic Enhancement","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"A Hydroid Medusa is immune to the effects of the Breach and Pierce item qualities, but is susceptible to the Ion quality. When targeted by weapons with the Ion quality, the Medusa’s Soak value is reduced to 8."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"lkU2hO49Bi8C7lgP","name":"“Zekra Fol”, ISB Operative","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The woman claiming the name of Zekra Fol is a slim, dark-haired figure who moves with an effortless elegance. She wears fashionable but conservative clothing in her cover identity, favoring suits that provide easy movement. She carries a briefcase with the Outer Rim Exploratory Mining Corps logo emblazoned upon it. If openly acting in an official capacity, she trades her corporate garb for the uniform of the Imperial Security Bureau and wears her holdout blaster in a clearly visible holster at her hip."}},"items":[{"_id":"ZkEGNa4E0eKPLVGQ","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"nBu31y4jkOsvZlDf","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"F3AnV39IZ416xtbu","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"9A4jv5TTyijVLOSw","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"NY0P9IVkqMY5A3N1","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"lmKd843dtZUemeHg","name":"Shield Remote","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"This asymmetrical remoLe has an armoured shield on one side and motion-tracking sensors scattered across its shell. The remote places itself between aggressors and the user, physically impeding aLtacks."}},"items":[{"_id":"unSpyg8qR0VtUlKn","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
