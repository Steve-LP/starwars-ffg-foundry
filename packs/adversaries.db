{"_id":"8QGPqJzeUjssuO9K","name":"Sand Panther","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Sand panthers are large, solitary, feline predators who inhabit the high desert regions oc Corellia. They are long and lithe, with muscular forms covered in short, tawny fur. Their claws secrete a soporific venom that weakens their prey, and they are said to be the quietest animal predator in the galaxy. While they enjoy a protected status as a rare species, there is a brisk underground trade in sand panther hides and venom. Poachers and smugglers involved in the sand panther trade are typically ruthless, amoral, and very dangerous individuals who do not hesitate to kill when cornered or captured in the act."}},"items":[{"_id":"vj6C6eVvHJku6eR0","name":"Teeth and claws","type":"weapon","system":{"damage":5,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Pierce 2"}},{"_id":"ikUH8Usq1hHh91vA","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
