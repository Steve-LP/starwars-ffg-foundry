{"_id":"RsdYw0CprB8YEGCW","name":"Lieutenant Sarev","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Lieutenant Sarev is a pinch-faced human male in his early middle years. He is twitchy and so skinny that his uniform hangs on his body, making him look younger than his actual age. He does not handle crises very well."}},"items":[{"_id":"gct3DSg0gjDdaQ0p","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
