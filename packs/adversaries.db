{"_id":"8IfQOP1H6QbAHvkF","name":"Eerig, Nightbrother Lieutenant","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"One of several Nightbrother seconds under Freff’s leadership, Eerig had been uneasy about this mission. This feeling has diminished, though, as the Nightbrothers have followed Jerserra deeper into the ruins of the lost ship. He and his group are now ready to fight for her, no matter the threats they face from her foes or the dangerous surroundings."}},"items":[{"_id":"Czr14kRYPmdQL2Vc","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"k9UL2nSBS8EwCAZL","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"BiWPlgRD2mA5jnfu","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
