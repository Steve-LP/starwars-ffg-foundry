{"_id":"stmBScbsgxt4orAf","name":"Seraphs Gang Member","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The members of the Black Seraphs are the very essence of swoop gangers: young, violent, disaffected punks who have no ambitions beyond drinking, fighting, and racing."}},"items":[{"_id":"jZ59G3lxx1CgYL2i","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"y4zqR2qspotQkPYd","name":"Chain","type":"weapon","system":{"damage":5,"critical":5,"range":"Engaged","skill":"Melee","qualities":"Inaccurate 1, Knockdown"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"swxZf2r3zrBrvrRX","name":"Commandant Aresko","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Commander Cumberlayne Aresko oversees all of Lothal’s Imperial academies, from small regional ones to the majestic facility at Capital City. It is up to him to train the best and kick out the rest. A thin, gaunt man, Aresko enjoys bullying his underlings, his cadets, and vulnerable citizens. He is not among the Empire’s best or brightest leaders, but here he is among the most feared. His efforts to hunt down and capture the local rebel fighters, however, have not been as successful as desired."}},"items":[{"_id":"YZLgN1m75uigD2aG","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"iI5r1Tm1bAvcQ8t4","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"vRjvEeCAxagN5YCG","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"syQtYtcABkWLES9m","name":"Thalassian Slaver","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Members of a society of slavers thousands of years old, Thalassians are some of the most resourceful slave traders in the galaxy. Even though their shell-covered bodies would normally inhibit their mobility, the cunning reptiles rely on various technologies, such as repulsors and jetpacks, to travel quickly. Thalassians are rarely without their armour or array of gadgets. Seeing most other species as nothing more than animals, they utilise electronets, repulsor traps, stun grenades, and all manner of non-lethal weapons to round up and ensnare their targets. These slavers operate out of the New Territories, using ion cannon– equipped Z-95 Headhunters to prey on unsuspecting hyperspace travellers, but they are also common elsewhere in the galaxy."}},"items":[{"_id":"CHF0h9z8Bv9HKNuH","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"lihn3IIJFMDaeGD0","name":"Electronet launcher","type":"weapon","system":{"damage":6,"critical":0,"range":"Short","skill":"Ranged: Heavy","qualities":"Ensnare 5, Stun Damage"}},{"_id":"ICmM027yJ7x490ps","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
