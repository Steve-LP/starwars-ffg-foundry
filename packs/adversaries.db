{"_id":"OUmyh25OD7YEWA2u","name":"Rubat Spinner","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"The ten-legged rubat spinner is far sturdier than its spindly limbs would indicate. Although its bulbous central mass is under half a metre in length, the dense minerals strengthening its carapace allow it to out-mass and overpower prey more than twice its size."}},"items":[{"_id":"LtapDjg9gduafRPf","name":"Limb spike","type":"weapon","system":{"damage":5,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Pierce 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
