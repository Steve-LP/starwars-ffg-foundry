{"_id":"Yz1WGnrPcMzH6m7f","name":"RMD-20 “Eye in the Sky”","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Designed for the civilian market. the RMD 20 “Eye in the Sky” is a small, spherical remote intended to record footage while staying on the move. The RMD-20’s sensitive audio and video sensors can be fed to a host computer or data pad, allowing for 24-hour surveillance. The remote itself is equipped with a repulsorlift generator, allowing it to hover."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"YzVtItWXgbBPQpPt","name":"Twisted Words","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When a social check targeting the character generates :threat::threat: or :despair:, may suffer 1 Strain as an incidental to inflict {Coercion} Strain on the character who made the check."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Z0rhMCLt21Oo7Ude","name":"CorSec Officer","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"CoreSec Officers are the rank and file members of the Corellian Security Force, and make up the bulk of its membership. These are the hard-working men and women tasked with keeping the peace among their fractious, headstrong fellow Corellians (a generally thankless task). They spend their days walking beats in neighbourhoods, patrolling and monitoring traffic on the ground and in the air, writing tickets, performing community outreach, arresting scofflaws, and performing the kind of general policing and peacekeeping jobs that police forces throughout the galaxy have performed for millennia."}},"items":[{"_id":"QOHEbFQiEdc9zqkS","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"U1Mdwft5ieWZmk1u","name":"CDEF Blaster pistol","type":"weapon","system":{"damage":5,"critical":4,"range":"Medium","skill":"Ranged: Light","qualities":"Inferior, Stun Setting"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Z0uZ5hZr8tTHZKO9","name":"Escaped Dust Stalker","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"This large, blue, six-legged insectoid beast has been goaded into action by the covert manipulations of the Lucite Orl Miscord. Unfortunately for its owner, Sala Vindako, the dust stalker has successfully escaped its cage and intends to sate its hunger on anyone foolish or unlucky enough to get within biting distance."}},"items":[{"_id":"Q7lHuMcDBSBQtxjl","name":"Piercing claws","type":"weapon","system":{"damage":8,"critical":3,"range":"Engaged","skill":"Brawl","qualities":"Pierce 2"}},{"_id":"iaSS208XkLvRbdVO","name":"Serrated teeth","type":"weapon","system":{"damage":8,"critical":2,"range":"Engaged","skill":"Brawl","qualities":"Sunder, Vicious 3"}},{"_id":"W0kUyyCJIey9qHXz","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"mds82aLEjmqZMGEo","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"Z3PfldvknmEUxWvT","name":"Ammonia Breather","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Breathes ammonia, must use a respirator, and if exposed to oxygen, treats it as a dangerous atmosphere with rating 8."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
