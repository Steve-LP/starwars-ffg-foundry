{"_id":"Iwch8beU8tkZuOjA","name":"Corellian Hounds","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Also known as Sibian hounds, these fleet-footed canids have keen senses enhanced through generations of breeding for hunting and attack. Though originally native to Corellia, these beasts can be found all over the galaxy thanks to their aptitude as guard animals."}},"items":[{"_id":"erALh76CLJv2MX4D","name":"Teeth","type":"weapon","system":{"damage":0,"critical":4,"range":"Engaged","skill":"Brawl","qualities":"Ensnare 1, Pierce 1"}}],"effects":[],"flags":{},"ownership":{"default":0}}
