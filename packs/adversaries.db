{"_id":"gK7SIsRB9cepWyqh","name":"Jerid Sykes, Consortium Admiral","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Jerid Sykes, once a Republic fleet officer, cut his proverbial teeth during the Clone Wars. When the Republic dissolved into the Empire, Jerid constantly butted heads with the new class of officers who were commissioned due to their connections rather than their skill. His stubbornness eventually cost him his post, but it wasn’t long before representatives of the Zann Consortium found him and offered him a lucrative career as one of its fleet officers. Having nothing more to lose, Jerid agreed."}},"items":[{"_id":"SMY7ubbqh1EPrRsq","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"NJ4e7DRoVvNJZ6hX","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"bRbB46NT7MHZO4q7","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
