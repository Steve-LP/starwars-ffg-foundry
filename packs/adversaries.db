{"_id":"EjxNp1E4m6wprvGP","name":"Shelish","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Shelish, the only known surviving Nightsisters, spends much of her time hiding in the swamps of Jhas Krill, the eleventh moon of Jhas, in the Hoth system. Although she was absent during the loss of her people on Dathomir, she may also be found on that world at times, searching for clues about their fate. Trusting in the magick of her people, she waits for a student worthy to inherit her dark secrets."}},"items":[{"_id":"KLeEFdAwrAipcVIM","name":"Ancient sword","type":"weapon","system":{"damage":6,"critical":3,"range":"Engaged","skill":"Lightsaber","qualities":"Defensive 1"}},{"_id":"wLG03KZlCQlcjKGY","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ZgVYbG4vc0c3hywm","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"En2mmD5qI2sFIijt","name":"Adamite Tower Paladin","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Supplicants swear to give up their former lives when they become one of the Paladins of the Adamite Tower. They conceal their identity behind a hooded helmet and beneath reforged star armour, and ride forth from the Ordan Spine to enforce justice and peace. Those foolish enough to confront a Paladin will find an enemy stronger and faster than a normal being, and with a blade of flaring, hissing sunfire."}},"items":[{"_id":"MgOokmz1W5G7hKBF","name":"Sunfire sword","type":"weapon","system":{"damage":6,"critical":2,"range":"Engaged","skill":"Lightsaber","qualities":"Breach 1, Innacurate 1, Sunder"}},{"_id":"1Pu4vk0S68NAM3G3","name":"Longbow","type":"weapon","system":{"damage":5,"critical":5,"range":"Long","skill":"Ranged: Heavy","qualities":"Cumbersome 3, Limited Ammo 1, Pierce 1"}},{"_id":"J2HS5SWiDdE3R0dC","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"CV6F3QJ3Syz7fvjT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"pcLUKu2VT6Z3oISH","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
