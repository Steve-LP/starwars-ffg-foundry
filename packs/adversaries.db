{"_id":"2WLFXCd7EvLY504n","name":"Priska K’yyl","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Adventurous Archaeologist. Bothan. Explorer career, Archeologist spec. Obligation: Family. Priska’s doting grandfather is a spymaster who often wheedles her into running “little errands” for him. (+5 level) Motivation: Status. Academic prestige for finding proof of a despotic pre-Republic empire."}},"items":[{"_id":"N2Hm3VgFQOV9SWsX","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"vZPu3CQ4P37DVoD3","name":"Combat knife","type":"weapon","system":{"damage":0,"critical":3,"range":"Engaged","skill":"Melee","qualities":""}},{"_id":"03Mr1FR5k5LK7Rua","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"HzEJaZQ4hpzS9lo5","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"MojszhtSK8Piv4YX","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"2WMneLoWddVa2a2z","name":"Jerserra’s Mercenary","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Over the years, Jerserra has gathered many unsavoury types from a variety of Outer Rim species to her side. Most are in it simply for the credits, but some feel she is more than just another merc leader. She has vision, and aiding her can only lead to powerful roles for themselves in the future she is building."}},"items":[{"_id":"eTmAeMPqsVzyboQz","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"P9gBWRQikQUUkBTo","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"GeSWomeY80lmTjdm","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
