{"_id":"edjSZoTObMaVzkCw","name":"Torani Kulda","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Small and lithe, even for a Rodian, Torani Kulda exudes calm confidence and open disdain for anyone she considers to be beneath her notice. She possesses light green skin and golden eyes. A prominent trio of scars, which she makes no attempt to conceal, crosses her brow. Torani is a devious foe, working in tandem with her partner, AO-2, to overcome their foes."}},"items":[{"_id":"ePsPJYNiSCELyzr4","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"eRqlrDwdrWwSAujA","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"mFpAl9icVA6SWWqF","name":"Blaster rifle with spin barrel mod","type":"weapon","system":{"damage":10,"critical":3,"range":"Long","skill":"Ranged: Heavy","qualities":"Accurate 1, Stun Setting"}},{"_id":"iQj9eg1kFh3kl4fb","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"42QLeWe1wzhfrnCd","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"eefPRpj24V7F9tHZ","name":"Light repeating blaster","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":""}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"efnyrDfaB2Sn3Niw","name":"Imperial Advisor","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"One of the most insidious methods the Emperor employs to maintain control of his Empire is constantly pitting his minions against one another. These mind games allow such individuals to gain favor by proving their ultimate loyalty to him. Historically, this has prevented Palpatine’s subordinates from allying against him, and nowhere has this policy been more ruthlessly embodied than in the ranks of his Imperial advisors. Typically, there have been around one hundred such extremely powerful and influential bureaucrats at any given time. Each is tasked not only with overseeing details of the Empire’s administration, including such important decisions as appointing governors and Moffs, and also with conducting covert surveillance on the home systems of other advisors and high-ranking Imperial officials."}},"items":[{"_id":"qgPDxvlzSLnC9MeA","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"g7VB60ATxVm6cJTN","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"kZEYGATM8RZbOZmE","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"egYzHH4BnhUcQ26z","name":"Viper Probe Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"When searching the most remote regions in the galaxy, Imperial authorities often make use of probe droids to scout remote planets and scour distant locations for signs of whatever, or whomever, is being sought. Probe droids travel to their destinations inside one-way hyperspace pods and communicate with their programmers via encrypted holo-channels. When the quarry may be on any of a thousand worlds, the best solution is often to disperse a thousand probe droids."}},"items":[{"_id":"oEulCYbeDgfvEqIO","name":"Built-in blaster","type":"weapon","system":{"damage":6,"critical":3,"range":"Medium","skill":"Ranged: Light","qualities":"Stun Setting"}}],"effects":[],"flags":{},"ownership":{"default":0}}
