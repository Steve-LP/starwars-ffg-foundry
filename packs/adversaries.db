{"_id":"cieUkds2CZKtzhrV","name":"Street Tough","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"In cities across the galaxy there are any number of petty criminals, from pickpockets and back-ally spice dealers to muggers and murderers. Discontent with the notion of earning an honest wage, these street toughs instead prefer to survive on whatever they can take from passers-by, preferably in the form of credits or small, easily liquidated electronic goods like data pads and comlinks. Street toughs occasionally work as individuals, if they possess sufficient skill, but more often work in small gangs so that they can cooperatively locate and target the best marks. However, these individuals are often badly equipped and pitiful in comparison to real gangs."}},"items":[{"_id":"FzL2iX5AcSshFLWL","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"gft5i1bhnIEoieaU","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"IwAKlEd4IO70Df6L","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"cjtmY9H9StTTyHmg","name":"Sensitive Hearing","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Pau’ans add :boost: to all Perception and Vigilance checks as long as they are wearing their protective earpieces. If not wearing the earpieces, they add :threat: instead."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
