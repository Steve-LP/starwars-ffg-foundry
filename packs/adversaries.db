{"_id":"V0CkKgC5eZ9lA44f","name":"R2-B7, Astromech Droid","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"R2-B7 is an efficient astromech unit responsible for maintaining the mining equipment, life support systems, and the storm barrier generators. While EV-8D3 provides a vocal leadership and bloodthirsty example to the NDRM, R2-B7 is very much the brains behind the operation. It was he who originally developed the programming quirks leading to a desire for violent revolution. As the best-qualified engineer in the mines, he was therefore well placed to ensure that those droids in need of repairs benefited from having his own revolutionary philosophy uploaded to their psychological programming."}},"items":[{"_id":"PqYAjAGNJDR7MBos","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
