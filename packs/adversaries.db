{"_id":"hPTJDnomwwnKKteF","name":"Mind Bleed","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"If carrying items that total 2 Encumbrance or less, when targeted by an attack may suffer a number of Strain equal to the number of Wounds suffered from the attack to cause the attacker to suffer the same amount of Wounds."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"hX6vxhfyC6nfNc7g","name":"Karazak Acquisition Agent","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Acquisitions agents conduct all “product acquisition” (enslaving) operations for the KSC with military efficiency. Acquisitions agents commonly frequent major hyperlanes in the Outer Rim, but each successful operation emboldens them to operate further Coreward."}},"items":[{"_id":"ZOuhjbh7XNtWXvx7","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"uNOHqTQ0HREaLah6","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"hbCmtgy0w8mEGioV","name":"Accomplished Mechanic","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Force-sensitive mechanics instinctively know their way around machines and can coax them back to life long after other mechanics would have given up hope. Mechanics are a welcome addition to a smuggler’s crew or a pirate band, where they’re likely to avoid the watchful eye of Imperial Inquisitors. Occasionally, Force-sensitive mechanics will be found working legitimate jobs in respectable shops on civilized planets. Those who do are almost always unaware that their amazing ability to assess and repair machines is any thing other than a natural talent."}},"items":[{"_id":"XW2OrxdY3ErnvNcF","name":"Weapon","type":"weapon","system":{"damage":0,"critical":0,"range":"Engaged","skill":"Ranged-Light","qualities":""}},{"_id":"8gGHkKtO6HSvdiN8","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"ohGzrxqMjeNsJgKu","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}},{"_id":"sI6miOstywkZTPeT","name":"Talent","type":"talent","system":{"description":"","activation":"Passive","tier":1,"ranked":false}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"hgpleM3Vj6TW646K","name":"Menagerie Guard","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Sala employs several guards, who help her keep an eye on her beasts. By the time the encounter begins, one of the guards has fallen prey to the dust stalker, leaving two minion groups of three. The guards are instructed to use non-lethal means to subdue the dust stalker, but they resort to lethal attacks should another of their number fall victim to the beast."}},"items":[{"_id":"oazgISpKulj5RfZd","name":"Light spear","type":"weapon","system":{"damage":6,"critical":3,"range":"Engaged","skill":"Melee","qualities":"Pierce 1"}},{"_id":"JGG82cw9UbdjVCGX","name":"Soporific-tipped bow","type":"weapon","system":{"damage":5,"critical":4,"range":"Medium","skill":"Ranged: Heavy","qualities":"Limited Ammo 1, Stun 4"}}],"effects":[],"flags":{},"ownership":{"default":0}}
{"_id":"hhv7kC40nFuLb5Ha","name":"Changeling","type":"npc","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"As an action may suffer 3 Strain and make an :average: Resilience check. If successful may change appearance to that of any observed Silhoutte 1 character. An observing character must make an opposed Perception vs. Deception check to detect that something is amiss."}},"items":[],"effects":[],"flags":{},"ownership":{"default":0}}
