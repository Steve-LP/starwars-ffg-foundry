{"_id":"8bzgs0NRQma2TIxr","name":"Bardottan Palace Guard","type":"minion","img":"icons/svg/mystery-man.svg","system":{"characteristics":{"brawn":{"value":2},"agility":{"value":2},"intellect":{"value":2},"cunning":{"value":2},"willpower":{"value":2},"presence":{"value":2}},"stats":{"wounds":{"value":0,"max":10},"strain":{"value":0,"max":10},"soak":{"value":0},"defence":{"melee":0,"ranged":0}},"biography":{"description":"Only the finest Bardottan warriors can train to become guards in the Royal Palace. Guards are formidable opponents, but their combat skills are rarely tested; most troublemakers know better than to assault the palace or its inhabitants."}},"items":[{"_id":"rS4u80bo0Dp9mU2Q","name":"Bardottan electrolance","type":"weapon","system":{"damage":5,"critical":3,"range":"Engaged","skill":"Melee","qualities":"Defensive 2, Stun Setting"}}],"effects":[],"flags":{},"ownership":{"default":0}}
