{"_id":"D78kCSvqF7BFdUvA","name":"Critical Injuries Table","img":"icons/svg/d10.svg","description":"Critical Injury Roll Table (1d100) for Star Wars FFG combat resolution.","results":[{"_id":"ZFSXcpRevwlYX4Vh","type":0,"text":"[Easy] Minor Nick: Target suffers 1 strain.","img":"icons/svg/blood.svg","weight":1,"range":[1,5],"drawn":false},{"_id":"7u1G10jEvDt0KIgr","type":0,"text":"[Easy] Slowed Down: Target acts only during the last allied Initiative slot next turn.","img":"icons/svg/blood.svg","weight":1,"range":[6,10],"drawn":false},{"_id":"CVX6OU3bnhXhb2O4","type":0,"text":"[Easy] Sudden Jolt: Target drops whatever is in their hand.","img":"icons/svg/blood.svg","weight":1,"range":[11,15],"drawn":false},{"_id":"G3W2m0s6ENuUr26l","type":0,"text":"[Easy] Distracted: Target cannot perform a free Maneuver next turn.","img":"icons/svg/blood.svg","weight":1,"range":[16,20],"drawn":false},{"_id":"p25M5P4ERllOPRAS","type":0,"text":"[Easy] Off-Balance: Add setback die to next skill check.","img":"icons/svg/blood.svg","weight":1,"range":[21,25],"drawn":false},{"_id":"Z3fAk9SksVah38dM","type":0,"text":"[Easy] Discouraged: Add setback die to next Active check.","img":"icons/svg/blood.svg","weight":1,"range":[26,30],"drawn":false},{"_id":"LSaUGTORbIfeceuQ","type":0,"text":"[Easy] Hamstrung: Target cannot perform more than one maneuver next turn.","img":"icons/svg/blood.svg","weight":1,"range":[31,35],"drawn":false},{"_id":"p9S3X7TUuVEnH9pG","type":0,"text":"[Easy] Overwhelmed: Target suffers 1 strain per action next turn.","img":"icons/svg/blood.svg","weight":1,"range":[36,40],"drawn":false},{"_id":"2uv5PoSUWoDOKlwx","type":0,"text":"[Average] Winded: Target cannot run or sprint next turn.","img":"icons/svg/blood.svg","weight":1,"range":[41,45],"drawn":false},{"_id":"ewR7VQAjQNcM5o1M","type":0,"text":"[Average] Compromised: Increase difficulty of all checks by one until end of encounter.","img":"icons/svg/blood.svg","weight":1,"range":[46,50],"drawn":false},{"_id":"ShtKMmwOqSLJquNI","type":0,"text":"[Average] At the Brink: Target suffers 1 strain per check until end of encounter.","img":"icons/svg/blood.svg","weight":1,"range":[51,55],"drawn":false},{"_id":"cd012fKLNkGuYVGr","type":0,"text":"[Average] Agonizing Wound: Double strain cost of all maneuvers.","img":"icons/svg/blood.svg","weight":1,"range":[56,60],"drawn":false},{"_id":"9bpAJo4PuyKSLpqd","type":0,"text":"[Average] Slightly Dazed: Target is Disoriented until end of encounter.","img":"icons/svg/blood.svg","weight":1,"range":[61,65],"drawn":false},{"_id":"uMDw0TRFHlGWR9p9","type":0,"text":"[Average] Severely Staggered: Target is Staggered next turn.","img":"icons/svg/blood.svg","weight":1,"range":[66,70],"drawn":false},{"_id":"wNjV0Cktr6kAzNI3","type":0,"text":"[Average] Temporarily Lame: Target is Immobilized next turn.","img":"icons/svg/blood.svg","weight":1,"range":[71,75],"drawn":false},{"_id":"TTP2F0OuV87DbQd1","type":0,"text":"[Average] Blinded: Upgrade difficulty of all checks twice.","img":"icons/svg/blood.svg","weight":1,"range":[76,80],"drawn":false},{"_id":"a7xB8r6VY6QUxwIm","type":0,"text":"[Hard] Knocked Senseless: Target is Stunned for 2 turns.","img":"icons/svg/blood.svg","weight":1,"range":[81,85],"drawn":false},{"_id":"yYw6qeAAVrSoQSwM","type":0,"text":"[Hard] Horrific Injury: Random characteristic reduced by 1.","img":"icons/svg/blood.svg","weight":1,"range":[86,90],"drawn":false},{"_id":"mZvinggDzVE2d3jH","type":0,"text":"[Hard] Temporarily Crippled: One limb unusable until treated.","img":"icons/svg/blood.svg","weight":1,"range":[91,95],"drawn":false},{"_id":"fBNQ6PDgO1KRoWYG","type":0,"text":"[Hard] Bleeding Out: Suffers 1 wound per turn.","img":"icons/svg/blood.svg","weight":1,"range":[96,100],"drawn":false},{"_id":"8rCaWl1Gu6bnfs8Q","type":0,"text":"[Deadly] Vaporized / Dead: Character is killed.","img":"icons/svg/blood.svg","weight":1,"range":[101,150],"drawn":false}],"formula":"1d100","replacement":true,"displayRoll":true,"flags":{}}
