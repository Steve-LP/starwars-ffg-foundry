9u3L","type":0,"text":"[Average] At the Brink: Target suffers 1 strain per check until end of encounter.","img":"icons/svg/blood.svg","weight":1,"range":[51,55],"drawn":false},{"_id":"OsXyvWkcykr3hR5k","type":0,"text":"[Average] Agonizing Wound: Double strain cost of all maneuvers.","img":"icons/svg/blood.svg","weight":1,"range":[56,60],"drawn":false},{"_id":"DmHs9HEs6lVsU1qV","type":0,"text":"[Average] Slightly Dazed: Target is Disoriented until end of encounter.","img":"icons/svg/blood.svg","weight":1,"range":[61,65],"drawn":false},{"_id":"5msSgqa3xBTrTVSl","type":0,"text":"[Average] Severely Staggered: Target is Staggered next turn.","img":"icons/svg/blood.svg","weight":1,"range":[66,70],"drawn":false},{"_id":"WvvgsN7daOIOcMmX","type":0,"text":"[Average] Temporarily Lame: Target is Immobilized next turn.","img":"icons/svg/blood.svg","weight":1,"range":[71,75],"drawn":false},{"_id":"GN5LOYZS2mJ9qXtk","type":0,"text":"[Average] Blinded: Upgrade difficulty of all checks twice.","img":"icons/svg/blood.svg","weight":1,"range":[76,80],"drawn":false},{"_id":"9LTm9GXJwxnpQ1OG","type":0,"text":"[Hard] Knocked Senseless: Target is Stunned for 2 turns.","img":"icons/svg/blood.svg","weight":1,"range":[81,85],"drawn":false},{"_id":"Q8QY003dAhQ12Ne9","type":0,"text":"[Hard] Horrific Injury: Random characteristic reduced by 1.","img":"icons/svg/blood.svg","weight":1,"range":[86,90],"drawn":false},{"_id":"1kIg4SzJYDfB4aVl","type":0,"text":"[Hard] Temporarily Crippled: One limb unusable until treated.","img":"icons/svg/blood.svg","weight":1,"range":[91,95],"drawn":false},{"_id":"6eWq7vB63OcaWMei","type":0,"text":"[Hard] Bleeding Out: Suffers 1 wound per turn.","img":"icons/svg/blood.svg","weight":1,"range":[96,100],"drawn":false},{"_id":"35dTDotWNA2SVbda","type":0,"text":"[Deadly] Vaporized / Dead: Character is killed.","img":"icons/svg/blood.svg","weight":1,"range":[101,150],"drawn":false}],"formula":"1d100","replacement":true,"displayRoll":true,"flags":{}}
